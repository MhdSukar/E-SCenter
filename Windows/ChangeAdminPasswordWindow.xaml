<Window x:Class="ESCenter.Windows.ChangeAdminPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Admin Password"
        Height="270"
        Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="{StaticResource CardBackgroundBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Update Admin Password"
                   FontSize="16"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,14"
                   Grid.Row="0"/>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,4">
            <TextBlock Text="Current:" Width="120" VerticalAlignment="Center"/>
            <PasswordBox x:Name="CurrentPasswordBox" Width="220" Style="{StaticResource NeonPasswordBoxStyle}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,4">
            <TextBlock Text="New Password:" Width="120" VerticalAlignment="Center"/>
            <PasswordBox x:Name="NewPasswordBox" Width="220" Style="{StaticResource NeonPasswordBoxStyle}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,4">
            <TextBlock Text="Confirm New:" Width="120" VerticalAlignment="Center"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Width="220" Style="{StaticResource NeonPasswordBoxStyle}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="4" HorizontalAlignment="Center" Margin="0,14,0,0">
            <Button Content="Save"
                    Width="100"
                    Margin="6,0"
                    Style="{StaticResource NeonGreenButtonStyle}"
                    Click="SaveButton_Click"/>
            <Button Content="Cancel"
                    Width="100"
                    Margin="6,0"
                    Style="{StaticResource NeonOrangeButtonStyle}"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
