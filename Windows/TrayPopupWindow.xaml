<Window x:Class="ESCenter.Windows.TrayPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="110" Height="130"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Opacity="1">

    <Border CornerRadius="10"
            Background="{StaticResource AppBackgroundBrush}"
            BorderBrush="{StaticResource AppBackgroundBrush}"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== Header with exit button ===== -->
            <Grid Height="28" Background="{StaticResource DarkCardBrush}" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="E-SCenter"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="6,0,0,0"/>

                <!-- Exit Button (icon only) -->
                <Button Grid.Column="1"
                        Width="24" Height="24"
                        Background="{StaticResource DarkCardBrush}"
                        BorderBrush="{StaticResource DarkCardBrush}"
                        Command="{Binding ExitAppCommand}"
                        x:Name="BtnExit"
                        Padding="0" Margin="2,2,2,2">
                    <Image Source="{StaticResource PowerOff}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- ===== Compact Buttons ===== -->
            <StackPanel Grid.Row="1" Margin="0,4,0,0" Orientation="Vertical" VerticalAlignment="Top">

                <Button Height="24" Style="{StaticResource NeonBorderButtonStyle}" Command="{Binding OpenDashboardCommand}" x:Name="BtnDashboard" Width="80">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Width="12" Height="12" Margin="0,0,4,0" Source="{StaticResource ArmingCountdown}" />
                        <TextBlock Text="Dashboard" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Height="24" Style="{StaticResource NeonBorderButtonStyle}" Command="{Binding OpenTicketsCommand}" x:Name="BtnAddTicket" Width="80">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Width="12" Height="12" Margin="0,0,4,0" Source="{StaticResource regular_expression}" />
                        <TextBlock Text="Tickets" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Height="24" Style="{StaticResource NeonBorderButtonStyle}" Command="{Binding OpenInventoryCommand}" x:Name="BtnInventory" Width="80">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Width="12" Height="12" Margin="0,0,4,0" Source="{StaticResource inventory}" />
                        <TextBlock Text="Inventory" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Height="24" Style="{StaticResource NeonBorderButtonStyle}" Command="{Binding OpenReportsCommand}" Width="80">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Width="12" Height="12" Margin="0,0,4,0" Source="{StaticResource DataArray}" />
                        <TextBlock Text="Reports" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Grid>
    </Border>
</Window>
