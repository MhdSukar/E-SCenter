<Window x:Class="ESCenter.Windows.PricingSystemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pricing System"
        Height="780"
        Width="980"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Border CornerRadius="12" Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource DarkBorderBrush}" BorderThickness="0" SnapsToDevicePixels="True">
        <Grid>
            <Border Height="36" Background="{StaticResource DarkCardBrush}" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" VerticalAlignment="Top">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="/Themes/Philips E-SCenter Logo.png" Width="18" Height="18" Margin="10,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Pricing System" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Button Grid.Column="2" Style="{StaticResource TitleBarCloseButtonStyle}" Click="btnClose_Click">
                        <Image Source="{StaticResource Close}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <Border Margin="0,36,0,0" Padding="14" CornerRadius="0,0,10,10" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Configure the sheet-style formula used by the ticket Final Cost calculator. All saved values are S.P based; USD part/inventory costs are converted by the rate below." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,2,10"/>

                            <GroupBox Header="1 — Diagnostic Fee" Style="{StaticResource GradientGroupBoxBlueCyan}" Margin="0,0,0,10">
                                <Grid Margin="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                    </Grid.RowDefinitions>
                                    <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding IncludeDiagnosticFee}" Style="{StaticResource GradientCheckBoxStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Diagnostic / Inspection Fee (S.P)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding DiagnosticInspectionFeeSp, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GradiantTextboxStyle1}" VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="User input, equivalent to the yellow sheet cell." Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <CheckBox Grid.Row="1" Grid.Column="0" IsChecked="{Binding WaiveDiagnosticIfRepairProceeds}" Style="{StaticResource GradientCheckBoxStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Deduct fee if customer proceeds?" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="YES = net diagnostic becomes 0" Foreground="{StaticResource Gradient.Success}" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="2 — Labour Cost" Style="{StaticResource GradientGroupBoxBlueCyan}" Margin="0,0,0,10">
                                <Grid Margin="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                    </Grid.RowDefinitions>
                                    <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding IncludeLabourCost}" Style="{StaticResource GradientCheckBoxStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Technician Hourly Rate (S.P/hr)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding TechnicianHourlyRateSp, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GradiantTextboxStyle1}" VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Labour = rate × total hours × complexity." Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Time — Diagnosis (hrs)" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding DiagnosisHours, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GradiantTextboxStyle1}" VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Time — Repair (hrs)" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding RepairHours, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GradiantTextboxStyle1}" VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Complexity Multiplier (1.0 — 2.0)" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding ComplexityMultiplier, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GradiantTextboxStyle1}" VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="1.0 standard, 1.5 complex, 2.0 specialist" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="3 — Parts &amp; Components" Style="{StaticResource GradientGroupBoxBlueCyan}" Margin="0,0,0,10">
                                <Grid Margin="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IncludePartsAndComponents}" Style="{StaticResource GradientCheckBoxStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Default Markup % for parts used" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Text="{Binding DefaultPartsMarkupPercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GradiantTextboxStyle1}" VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="Applied to all ticket parts/inventory lines after USD→S.P conversion." Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="4 — Overhead Allocation" Style="{StaticResource GradientGroupBoxAccent}" Margin="0,0,0,10">
                                <Grid Margin="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                    </Grid.RowDefinitions>
                                    <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding IncludeOverheadAllocation}" Style="{StaticResource GradientCheckBoxStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Monthly Fixed Overhead (S.P)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding MonthlyFixedOverheadSp, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GradiantTextboxStyle1}" VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Rent, utilities, insurance, tools, software ..." Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Average Jobs Per Month" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding AverageJobsPerMonth, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GradiantTextboxStyle1}" VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Overhead per job = monthly overhead ÷ jobs." Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="5 — Pricing &amp; Final Invoice" Style="{StaticResource GradientGroupBoxAccent}" Margin="0,0,0,10">
                                <Grid Margin="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                    </Grid.RowDefinitions>
                                    <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding IncludeProfitMargin}" Style="{StaticResource GradientCheckBoxStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Desired Profit Margin %" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding DesiredProfitMarginPercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GradiantTextboxStyle1}" VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Profit = total direct cost × margin %." Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <CheckBox Grid.Row="1" Grid.Column="0" IsChecked="{Binding IncludeVatTax}" Style="{StaticResource GradientCheckBoxStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="VAT / Tax Rate %" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding VatTaxRatePercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GradiantTextboxStyle1}" VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="VAT = pre-tax repair price × tax %." Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="USD Rate (S.P per 1 USD)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding UsdRateText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GradiantTextboxStyle1}" VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="Shared with Al-Baraka exchange conversion." Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Additional Costs — keep adding more fields" Style="{StaticResource GradientGroupBoxBlueCyan}">
                                <Grid Margin="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Include" FontWeight="SemiBold" Foreground="{StaticResource Gradient.Accent}"/>
                                        <TextBlock Grid.Column="1" Text="Cost label" FontWeight="SemiBold" Foreground="{StaticResource Gradient.Accent}"/>
                                        <TextBlock Grid.Column="2" Text="Value" FontWeight="SemiBold" Foreground="{StaticResource Gradient.Accent}"/>
                                        <TextBlock Grid.Column="3" Text="Type" FontWeight="SemiBold" Foreground="{StaticResource Gradient.Accent}"/>
                                    </Grid>
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding CostOptions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="80"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsIncluded, Mode=TwoWay}" HorizontalAlignment="Center" Style="{StaticResource GradientCheckBoxStyle}"/>
                                                    <TextBox Grid.Column="1" Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Style="{StaticResource GradiantTextboxStyle1}"/>
                                                    <TextBox Grid.Column="2" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Style="{StaticResource GradiantTextboxStyle1}"/>
                                                    <ComboBox Grid.Column="3" SelectedItem="{Binding ValueType, Mode=TwoWay}" ItemsSource="{Binding DataContext.ValueTypes, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,8,0" Style="{StaticResource GradiantComboboxStyle11}"/>
                                                    <Button Grid.Column="4" Content="Remove" Command="{Binding DataContext.RemoveCostCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource GradientBorderButtonStyleRed}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Add Cost" Width="100" Margin="6,0" Command="{Binding AddCostCommand}" Style="{StaticResource GradientBorderButtonStyleBLueCyan}"/>
                        <Button Content="Reset Defaults" Width="120" Margin="6,0" Command="{Binding ResetCommand}" Style="{StaticResource GradientBorderButtonStyleYellow}"/>
                        <Button Content="Save" Width="90" Margin="6,0" Click="SaveButton_Click" Style="{StaticResource GradientBorderButtonStyleGreen}"/>
                        <Button Content="Cancel" Width="90" Margin="6,0" Click="CancelButton_Click" Style="{StaticResource GradientBorderButtonStyleRed}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
