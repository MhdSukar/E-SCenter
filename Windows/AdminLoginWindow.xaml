<Window x:Class="ESCenter.Windows.AdminLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Login"
        Height="220"
        Width="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="{StaticResource CardBackgroundBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Enter Admin Credentials"
                   FontSize="16"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12"
                   Grid.Row="0"/>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,6">
            <TextBlock Text="Username:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="UsernameBox" Width="180" Height="28" Style="{StaticResource NeonTextBoxStyle}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,6">
            <TextBlock Text="Password:" Width="80" VerticalAlignment="Center"/>
            <PasswordBox x:Name="PasswordBox" Width="180" Style="{StaticResource NeonPasswordBoxStyle}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Content="Login" Width="80" Margin="6,0" Style="{StaticResource NeonGreenButtonStyle}"
                    Click="LoginButton_Click"/>
            <Button Content="Cancel" Width="80" Margin="6,0" Style="{StaticResource NeonOrangeButtonStyle}"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
