<Window x:Class="ESCenter.Windows.AdminLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Login"
        Height="250"
        Width="320"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="TitleBarButtonBase" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonBase}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="0,8,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E81123"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#C50F1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="{StaticResource AppBackgroundBrushNew}" BorderBrush="{StaticResource DarkBorderBrush}" BorderThickness="0" SnapsToDevicePixels="True">
        <Grid>
            <Border Height="36" Background="{StaticResource DarkCardBrush}" CornerRadius="12,12,0,0" BorderBrush="{StaticResource DarkBorderBrush}" BorderThickness="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" VerticalAlignment="Top">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="{StaticResource AppIcon}" Width="18" Height="18" Margin="10,0,6,0" VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1" Text="Admin Login" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource TitleBarButtonBase}" Click="btnMinimize_Click" x:Name="btnMinimize">
                            <Image Source="{StaticResource Minimize}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource TitleBarButtonBase}" x:Name="btnMaximize" FontSize="17" Click="btnMaximize_Click">
                            <Image Source="{StaticResource Maximize}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource TitleBarCloseButtonStyle}" Click="btnClose_Click">
                            <Image Source="{StaticResource Close}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Margin="0,36,0,0" Padding="12" CornerRadius="0,0,10,10" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Enter Admin Credentials" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12" Grid.Row="0"/>

                    <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,6">
                        <TextBlock Text="Username:" Width="80" VerticalAlignment="Center"/>
                        <TextBox Height="25" TabIndex="0" x:Name="UsernameBox" Width="180" Style="{StaticResource GradiantTextboxStyle1}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,6">
                        <TextBlock Text="Password:" Width="80" VerticalAlignment="Center"/>
                        <PasswordBox Height="25" TabIndex="1" x:Name="PasswordBox" Width="180" Style="{StaticResource DarkPasswordBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button TabIndex="2" Content="Login" Width="80" Margin="6,0" Style="{StaticResource GradientBorderButtonStyleGreen}" Click="LoginButton_Click"/>
                        <Button TabIndex="3" Content="Cancel" Width="80" Margin="6,0" Style="{StaticResource GradientBorderButtonStyleYellow}" Click="CancelButton_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="ErrorMessageText"
                               Grid.Row="4"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource ErrorBrush}"
                               FontWeight="SemiBold"
                               Text="Wrong credentials"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
