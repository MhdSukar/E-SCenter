<Window x:Class="ESCenter.Windows.DatabaseManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Database Management"
        Height="280"
        Width="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CardBackgroundBrush}">

    <StackPanel Margin="16" VerticalAlignment="Center">
        <Button Content="Create Databases"
                Height="40"
                Margin="0,6"
                Style="{StaticResource NeonRedButtonStyle}"
                Click="ReceiveDateabases_Click"/>

        <Button Content="Load Database" Height="40" Margin="0,6" Style="{StaticResource NeonCyanButtonStyle}"/>
        <Button Content="Archive Database" Height="40" Margin="0,6" Style="{StaticResource NeonGreenButtonStyle}"/>
        <Button Content="Export to CSV" Height="40" Margin="0,6" Style="{StaticResource NeonPurpleButtonStyle}"/>
    </StackPanel>
</Window>
