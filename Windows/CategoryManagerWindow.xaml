<Window x:Class="ESCenter.Windows.CategoryManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Categories"
        Width="380"
        Height="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Border CornerRadius="12" Background="{StaticResource AppBackgroundBrush}" BorderThickness="0">
        <Grid>
            <Border Height="36" Background="{StaticResource DarkCardBrush}" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" VerticalAlignment="Top">
                <Grid>
                    <TextBlock Text="Manage Categories" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Button HorizontalAlignment="Right" Style="{StaticResource TitleBarCloseButtonStyle}" Click="btnClose_Click">
                        <Image Source="{StaticResource Close}" Width="14" Height="14"/>
                    </Button>
                </Grid>
            </Border>

            <Border Margin="0,36,0,0" Padding="12" CornerRadius="0,0,10,10" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                <TabControl x:Name="CategoryTabs" Style="{StaticResource SettingsWindowTabControlStyle}">
                    <TabItem Header="Parts Types" Tag="First">
                        <StackPanel Margin="8">
                            <ListBox x:Name="PartsListBox" Height="260" Background="#1A1A1A" BorderBrush="{StaticResource BorderDarkBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                            <Button Grid.Column="1" Content="✕" Width="18" Height="18" Style="{StaticResource PartsRemoveIconButtonStyle}" Click="DeletePartCategory_Click" CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Height="1" Background="{StaticResource BorderDarkBrush}" Margin="0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="PartsInput" Width="220" Style="{StaticResource GradiantTextboxStyle1}" ToolTip="New category name"/>
                                <Button Content="Add" Width="80" Style="{StaticResource GradientBorderButtonStyleGreen}" Margin="8,0,0,0" Click="AddParts_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Inventory Types" Tag="Last">
                        <StackPanel Margin="8">
                            <ListBox x:Name="InventoryListBox" Height="260" Background="#1A1A1A" BorderBrush="{StaticResource BorderDarkBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                            <Button Grid.Column="1" Content="✕" Width="18" Height="18" Style="{StaticResource PartsRemoveIconButtonStyle}" Click="DeleteInventoryType_Click" CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Height="1" Background="{StaticResource BorderDarkBrush}" Margin="0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="InventoryInput" Width="220" Style="{StaticResource GradiantTextboxStyle1}" ToolTip="New category name"/>
                                <Button Content="Add" Width="80" Style="{StaticResource GradientBorderButtonStyleGreen}" Margin="8,0,0,0" Click="AddInventory_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Border>
</Window>
