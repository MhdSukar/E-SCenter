<Window x:Class="ESCenter.Windows.WarrantySystemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warranties"
        Height="600"
        Width="1229"
        MinHeight="420"
        MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>

        <!-- ── Local title-bar button styles (same pattern as MainWindow) ── -->
        <Style x:Key="WinBtnBase" TargetType="Button">
            <Setter Property="Width"           Value="46"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinCloseBtn" TargetType="Button" BasedOn="{StaticResource WinBtnBase}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="0,8,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E81123"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#C50F1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Warranty State colour helpers ── -->
        <!-- Used in DataTriggers below for the State pill -->

    </Window.Resources>

    <!-- Rounded window shell -->
    <Border CornerRadius="12"
            Background="{StaticResource AppBackgroundBrush}"
            BorderBrush="{StaticResource DarkBorderBrush}"
            BorderThickness="0"
            SnapsToDevicePixels="True">
        <Grid>

            <!-- ══ CUSTOM TITLE BAR ══ -->
            <Border Height="36"
                    VerticalAlignment="Top"
                    Background="{StaticResource DarkCardBrush}"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon + title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{StaticResource Warranty}"
                               Width="20" Height="20" Margin="12,0,8,0"
                               VerticalAlignment="Center"/>
                        <TextBlock Text="Warranty Tracking"
                                   FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Gradient.Primary.Horizontal}"/>
                    </StackPanel>

                    <!-- Drag area -->
                    <Border Grid.Column="1" Background="Transparent"/>

                    <!-- Window controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="btnMinimize" Style="{StaticResource WinBtnBase}"
                                Click="btnMinimize_Click">
                            <Image Source="{StaticResource Minimize}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="btnMaximize" Style="{StaticResource WinBtnBase}"
                                Click="btnMaximize_Click">
                            <Image Source="{StaticResource Maximize}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource WinCloseBtn}" Click="btnClose_Click">
                            <Image Source="{StaticResource Close}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ MAIN CONTENT (below title bar) ══ -->
            <Grid Margin="0,36,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- expiring soon alert -->
                    <RowDefinition Height="Auto"/>
                    <!-- toolbar / header -->
                    <RowDefinition Height="*"/>
                    <!-- main warranties grid -->
                    <RowDefinition Height="Auto"/>
                    <!-- status / action bar -->
                </Grid.RowDefinitions>

                <!-- ── Row 0: Active Warranties panel ── -->
                <Border Grid.Row="0"
                        Margin="12,12,12,0"
                        CornerRadius="10"
                        BorderThickness="1"
                        ClipToBounds="True">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#5022C55E" Offset="0"/>
                            <GradientStop Color="#2022C55E" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0C22C55E" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="0.6"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Expander IsExpanded="True" Background="Transparent" BorderThickness="0">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Margin="4,0">
                                <!-- Warning dot -->
                                <Ellipse Width="8" Height="8" Fill="#22C55E"
                                         VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#22C55E" BlurRadius="6"
                                                          ShadowDepth="0" Opacity="0.9"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock Text="Active Warranties"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="#22C55E" VerticalAlignment="Center"/>
                                <TextBlock Text=" — still valid"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <!-- Count badge -->
                                <Border Background="#1A22C55E" BorderBrush="#3022C55E"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActiveWarrantyCount}"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="#22C55E"/>
                                </Border>
                            </StackPanel>
                        </Expander.Header>

                        <DataGrid ItemsSource="{Binding ActiveWarrantyItems}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  MaxHeight="130"
                                  Margin="8,4,8,8"
                                  Style="{StaticResource DarkDataGridStyle}"
                                  RowStyle="{StaticResource CompactDataGridRowStyle}"
                                  ColumnHeaderStyle="{StaticResource CompactDataGridHeaderStyle}"
                                  CellStyle="{StaticResource CompactDataGridCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="ESC-ID" Width="120" SortMemberPath="EscId">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#1A237EF2" BorderBrush="#30237EF2"
                                                    BorderThickness="1" CornerRadius="4"
                                                    Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding EscId}"
                                                           Foreground="#5AA7FF"
                                                           FontFamily="Consolas"
                                                           FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Client" Binding="{Binding ClientName}" Width="200"/>
                                <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="600"/>
                                <DataGridTemplateColumn Header="Serial / IMEI" Width="150" SortMemberPath="SerialNumber">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#14FFFFFF" CornerRadius="4" Padding="6,2"
                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SerialNumber}"
                           FontFamily="Consolas" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Days Remaining — colour-coded -->
                                <DataGridTemplateColumn Header="Days Remaining" Width="150" SortMemberPath="DaysRemainingText">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    CornerRadius="10" Padding="10,3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#1A22C55E"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUrgent}" Value="True">
                                                                <Setter Property="Background" Value="#1AFBBF24"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding DaysRemainingText}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#22C55E"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUrgent}" Value="True">
                                                                    <Setter Property="Foreground" Value="#FBBF24"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Expander>
                </Border>

                <!-- ── Row 1: Main toolbar ── -->
                <Border Grid.Row="1"
                        Margin="12,10,12,0"
                        CornerRadius="10"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#00E5D4" BlurRadius="16" ShadowDepth="0" Opacity="0.07"/>
                    </Border.Effect>
                    <Grid>
                        <!-- Teal→blue accent bar -->
                        <Border Width="4" CornerRadius="10,0,0,10"
                                HorizontalAlignment="Left" VerticalAlignment="Stretch">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00E5D4" Offset="0"/>
                                    <GradientStop Color="#237EF2" Offset="0.5"/>
                                    <GradientStop Color="#2952D9" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <DockPanel LastChildFill="False" Margin="16,10,12,10">

                            <!-- Title -->
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="0,0,16,0">
                                <Image Source="{StaticResource Warranty}"
                                       Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Warranties Database"
                                               FontSize="17" FontWeight="Bold"
                                               Foreground="{StaticResource Gradient.Primary.Horizontal}"
                                               Margin="0,0,0,1"/>
                                    <TextBlock Text="{Binding WarrantyItems.Count, StringFormat='{}{0} records'}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Separator -->
                            <Separator DockPanel.Dock="Left" Style="{x:Null}" Width="1"
                                       Background="{StaticResource BorderDarkBrush}"
                                       Margin="0,4,16,4"/>

                            <!-- Search -->
                            <Border DockPanel.Dock="Left"
                                    CornerRadius="7"
                                    BorderBrush="{StaticResource BorderDarkBrush}"
                                    BorderThickness="1"
                                    Background="{StaticResource AppBackgroundBrush}"
                                    Width="230" Height="32"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="{StaticResource AISearch}"
                                           Width="15" Height="15" Margin="8,0,5,0"
                                           VerticalAlignment="Center" Opacity="0.5"/>
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource GradiantTextboxStyle1}"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center"
                                             BorderThickness="0" Background="Transparent" Padding="0"/>
                                </Grid>
                            </Border>

                            <!-- Action buttons (right) -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Width="100" Height="32" Margin="0,0,8,0"
                                        Style="{StaticResource GradientBorderButtonStyleAccent}"
                                        Click="RefreshButton_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="{StaticResource Refresh}" Width="14" Height="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="Refresh" FontSize="13"/>
                                    </StackPanel>
                                </Button>
                                <Button Width="100" Height="32"
                                        Style="{StaticResource GradientBorderButtonStyleYellow}"
                                        Click="CloseButton_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="{StaticResource Close}" Width="13" Height="13" Margin="0,0,6,0"/>
                                        <TextBlock Text="Close" FontSize="13"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- ── Row 2: Main warranties DataGrid ── -->
                <Border Grid.Row="2"
                        Margin="12,10,12,0"
                        CornerRadius="10"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="1"
                        ClipToBounds="True">

                    <DataGrid ItemsSource="{Binding WarrantyItems}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              Style="{StaticResource DarkDataGridStyle}"
                              RowStyle="{StaticResource CompactDataGridRowStyle}"
                              ColumnHeaderStyle="{StaticResource CompactDataGridHeaderStyle}"
                              CellStyle="{StaticResource CompactDataGridCellStyle}">

                        <DataGrid.Columns>

                            <!-- ESC-ID — monospace chip -->
                            <DataGridTemplateColumn Header="ESC-ID" Width="125" SortMemberPath="TicketCode">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#1A237EF2" BorderBrush="#30237EF2"
                                                BorderThickness="1" CornerRadius="4"
                                                Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TicketCode}"
                                                       Foreground="#5AA7FF"
                                                       FontFamily="Consolas"
                                                       FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Customer -->
                            <DataGridTextColumn Header="Customer"
                                                Binding="{Binding CustomerName}"
                                                Width="160"/>

                            <!-- Device -->
                            <DataGridTextColumn Header="Device"
                                                Binding="{Binding DeviceName}"
                                                Width="200"/>

                            <!-- Serial / IMEI — monospace capsule -->
                            <DataGridTemplateColumn Header="Serial / IMEI" Width="150" SortMemberPath="SerialNumber">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#14FFFFFF" CornerRadius="4" Padding="6,2"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SerialNumber}"
                                                       FontFamily="Consolas" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Warranty period -->
                            <DataGridTemplateColumn Header="Warranty" Width="100" SortMemberPath="WarrantyPeriod">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#1A5AA7FF" BorderBrush="#205AA7FF"
                                                BorderThickness="1" CornerRadius="10"
                                                Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding WarrantyPeriod}"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="#5AA7FF"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Start date -->
                            <DataGridTemplateColumn Header="Start" Width="110" SortMemberPath="WarrantyStartDateText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding WarrantyStartDateText}"
                                                   FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Expires date -->
                            <DataGridTemplateColumn Header="Expires" Width="110" SortMemberPath="WarrantyEndDateText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding WarrantyEndDateText}"
                                                   FontFamily="Consolas" FontSize="11"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <!-- Highlight expiry date red if expired -->
                                                        <DataTrigger Binding="{Binding WarrantyState}" Value="Expired">
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding WarrantyState}" Value="Expiring Soon">
                                                            <Setter Property="Foreground" Value="#FBBF24"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Days Left — colour-coded badge -->
                            <DataGridTemplateColumn Header="Days Left" Width="130" SortMemberPath="RemainingText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                                CornerRadius="5" Padding="10,3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1A22C55E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding WarrantyState}" Value="Expired">
                                                            <Setter Property="Background" Value="#2AEF4444"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding WarrantyState}" Value="Expiring Soon">
                                                            <Setter Property="Background" Value="#1AFBBF24"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding RemainingText}"
                                                       FontWeight="SemiBold" FontSize="11"
                                                       HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#22C55E"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WarrantyState}" Value="Expired">
                                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding WarrantyState}" Value="Expiring Soon">
                                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- State — colour-coded pill -->
                            <DataGridTemplateColumn Header="State" Width="110" SortMemberPath="WarrantyState">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                                CornerRadius="10" Padding="10,3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1A22C55E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding WarrantyState}" Value="Expired">
                                                            <Setter Property="Background" Value="#2AEF4444"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding WarrantyState}" Value="Expiring Soon">
                                                            <Setter Property="Background" Value="#1AFBBF24"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding WarrantyState}" Value="Active">
                                                            <Setter Property="Background" Value="#1A22C55E"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding WarrantyState}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#22C55E"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WarrantyState}" Value="Expired">
                                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding WarrantyState}" Value="Expiring Soon">
                                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- ── Row 3: Status bar ── -->
                <Grid Grid.Row="3" Margin="12,8,12,12">

                    <!-- Gradient separator line -->
                    <Border Height="1" VerticalAlignment="Top">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#0000E5D4" Offset="0"/>
                                <GradientStop Color="#3000E5D4" Offset="0.3"/>
                                <GradientStop Color="#30237EF2" Offset="0.7"/>
                                <GradientStop Color="#00237EF2" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <DockPanel Margin="0,6,0,0">

                        <!-- Left: record counts -->
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <!-- Total -->
                            <Border Background="#14237EF2" BorderBrush="#25237EF2"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="10,3" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Total: " FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding WarrantyItems.Count}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="#5AA7FF"/>
                                </StackPanel>
                            </Border>

                            <!-- Active -->
                            <Border Background="#1422C55E" BorderBrush="#2022C55E"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="10,3" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#22C55E"
                                             Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Active" FontSize="11" Foreground="#22C55E"/>
                                </StackPanel>
                            </Border>

                            <!-- Expiring Soon -->
                            <Border Background="#12FBBF24" BorderBrush="#20FBBF24"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="10,3" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#FBBF24"
                                             Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Expiring Soon" FontSize="11" Foreground="#FBBF24"/>
                                </StackPanel>
                            </Border>

                            <!-- Expired -->
                            <Border Background="#12EF4444" BorderBrush="#20EF4444"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="10,3">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#EF4444"
                                             Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Expired" FontSize="11" Foreground="#EF4444"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right: resize grip placeholder -->
                        <TextBlock DockPanel.Dock="Right" Text=""
                                   Foreground="Transparent"/>
                    </DockPanel>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
