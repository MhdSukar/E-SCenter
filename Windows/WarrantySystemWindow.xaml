<Window x:Class="ESCenter.Windows.WarrantySystemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warrenty.Sys"
        Height="560"
        Width="980"
        MinHeight="420"
        MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">

    <Border Style="{StaticResource CardBorderStyle}" Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Image Source="{StaticResource verified}" Width="20" Height="20" Margin="0,0,8,0"/>
                <TextBlock Text="Warranty Tracking"
                           Style="{StaticResource CardTitleTextStyle}"
                           Margin="0"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding WarrantyItems}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      Style="{StaticResource DarkDataGridStyle}"
                      RowStyle="{StaticResource CompactDataGridRowStyle}"
                      ColumnHeaderStyle="{StaticResource DarkDataGridHeaderStyle}"
                      CellStyle="{StaticResource CompactDataGridCellStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ticket"
                                        Binding="{Binding TicketCode}"
                                        Width="120"/>
                    <DataGridTextColumn Header="Customer"
                                        Binding="{Binding CustomerName}"
                                        Width="160"/>
                    <DataGridTextColumn Header="Device"
                                        Binding="{Binding DeviceName}"
                                        Width="220"/>
                    <DataGridTextColumn Header="Serial/IMEI"
                                        Binding="{Binding SerialNumber}"
                                        Width="150"/>
                    <DataGridTextColumn Header="Warranty"
                                        Binding="{Binding WarrantyPeriod}"
                                        Width="110"/>
                    <DataGridTextColumn Header="Start"
                                        Binding="{Binding WarrantyStartDateText}"
                                        Width="110"/>
                    <DataGridTextColumn Header="Expires"
                                        Binding="{Binding WarrantyEndDateText}"
                                        Width="110"/>
                    <DataGridTextColumn Header="Days Left"
                                        Binding="{Binding RemainingText}"
                                        Width="100"/>
                    <DataGridTextColumn Header="State"
                                        Binding="{Binding WarrantyState}"
                                        Width="90"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Refresh"
                        Width="100"
                        Margin="0,0,8,0"
                        Style="{StaticResource NeonCyanButtonStyle}"
                        Click="RefreshButton_Click"/>
                <Button Content="Close"
                        Width="100"
                        Style="{StaticResource NeonOrangeButtonStyle}"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
