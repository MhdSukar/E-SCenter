<Window x:Class="ESCenter.Windows.ExchangeRatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exchange Rates"
        Width="380"
        Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="TitleBarButtonBase" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonBase}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="0,8,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E81123"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#C50F1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12"
            Background="{StaticResource AppBackgroundBrushNew}"
            BorderBrush="{StaticResource DarkBorderBrush}"
            BorderThickness="0"
            SnapsToDevicePixels="True">
        <Grid>
            <Border Height="36"
                    Background="{StaticResource DarkCardBrush}"
                    CornerRadius="12,12,0,0"
                    BorderBrush="{StaticResource DarkBorderBrush}"
                    BorderThickness="0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    VerticalAlignment="Top">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0"
                           Source="/Themes/Philips E-SCenter Logo.png"
                           Width="18"
                           Height="18"
                           Margin="10,0,6,0"
                           VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="Exchange Rates"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>

                    <Button Grid.Column="2"
                            Style="{StaticResource TitleBarCloseButtonStyle}"
                            Click="btnClose_Click">
                        <Image Source="{StaticResource Close}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <Border Margin="0,36,0,0"
                    Padding="12"
                    CornerRadius="0,0,10,10"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="USD" VerticalAlignment="Center"/>
                    <TextBox x:Name="UsdRateBox" Grid.Row="0" Grid.Column="1" Margin="0,4,8,4" Style="{StaticResource GradiantTextboxStyle1}" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="S.P per 1 USD" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="EUR" VerticalAlignment="Center"/>
                    <TextBox x:Name="EurRateBox" Grid.Row="1" Grid.Column="1" Margin="0,4,8,4" Style="{StaticResource GradiantTextboxStyle1}" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="S.P per 1 EUR" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="RON" VerticalAlignment="Center"/>
                    <TextBox x:Name="RonRateBox" Grid.Row="2" Grid.Column="1" Margin="0,4,8,4" Style="{StaticResource GradiantTextboxStyle1}" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="S.P per 1 RON" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="GBP" VerticalAlignment="Center"/>
                    <TextBox x:Name="GbpRateBox" Grid.Row="3" Grid.Column="1" Margin="0,4,8,4" Style="{StaticResource GradiantTextboxStyle1}" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="S.P per 1 GBP" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="CHF" VerticalAlignment="Center"/>
                    <TextBox x:Name="ChfRateBox" Grid.Row="4" Grid.Column="1" Margin="0,4,8,4" Style="{StaticResource GradiantTextboxStyle1}" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="S.P per 1 CHF" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="CAD" VerticalAlignment="Center"/>
                    <TextBox x:Name="CadRateBox" Grid.Row="5" Grid.Column="1" Margin="0,4,8,4" Style="{StaticResource GradiantTextboxStyle1}" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="5" Grid.Column="2" Text="S.P per 1 CAD" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="TRY" VerticalAlignment="Center"/>
                    <TextBox x:Name="TryRateBox" Grid.Row="6" Grid.Column="1" Margin="0,4,8,4" Style="{StaticResource GradiantTextboxStyle1}" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="6" Grid.Column="2" Text="S.P per 1 TRY" VerticalAlignment="Center"/>

                    <StackPanel Grid.Row="8" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Save" Width="80" Margin="6,0" Style="{StaticResource GradientBorderButtonStyleGreen}" Click="SaveButton_Click"/>
                        <Button Content="Cancel" Width="80" Margin="6,0" Style="{StaticResource GradientBorderButtonStyleYellow}" Click="CancelButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
