<Window x:Class="ESCenter.Windows.UserProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="240"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">

    <Window.Resources>

        <DropShadowEffect x:Key="ProfileShadow"
                          Color="#000000"
                          BlurRadius="28"
                          ShadowDepth="8"
                          Opacity="0.65"/>

        <!-- Shared row style — same language as TrayPopupWindow -->
        <Style x:Key="ProfileRowStyle" TargetType="Button">
            <Setter Property="Height"           Value="36"/>
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Foreground"       Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Stripe"
                                    Width="3" CornerRadius="0,2,2,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Opacity="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00E5D4" Offset="0"/>
                                        <GradientStop Color="#2952D9" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="RowBg"
                                    Background="Transparent"
                                    CornerRadius="6"
                                    Margin="4,1"/>
                            <ContentPresenter Margin="12,0,10,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBg"  Property="Background" Value="#15237EF2"/>
                                <Setter TargetName="Stripe" Property="Opacity"    Value="1"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RowBg"  Property="Background" Value="#2000E5D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger variant — for sign-out / revoke admin -->
        <Style x:Key="ProfileDangerRowStyle" TargetType="Button"
               BasedOn="{StaticResource ProfileRowStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Stripe"
                                    Width="3" CornerRadius="0,2,2,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Background="{StaticResource NeonRedBrush}"
                                    Opacity="0"/>
                            <Border x:Name="RowBg"
                                    Background="Transparent"
                                    CornerRadius="6"
                                    Margin="4,1"/>
                            <ContentPresenter Margin="12,0,10,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBg"  Property="Background" Value="#18FF3B3B"/>
                                <Setter TargetName="Stripe" Property="Opacity"    Value="1"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource NeonRedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="#28FF3B3B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ═══ Outer shell with gradient ring ═══════════════════════ -->
    <Border CornerRadius="16"
            Effect="{StaticResource ProfileShadow}"
            Padding="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#4000E5D4" Offset="0.0"/>
                <GradientStop Color="#40237EF2" Offset="0.5"/>
                <GradientStop Color="#402952D9" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>

        <!-- Inner surface -->
        <Border CornerRadius="15"
                Background="#161616"
                Padding="0,14,0,10">
            <StackPanel>

                <!-- ═══ Avatar + identity block ══════════════════ -->
                <StackPanel Margin="16,0,16,0">

                    <!-- Avatar -->
                    <Grid HorizontalAlignment="Center" Margin="0,0,0,12">

                        <!-- Gradient ring behind avatar -->
                        <Border Width="60" Height="60"
                                CornerRadius="30"
                                Padding="2">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00E5D4" Offset="0.0"/>
                                    <GradientStop Color="#00A8C8" Offset="0.5"/>
                                    <GradientStop Color="#2952D9" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <!-- Avatar circle -->
                            <Border CornerRadius="28" Background="#1E1E1E">
                                <TextBlock x:Name="AvatarInitial"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="{Binding CurrentUser,
                                                  RelativeSource={RelativeSource AncestorType=Window},
                                                  Converter={StaticResource InitialConverter}}"/>
                            </Border>
                        </Border>

                    </Grid>

                    <!-- Username -->
                    <TextBlock x:Name="UsernameLabel"
                               Text="{Binding CurrentUser,
                                      RelativeSource={RelativeSource AncestorType=Window}}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#00E5D4" Offset="0.0"/>
                                <GradientStop Color="#237EF2" Offset="1.0"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>

                    <!-- Role badge -->
                    <Border HorizontalAlignment="Center"
                            Margin="0,6,0,0"
                            Padding="10,3"
                            CornerRadius="10"
                            Background="#1AFF3B3B">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#FF3B3B" Opacity="0.35"/>
                        </Border.BorderBrush>
                        <Border.BorderThickness>1</Border.BorderThickness>
                        <TextBlock Text="Administrator"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource NeonRedBrush}"
                                   HorizontalAlignment="Center"/>
                    </Border>

                </StackPanel>

                <!-- ═══ Divider ═══════════════════════════════════ -->
                <Border Height="1"
                        Margin="16,14,16,6"
                        Opacity="0.15">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#00E5D4" Offset="0"/>
                            <GradientStop Color="#237EF2" Offset="0.5"/>
                            <GradientStop Color="#2952D9" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- ═══ Action rows ════════════════════════════════ -->
                <Button Style="{StaticResource ProfileRowStyle}"
                        x:Name="BtnSettings"
                        Click="BtnSettings_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="&#xE713;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <TextBlock Grid.Column="1"
                                   Text="Settings"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   FontSize="12"
                                   Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Grid>
                </Button>

                <Button Style="{StaticResource ProfileRowStyle}"
                        x:Name="BtnChangePassword"
                        Click="BtnChangePassword_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="&#xE8D7;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <TextBlock Grid.Column="1"
                                   Text="Change password"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   FontSize="12"
                                   Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Grid>
                </Button>

                <!-- Divider before danger zone -->
                <Border Height="1"
                        Margin="16,6,16,4"
                        Background="#10FFFFFF"/>

                <Button Style="{StaticResource ProfileDangerRowStyle}"
                        x:Name="BtnRevokeAdmin"
                        Click="BtnRevokeAdmin_Click"
                        Foreground="{StaticResource TextSecondaryBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="&#xE8F8;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <TextBlock Grid.Column="1"
                                   Text="Revoke admin access"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   FontSize="12"
                                   Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Grid>
                </Button>

            </StackPanel>
        </Border>
    </Border>
</Window>