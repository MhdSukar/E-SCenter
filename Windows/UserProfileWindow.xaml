<Window x:Class="ESCenter.Windows.UserProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="220" Height="160"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">

    <Border CornerRadius="12"
            Background="{StaticResource DarkBackgroundBrush}"
            BorderBrush="{StaticResource NeonBlueBrush}"
            BorderThickness="1"
            Padding="14">
        <Border.Effect>
            <DropShadowEffect Color="#99000000" BlurRadius="20"
                              ShadowDepth="6" Opacity="0.55"/>
        </Border.Effect>

        <StackPanel>
            <!-- User avatar placeholder + username -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="36" Height="36" CornerRadius="18"
                        Background="{StaticResource NewPrimaryBlueBrush}"
                        Margin="0,0,10,0">
                    <TextBlock x:Name="AvatarInitial"
                               FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="White"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="UsernameLabel"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource Gradient.Primary}"/>
                    <TextBlock Text="Administrator"
                               FontSize="10"
                               Foreground="{StaticResource Gradient.Danger}"/>
                </StackPanel>
            </StackPanel>

            <!-- Divider -->
            <Border Height="1" Background="{StaticResource BorderDarkBrush}"
                    Margin="0,0,0,10"/>

            <!-- Settings button (empty/placeholder for now) -->
            <Button x:Name="BtnSettings"
                    Height="32"
                    Style="{StaticResource NeonBorderButtonStyle}"
                    Click="BtnSettings_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource Settings}"  Width="16" Height="16"
                           Margin="0,0,8,0"/>
                    <TextBlock Text="Settings"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
