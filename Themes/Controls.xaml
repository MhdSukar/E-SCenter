    <!-- ================= BASE GRADIENT CHECKBOX ================= -->
    <Style x:Key="GradientCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="FontSize"                 Value="12"/>
        <Setter Property="Foreground"               Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Cursor"                   Value="Hand"/>
        <Setter Property="Height"                   Value="28"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle"         Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Tick box -->
                        <Grid Width="18" Height="18" Margin="0,0,9,0">

                            <!-- Gradient ring (1px, outside, visible only when checked/focused) -->
                            <Border x:Name="Ring"
                            CornerRadius="5"
                            Opacity="0"
                            Padding="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#00E5D4" Offset="0.0"/>
                                        <GradientStop Color="#00A8C8" Offset="0.5"/>
                                        <GradientStop Color="#2952D9" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Box surface -->
                            <Border x:Name="Box"
                            Background="#1A1A1A"
                            BorderBrush="#FF404040"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="1"/>

                            <!-- Checked fill -->
                            <Border x:Name="Fill"
                            CornerRadius="3"
                            Margin="2"
                            Opacity="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1800E5D4" Offset="0.0"/>
                                        <GradientStop Color="#182952D9" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Check mark -->
                            <Path x:Name="Check"
                          Data="M2.5,9 L7,13.5 L15.5,3.5"
                          Stroke="#00E5D4"
                          StrokeThickness="2"
                          StrokeEndLineCap="Round"
                          StrokeStartLineCap="Round"
                          StrokeLineJoin="Round"
                          Visibility="Collapsed"
                          Margin="1"/>
                        </Grid>

                        <ContentPresenter VerticalAlignment="Center"/>

                    </StackPanel>

                    <ControlTemplate.Triggers>

                        <!-- Hover (unchecked) -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked"   Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box"  Property="BorderBrush" Value="#FF5A5A5A"/>
                            <Setter TargetName="Ring" Property="Opacity"     Value="0.4"/>
                            <Setter Property="Foreground"
                            Value="{StaticResource TextPrimaryBrush}"/>
                        </MultiTrigger>

                        <!-- Checked -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Ring"  Property="Opacity"    Value="1"/>
                            <Setter TargetName="Fill"  Property="Opacity"    Value="1"/>
                            <Setter TargetName="Box"   Property="BorderThickness" Value="0"/>
                            <Setter TargetName="Box"   Property="Margin"    Value="1"/>
                            <Setter Property="Foreground"
                            Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>

                        <!-- Hover (checked) -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked"   Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                        </MultiTrigger>

                        <!-- Keyboard focus -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="0.7"/>
                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

