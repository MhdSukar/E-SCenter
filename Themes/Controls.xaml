    <Style x:Key="TitleBarTabButtonStyle" TargetType="RadioButton">
        <Setter Property="Background"        Value="Transparent"/>
        <Setter Property="BorderThickness"   Value="0"/>
        <Setter Property="Foreground"        Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize"          Value="12"/>
        <Setter Property="FontWeight"        Value="Normal"/>
        <Setter Property="Height"            Value="36"/>
        <Setter Property="Padding"           Value="12,0"/>
        <Setter Property="Cursor"            Value="Hand"/>
        <Setter Property="FocusVisualStyle"  Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <!-- Active indicator line at bottom -->
                            <RowDefinition Height="2"/>
                        </Grid.RowDefinitions>

                        <!-- Hover / pressed background -->
                        <Border x:Name="HoverBg"
                        Grid.Row="0"
                        Background="Transparent"
                        Margin="2,4,2,0"
                        CornerRadius="6"/>

                        <!-- Tab content -->
                        <ContentPresenter x:Name="Content"
                                  Grid.Row="0"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Margin="{TemplateBinding Padding}"/>

                        <!-- Active indicator: gradient underline -->
                        <Border x:Name="ActiveLine"
                        Grid.Row="1"
                        CornerRadius="1"
                        Margin="8,0,8,0"
                        Opacity="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#00E5D4" Offset="0.0"/>
                                    <GradientStop Color="#00A8C8" Offset="0.5"/>
                                    <GradientStop Color="#2952D9" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                    </Grid>

                    <ControlTemplate.Triggers>

                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverBg" Property="Background"
                            Value="#12237EF2"/>
                            <Setter Property="Foreground"
                            Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>

                        <!-- Pressed -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HoverBg" Property="Background"
                            Value="#20237EF2"/>
                        </Trigger>

                        <!-- Checked / active tab -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ActiveLine"  Property="Opacity"  Value="1"/>
                            <Setter TargetName="HoverBg"     Property="Background"
                            Value="#0D00E5D4"/>
                            <Setter Property="Foreground">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#00E5D4" Offset="0.0"/>
                                        <GradientStop Color="#5AA7FF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>

                        <!-- Checked + hovered — keep line visible -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked"    Value="True"/>
                                <Condition Property="IsMouseOver"  Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HoverBg" Property="Background"
                            Value="#1800E5D4"/>
                        </MultiTrigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

