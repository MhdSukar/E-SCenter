                            <DataGridCellsPresenter/>
                        </SelectiveScrollingGrid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowBd" Property="Background" Value="#10237EF2"/>
