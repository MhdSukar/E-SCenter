                                Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RowBd" Property="Background" Value="#18237EF2"/>
                            <Setter TargetName="RowBd" Property="BorderBrush" Value="#30237EF2"/>
                            <Setter Property="Foreground" Value="#5AA7FF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
