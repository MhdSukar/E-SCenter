    <Style x:Key="TicketCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource CompactDataGridCellStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding DeliveryDate, Converter={StaticResource NullToBooleanConverter}}" Value="False">
                <Setter Property="Background" Value="#1B5E20"/>
                <Setter Property="Foreground" Value="#E8F5E9"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DarkDataGridStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowHeight" Value="32"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <!-- Make textblocks inside DataGrid cells not handle mouse events so clicks bubble to the cell/row -->
        <Style.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="IsHitTestVisible" Value="False"/>
                <!-- Center text horizontally and vertically inside DataGrid cells -->
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
        </Style.Resources>
    </Style>

    <Style x:Key="TicketRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource CompactDataGridRowStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <!-- Ready for pickup: blue 1565C0-->
            <DataTrigger Binding="{Binding IsReadyForPickup}" Value="True">
                <Setter Property="Background" Value="#FFCC2F2F"/> 
                <!-- nice blue -->
                <Setter Property="Foreground" Value="White"/>
            </DataTrigger>

            <!-- Closed ticket: green -->
            <DataTrigger Binding="{Binding DeliveryDate, Converter={StaticResource NullToBooleanConverter}}" Value="False">
                <Setter Property="Background" Value="#1B5E20"/>
                <Setter Property="Foreground" Value="#E8F5E9"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>


    <Style x:Key="PriorityCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource CompactDataGridCellStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding DeliveryDate, Converter={StaticResource NullToBooleanConverter}}" Value="False">
                <Setter Property="Background" Value="#1B5E20"/>
                <Setter Property="Foreground" Value="#E8F5E9"/>
            </DataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding PriorityLevel}" Value="Minor" />
                    <Condition Binding="{Binding DeliveryDate, Converter={StaticResource NullToBooleanConverter}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="#B2DFDB"/>
                <Setter Property="Foreground" Value="Black"/>
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding PriorityLevel}" Value="Normal" />
                    <Condition Binding="{Binding DeliveryDate, Converter={StaticResource NullToBooleanConverter}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="#FF1591BB"/>
                <Setter Property="Foreground" Value="Black"/>
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding PriorityLevel}" Value="Major" />
                    <Condition Binding="{Binding DeliveryDate, Converter={StaticResource NullToBooleanConverter}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="#FFD2B114"/>
                <Setter Property="Foreground" Value="Black"/>
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding PriorityLevel}" Value="Critical" />
                    <Condition Binding="{Binding DeliveryDate, Converter={StaticResource NullToBooleanConverter}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="#FFCE1A1A"/>
                <Setter Property="Foreground" Value="White"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

