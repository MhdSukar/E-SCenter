    <!-- DataGrid centering helpers kept as explicit keys -->
    <Style TargetType="TextBlock" x:Key="DataGridTextBlockCenterStyle">
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="DataGridColumnHeader" x:Key="DataGridColumnHeaderCenterStyle" BasedOn="{StaticResource DarkDataGridHeaderStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="NeonCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="18" Height="18" Margin="0,0,8,0">
                            <!-- Glow -->
                            <Border x:Name="Glow"
                                BorderBrush="{StaticResource NeonRedBrush}"
                                BorderThickness="2"
                                CornerRadius="4"
                                Opacity="0"
                                Effect="{StaticResource NeonRedGlowEffect}"/>

                            <!-- Box -->
                            <Border x:Name="Box"
                                Background="{StaticResource PanelBackgroundBrush}"
                                BorderBrush="{StaticResource BorderDarkBrush}"
                                BorderThickness="1.4"
                                CornerRadius="4"/>

                            <!-- Check mark -->
                            <Path x:Name="Check"
                              Data="M2,9 L7,14 L16,3"
                              Stroke="{StaticResource NeonRedBrush}"
                              StrokeThickness="2"
                              StrokeEndLineCap="Round"
                              StrokeStartLineCap="Round"
                              Visibility="Collapsed"/>
                        </Grid>

                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <!-- Checked -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource NeonRedBrush}"/>
                            <Setter TargetName="Glow" Property="Opacity" Value="0.9"/>
                        </Trigger>

                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource NeonCyanBrush}"/>
                        </Trigger>

                        <!-- Focus -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Glow" Property="Opacity" Value="0.9"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource NeonRedBrush}"/>
                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Opacity" Value="0.4"/>
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= TitleBar Navigation Tabs ================= -->
    <Style x:Key="TitleBarTabButtonStyle" TargetType="RadioButton">
        <Setter Property="Height" Value="26"/>
        <Setter Property="MinWidth" Value="90"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root"
                                Property="Background"
                                Value="#22FFFFFF"/>
                            <Setter Property="Foreground"
                                Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>

                        <!-- Active Tab -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root"
                                Property="Background"
                                Value="#33FFFFFF"/>
                            <Setter Property="Foreground"
                                Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                Value="#66FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


