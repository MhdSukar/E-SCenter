    <!--     Check Boxes     -->
    <Style x:Key="GradientCheckBoxStyleOLD" TargetType="CheckBox">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="18" Height="18" Margin="0,0,8,0">

                            <!-- Glow layer -->
                            <Border x:Name="Glow"
                                BorderBrush="{StaticResource Gradient.Primary}"
                                BorderThickness="2"
                                CornerRadius="4"
                                Opacity="0"
                                Effect="{StaticResource GradientPrimaryGlowEffect}"/>

                            <!-- Box -->
                            <Border x:Name="Box"
                                Background="{StaticResource PanelBackgroundBrush}"
                                BorderBrush="{StaticResource BorderDarkBrush}"
                                BorderThickness="1.4"
                                CornerRadius="4"/>

                            <!-- Gradient fill overlay when checked -->
                            <Border x:Name="Fill"
                                Background="{StaticResource Gradient.Primary.Subtle}"
                                CornerRadius="3"
                                Opacity="0"/>

                            <!-- Check mark — solid mid-gradient color for visibility -->
                            <Path x:Name="Check"
                                Data="M2,9 L7,14 L16,3"
                                Stroke="#00D0C8"
                                StrokeThickness="2.2"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                Visibility="Collapsed"/>
                        </Grid>

                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>

                    <ControlTemplate.Triggers>

                        <!-- Checked -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check"  Property="Visibility"  Value="Visible"/>
                            <Setter TargetName="Box"    Property="BorderBrush" Value="{StaticResource Gradient.Primary}"/>
                            <Setter TargetName="Fill"   Property="Opacity"     Value="1"/>
                            <Setter TargetName="Glow"   Property="Opacity"     Value="0.85"/>
                        </Trigger>

                        <!-- Hover (unchecked) -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked"   Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box"  Property="BorderBrush" Value="{StaticResource Gradient.Primary}"/>
                            <Setter TargetName="Glow" Property="Opacity"     Value="0.35"/>
                        </MultiTrigger>

                        <!-- Hover (checked) -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked"   Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Glow" Property="Opacity" Value="1.0"/>
                        </MultiTrigger>

                        <!-- Keyboard focus -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Glow" Property="Opacity"     Value="0.9"/>
                            <Setter TargetName="Box"  Property="BorderBrush" Value="{StaticResource Gradient.Primary}"/>
                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Opacity" Value="0.4"/>
                            <Setter Property="Opacity"                  Value="0.6"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

