    <!-- Group Boxes Styles -->
    <Style x:Key="GradientGroupBoxBlueCyan" TargetType="GroupBox">
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Foreground"      Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="10"/>
        <Setter Property="Margin"          Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Card shell -->
                        <Border Grid.Row="0" Grid.RowSpan="2"
                            Background="#161616"
                            CornerRadius="10"
                            BorderThickness="1">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3000E5D4" Offset="0.0"/>
                                    <GradientStop Color="#30237EF2" Offset="0.5"/>
                                    <GradientStop Color="#302952D9" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                        </Border>

                        <!-- Header row with left accent bar -->
                        <Border Grid.Row="0"
                            CornerRadius="10,10,0,0"
                            Padding="12,8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#0C00E5D4" Offset="0.0"/>
                                    <GradientStop Color="#00161616" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <DockPanel>
                                <!-- Left accent stripe -->
                                <Border DockPanel.Dock="Left"
                                    Width="3" CornerRadius="2"
                                    Margin="0,0,10,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00E5D4" Offset="0.0"/>
                                            <GradientStop Color="#2952D9" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter ContentSource="Header"
                                              VerticalAlignment="Center"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </DockPanel>
                        </Border>

                        <!-- Divider -->
                        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1"
                            Margin="12,0,12,0" Opacity="0.12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#00E5D4" Offset="0"/>
                                    <GradientStop Color="#2952D9" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Content -->
                        <ContentPresenter Grid.Row="1"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Stretch"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

