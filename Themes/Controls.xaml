    <!-- Modern ProgressBar Style -->
    <Style x:Key="ModernProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="16"/>
        <Setter Property="Foreground" Value="#FF1ABC9C"/>
        <!-- default fill color (turquoise) -->
        <Setter Property="Background" Value="#FF2C2C2C"/>
        <!-- dark background -->
        <Setter Property="BorderBrush" Value="#FF3A3A3A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="RootGrid" SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                        <Border x:Name="PART_Track" CornerRadius="8" Background="{TemplateBinding Background}"/>
                        <Border x:Name="PART_Indicator" CornerRadius="8" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" Width="0">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                            </Border.Effect>
                        </Border>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Animate the indicator width smoothly -->
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Width" Value="Auto"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

