<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DropShadowEffect x:Key="PnLCardShadow" BlurRadius="16" ShadowDepth="2" Opacity="0.35" Color="#66000000"/>

    <Style x:Key="PnLCardStyle" TargetType="Border">
        <Setter Property="Background" Value="#161B22"/>
        <Setter Property="BorderBrush" Value="#27313D"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Effect" Value="{StaticResource PnLCardShadow}"/>
    </Style>

    <Style x:Key="PnLLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#8B949E"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="PnLValueStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#E6EDF3"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,4,0,4"/>
    </Style>

    <Style x:Key="PnLChartTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#E6EDF3"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
</ResourceDictionary>
