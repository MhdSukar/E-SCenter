<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core / App -->
    <!-- App Background -->
    <Color x:Key="AppBackgroundColor">#FF000000</Color>
    <!-- Pure black -->
    <Color x:Key="DarkBackground">#121212</Color>
    <Color x:Key="DarkSurface">#252525</Color>

    <!-- Backgrounds / Panels / Cards -->
    <Color x:Key="PanelBackgroundColor">#252830</Color>
    <Color x:Key="CardBackgroundColor">#1E1E1E</Color>
    <Color x:Key="DarkCard">#1E1E1E</Color>

    <!-- Borders / Dividers -->
    <Color x:Key="BorderDarkColor">#FF404040</Color>
    <!-- Card border grey -->
    <Color x:Key="DarkBorder">#237EF2</Color>
    <Color x:Key="DividerColor">#FF27313D</Color>

    <!-- Text colors -->
    <Color x:Key="TextPrimaryColor">#E0E0E0</Color>
    <!-- White for titles/buttons -->
    <Color x:Key="TextPrimary">#ffffff</Color>
    <Color x:Key="TextLogo">#237EF2</Color>
    <Color x:Key="TextSecondaryColor">#FFB3B3B3</Color>
    <!-- Light grey for subtitles -->
    <Color x:Key="TextSecondary">#b3b3b3</Color>

    <Color x:Key="TextTertiaryColor">#FF76818D</Color>
    <Color x:Key="TextTertiary">#808080</Color>

    <Color x:Key="TextDisabledColor">#FF5E5E5E</Color>

    <!-- Primary / Brand / Accent -->
    <Color x:Key="Primary">#2E8B57</Color>
    <Color x:Key="PrimaryGreen">#2E8B57</Color>
    <Color x:Key="PrimaryLight">#4CAF50</Color>
    <Color x:Key="PrimaryBlue">#4682B4</Color>
    <Color x:Key="AccentRed">#DC143C</Color>

    <!-- Semantic colors -->
    <Color x:Key="SuccessColor">#FF4CAF50</Color>
    <Color x:Key="WarningColor">#FFFF9800</Color>
    <Color x:Key="ErrorColor">#FFF44336</Color>
    <Color x:Key="InfoColor">#FF2196F3</Color>

    <!-- Neon accents -->
    <Color x:Key="NeonRedColor">#FFFF3B3B</Color>
    <Color x:Key="NeonRedSoftColor">#FFFF6B6B</Color>
    <Color x:Key="NeonRedDarkColor">#FFCC2F2F</Color>

    <Color x:Key="NeonCyanColor">#FF3BE7FF</Color>
    <Color x:Key="NeonCyanSoftColor">#FF6BEFFF</Color>
    <Color x:Key="NeonCyanDarkColor">#FF2FB8CC</Color>

    <!-- Logo Blue -->
    <Color x:Key="NewPrimaryBlue">#237EF2</Color>
    <!-- Backgrounds -->
    <Color x:Key="NewDarkBackground">#121212</Color>
    <Color x:Key="CardBackground">#1E1E1E</Color>
    <!-- Text -->
    <Color x:Key="PrimaryText">#E0E0E0</Color>
    <Color x:Key="SecondaryText">#A0A0A0</Color>
    <!-- Accent -->
    <Color x:Key="AccentHover">#4FC3F7</Color>

</ResourceDictionary>