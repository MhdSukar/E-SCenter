<Application x:Class="ESCenter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ESCenter.ViewModels"
             xmlns:views="clr-namespace:ESCenter.Views"
             xmlns:conv="clr-namespace:ESCenter.Converters">
    <!--StartupUri="MainWindow.xaml">-->

    <Application.Resources>
        <ResourceDictionary>
            <!-- Merge your themes first (property element must be before dictionary items) -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Colors.xaml"/>
                <ResourceDictionary Source="/Themes/Brushes.xaml"/>
                <ResourceDictionary Source="/Themes/Controls.xaml"/>
                <ResourceDictionary Source="/Themes/IconsTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Declare converters -->
            <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <conv:NullToBooleanConverter x:Key="NullToBooleanConverter"/>
            <conv:SeriesKeyToIconConverter x:Key="SeriesKeyToIconConverter"/>
            <conv:StatusLevelToBrushConverter x:Key="StatusLevelToBrushConverter"/>
            <conv:StatusLevelToIconConverter x:Key="StatusLevelToIconConverter"/>

            <!-- ================= MVVM View Mappings ================= -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:RepairTicketsViewModel}">
                <views:RepairTicketsView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:PartsControlViewModel}">
                <views:PartsControlView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                <views:ReportsView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
                <views:InventoryView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:BoneyardViewModel}">
                <views:BoneyardView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:AlBarakaViewModel}">
                <views:AlBarakaView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
