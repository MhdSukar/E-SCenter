 Services/AlBarakaDataService.cs      | 22 +++++++---
 Services/TicketsDataService.cs       | 16 ++++++-
 ViewModels/DashboardViewModel.cs     | 37 ++++++++++++----
 ViewModels/MainViewModel.cs          | 66 +++++++++++++++-------------
 ViewModels/RepairTicketsViewModel.cs | 50 +++++++++++++++------
 8 files changed, 186 insertions(+), 62 deletions(-)

