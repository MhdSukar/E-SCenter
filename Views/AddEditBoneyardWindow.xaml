<Window x:Class="ESCenter.Views.AddEditBoneyardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add/Edit Device"
        Width="400"
        Height="450"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- ================= TITLE BAR BUTTON BASE ================= -->
        <Style x:Key="TitleBarButtonBase" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= CLOSE BUTTON ================= -->
        <Style x:Key="TitleBarCloseButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TitleBarButtonBase}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0,8,0,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E81123"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#C50F1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ===================== WINDOW SHELL ===================== -->
    <Border CornerRadius="12"
            Background="{StaticResource AppBackgroundBrushNew}"
            BorderBrush="{StaticResource DarkBorderBrush}"
            BorderThickness="0"
            SnapsToDevicePixels="True">

        <Grid>

            <!-- ===================== CUSTOM TITLE BAR ===================== -->
            <Border Height="36"
                    Background="{StaticResource DarkCardBrush}"
                    CornerRadius="12,12,0,0"
                    BorderBrush="{StaticResource DarkBorderBrush}"
                    BorderThickness="0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    VerticalAlignment="Top">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Icon -->
                    <Image Grid.Column="0"
                           Source="/Assets/Icons/Philips E-SCenter Logo.png"
                           Width="18"
                           Height="18"
                           Margin="10,0,6,0"
                           VerticalAlignment="Center"/>

                    <!-- Title -->
                    <TextBlock Grid.Column="1"
                               Text="Boneyard Device"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>

                    <!-- Window Buttons -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal">

                        <Button Style="{StaticResource TitleBarButtonBase}"
                                Click="btnMinimize_Click"
                                x:Name="btnMinimize">
                            <Image Source="{StaticResource Minimize}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>

                        <Button Style="{StaticResource TitleBarButtonBase}"
                                x:Name="btnMaximize"
                                FontSize="17"
                                Click="btnMaximize_Click">
                            <Image Source="{StaticResource Maximize}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>

                        <Button Style="{StaticResource TitleBarCloseButtonStyle}"
                                Click="btnClose_Click">
                            <Image Source="{StaticResource Close}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================== MAIN CONTENT ===================== -->
            <Border Margin="0,36,0,0"
                    Padding="12"
                    CornerRadius="0,0,10,10"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ===================== FORM ===================== -->
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Device Type -->
                        <TextBlock Text="Device Type" Grid.Row="0" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                        <ComboBox ItemsSource="{Binding DeviceTypes}" 
                                  SelectedIndex="{Binding Device.DeviceType}" 
                                  Grid.Row="0" Grid.Column="1" 
                                  Style="{StaticResource NeonComboBoxStyle}" Margin="0,4"/>

                        <!-- Brand -->
                        <TextBlock Text="Brand" Grid.Row="1" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                        <TextBox Text="{Binding Device.Brand}" Grid.Row="1" Grid.Column="1" Style="{StaticResource NeonTextBoxStyle}" Margin="0,4"/>

                        <!-- Model -->
                        <TextBlock Text="Model" Grid.Row="2" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                        <TextBox Text="{Binding Device.Model}" Grid.Row="2" Grid.Column="1" Style="{StaticResource NeonTextBoxStyle}" Margin="0,4"/>

                        <!-- Condition -->
                        <TextBlock Text="Condition" Grid.Row="3" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                        <ComboBox ItemsSource="{Binding ConditionOptions}" 
                                  SelectedItem="{Binding Device.Condition}" 
                                  Grid.Row="3" Grid.Column="1" 
                                  Style="{StaticResource NeonComboBoxStyle}" Margin="0,4"/>

                        <!-- Holder ID -->
                        <TextBlock Text="Holder ID" Grid.Row="4" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                        <TextBox Text="{Binding Device.HolderID}" Grid.Row="4" Grid.Column="1" Style="{StaticResource NeonTextBoxStyle}" Margin="0,4"/>

                        <!-- Price -->
                        <TextBlock Text="Price" Grid.Row="5" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                        <TextBox Text="{Binding Device.Price}" Grid.Row="5" Grid.Column="1" Style="{StaticResource NeonTextBoxStyle}" Margin="0,4"/>

                        <!-- Notes -->
                        <TextBlock Text="Notes" Grid.Row="6" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                        <TextBox Text="{Binding Device.Notes}" Grid.Row="6" Grid.Column="1" AcceptsReturn="True" Height="80" Style="{StaticResource NeonTextBoxStyle}" Margin="0,4"/>

                        <!-- Added At -->
                        <TextBlock Text="Added At" Grid.Row="7" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                        <TextBox Text="{Binding Device.AddedAt}" Grid.Row="7" Grid.Column="1" Style="{StaticResource NeonTextBoxStyle}" IsReadOnly="True" Margin="0,4"/>
                    </Grid>

                    <!-- ===================== BUTTON BAR ===================== -->
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0">

                        <!-- Cancel -->
                        <Button Width="120"
                                Style="{StaticResource GradientBorderButtonStyleRed}"
                                Command="{Binding CancelCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource DeleteClose}" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Cancel"/>
                            </StackPanel>
                        </Button>

                        <!-- Save -->
                        <Button Width="120"
                                Style="{StaticResource GradientBorderButtonStyleGreen}"
                                Command="{Binding SaveCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource Save}" Width="20" Height="20" Margin="0,0,8,0"/>
                                <TextBlock Text="Save"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
