<UserControl x:Class="ESCenter.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ESCenter.ViewModels"
             Height="Auto"
             Width="Auto">

    <UserControl.DataContext>
        <vm:InventoryViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>

        <!-- ── Qty badge: colour by stock level ── -->
        <Style x:Key="QtyBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius"   Value="4"/>
            <Setter Property="Padding"        Value="8,2"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
        </Style>

        <!-- ── Pill badge (Condition / Quality) ── -->
        <Style x:Key="PillBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- ── Subtle accent chip for Type column ── -->
        <Style x:Key="TypeChipBorder" TargetType="Border">
            <Setter Property="Background"   Value="#1A237EF2"/>
            <Setter Property="BorderBrush"  Value="#30237EF2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding"      Value="8,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
        </Style>

        <Style x:Key="TypeChipText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5AA7FF"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- toolbar -->
            <RowDefinition Height="*"/>
            <!-- grid -->
            <RowDefinition Height="Auto"/>
            <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════ TOOLBAR ══════════════════════════════════════ -->
        <Border Grid.Row="0"
                Margin="0,0,0,10"
                CornerRadius="10"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="1">

            <!-- Gradient accent strip on left edge -->
            <Border.Effect>
                <DropShadowEffect Color="#00E5D4" BlurRadius="18" ShadowDepth="0" Opacity="0.08"/>
            </Border.Effect>

            <Grid>
                <!-- Left glow accent bar -->
                <Border Width="4"
                        CornerRadius="10,0,0,10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00E5D4" Offset="0"/>
                            <GradientStop Color="#237EF2" Offset="0.5"/>
                            <GradientStop Color="#2952D9" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <DockPanel LastChildFill="False" Margin="16,10,12,10">

                    <!-- ── Title block ── -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Left"
                                Margin="0,0,20,0">
                        <Image Source="{StaticResource Inventory}"
                               Width="26" Height="26"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Inventory"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Gradient.Primary.Horizontal}"
                                       Margin="0,0,0,1"/>
                            <TextBlock Text="{Binding Items.Count, StringFormat='{}{0} items'}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ── Separator ── -->
                    <Separator DockPanel.Dock="Left"
                               Style="{x:Null}"
                               Width="1"
                               Background="{StaticResource BorderDarkBrush}"
                               Margin="0,4,16,4"/>

                    <!-- ── Search + Filter ── -->
                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Left"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0">

                        <!-- Search box -->
                        <Border CornerRadius="7"
                                BorderBrush="{StaticResource BorderDarkBrush}"
                                BorderThickness="1"
                                Background="{StaticResource CardBackgroundBrush}"
                                Width="240"
                                Height="32"
                                Margin="0,0,10,0">
                            <Border.Effect>
                                <DropShadowEffect Color="#237EF2" BlurRadius="0"
                                                  ShadowDepth="0" Opacity="0"/>
                            </Border.Effect>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText.Length}" Value="0">
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0"
                                       Source="{StaticResource AISearch}"
                                       Width="16" Height="16"
                                       Margin="10,0,6,0"
                                       VerticalAlignment="Center"
                                       Opacity="0.55"/>
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource GradiantTextboxStyle1}"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="0"/>
                                <Button Grid.Column="2"
                                        Width="24" Height="24"
                                        Margin="4,0,4,0"
                                        Padding="0"
                                        Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding ClearSearchCommand}"
                                        ToolTip="Clear search"
                                        Opacity="0.7">
                                    <Image Source="{StaticResource Clear}" Width="14" Height="14"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Type label + filter -->
                        <TextBlock Text="Type:"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Margin="0,0,6,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ComboBox Width="160"
                                  Style="{StaticResource GradiantComboboxStyle11}"
                                  ItemsSource="{Binding PartTypes}"
                                  SelectedItem="{Binding SelectedTypeFilter}"/>
                    </StackPanel>

                    <!-- ── Action buttons (right) ── -->
                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,0,0">

                        <Button Width="88" Height="32"
                                Margin="0,0,8,0"
                                Style="{StaticResource GradientBorderButtonStyleGreen}"
                                Command="{Binding AddCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource Add}" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Add" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <Button Width="88" Height="32"
                                Margin="0,0,8,0"
                                Style="{StaticResource GradientBorderButtonStyleBLueCyan}"
                                Command="{Binding EditCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource EditAI}" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Edit" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <Button Width="88" Height="32"
                                Style="{StaticResource GradientBorderButtonStyleRed}"
                                Command="{Binding RemoveCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource DeleteClose}" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Remove" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </DockPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════ DATA GRID ══════════════════════════════════════ -->
        <Border Grid.Row="1"
                CornerRadius="10"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="1"
                ClipToBounds="True">

            <DataGrid ItemsSource="{Binding InventoryView}"
                      AutoGenerateColumns="False"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      Style="{StaticResource DarkDataGridStyle}"
                      RowStyle="{StaticResource CompactDataGridRowStyle}"
                      CellStyle="{StaticResource CompactDataGridCellStyle}"
                      ColumnHeaderStyle="{StaticResource CompactDataGridHeaderStyle}">

                <DataGrid.Columns>

                    <!-- Type — accent chip -->
                    <DataGridTemplateColumn Header="Type" Width="130" SortMemberPath="ItemType">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TypeChipBorder}">
                                    <TextBlock Text="{Binding ItemType}" Style="{StaticResource TypeChipText}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Brand -->
                    <DataGridTextColumn Header="Brand"         Binding="{Binding Brand}"         Width="120"/>

                    <!-- Model -->
                    <DataGridTextColumn Header="Model"         Binding="{Binding Model}"         Width="150"/>

                    <!-- Variant -->
                    <DataGridTextColumn Header="Variant"       Binding="{Binding Variant}"       Width="110"/>

                    <!-- Compatibility -->
                    <DataGridTextColumn Header="Compatibility" Binding="{Binding Compatibility}" Width="190"/>

                    <!-- Specs -->
                    <DataGridTextColumn Header="Specs"         Binding="{Binding Specs}"         Width="110"/>

                    <!-- Size -->
                    <DataGridTextColumn Header="Size"          Binding="{Binding Size}"          Width="90"/>

                    <!-- Qty — colour-coded badge -->
                    <DataGridTemplateColumn Header="Qty" Width="70" SortMemberPath="QuantityOnHand">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        CornerRadius="5"
                                        Padding="10,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1A22C55E"/>
                                            <!-- green default -->
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding QuantityOnHand}" Value="0">
                                                    <Setter Property="Background" Value="#2AEF4444"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding QuantityOnHand}" Value="1">
                                                    <Setter Property="Background" Value="#2AF97316"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding QuantityOnHand}" Value="2">
                                                    <Setter Property="Background" Value="#2AFBBF24"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding QuantityOnHand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#22C55E"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding QuantityOnHand}" Value="0">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding QuantityOnHand}" Value="1">
                                                        <Setter Property="Foreground" Value="#F97316"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding QuantityOnHand}" Value="2">
                                                        <Setter Property="Foreground" Value="#FBBF24"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Price -->
                    <DataGridTemplateColumn Header="Price" Width="90" SortMemberPath="Price">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Price, StringFormat={}${0:F2}}"
                                           Foreground="{StaticResource Gradient.Primary}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,6,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Condition — coloured pill -->
                    <DataGridTemplateColumn Header="Condition" Width="100" SortMemberPath="Condition">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        CornerRadius="10"
                                        Padding="10,3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1A5AA7FF"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Condition}" Value="New">
                                                    <Setter Property="Background" Value="#1A22C55E"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Condition}" Value="Used">
                                                    <Setter Property="Background" Value="#1A5AA7FF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Condition}" Value="Faulty">
                                                    <Setter Property="Background" Value="#1AEF4444"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Condition}"
                                               FontSize="11" FontWeight="SemiBold"
                                               HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#5AA7FF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Condition}" Value="New">
                                                        <Setter Property="Foreground" Value="#22C55E"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Condition}" Value="Faulty">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Quality Grade -->
                    <DataGridTemplateColumn Header="Quality" Width="80" SortMemberPath="QualityGrade">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding QualityGrade}"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding QualityGrade}" Value="A">
                                                    <Setter Property="Foreground" Value="#22C55E"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding QualityGrade}" Value="B">
                                                    <Setter Property="Foreground" Value="#5AA7FF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding QualityGrade}" Value="C">
                                                    <Setter Property="Foreground" Value="#FBBF24"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding QualityGrade}" Value="D">
                                                    <Setter Property="Foreground" Value="#F97316"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding QualityGrade}" Value="F">
                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Source -->
                    <DataGridTextColumn Header="Source"      Binding="{Binding Source}"      Width="120"/>

                    <!-- Box / Location -->
                    <DataGridTemplateColumn Header="Box" Width="90" SortMemberPath="LocationBox">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#14FFFFFF"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LocationBox}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Description -->
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="200"/>

                    <!-- Notes -->
                    <DataGridTextColumn Header="Notes"       Binding="{Binding Notes}"       Width="180"/>

                    <!-- Tags -->
                    <DataGridTextColumn Header="Tags"        Binding="{Binding Tags}"        Width="140"/>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ══════════════════════════════════════ STATUS BAR ══════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="0,8,0,0">

            <!-- Top accent line -->
            <Border Height="1"
                    VerticalAlignment="Top"
                    Margin="0,0,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#0000E5D4" Offset="0"/>
                        <GradientStop Color="#3000E5D4" Offset="0.3"/>
                        <GradientStop Color="#30237EF2" Offset="0.7"/>
                        <GradientStop Color="#00237EF2" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <DockPanel Margin="4,4,4,0">
                <!-- Item count chip -->
                <Border DockPanel.Dock="Left"
                        Background="#14237EF2"
                        BorderBrush="#25237EF2"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Items: "
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"/>
                        <TextBlock Text="{Binding Items.Count}"
                                   Foreground="#5AA7FF"
                                   FontWeight="SemiBold"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Spacer -->
                <TextBlock DockPanel.Dock="Right"
                           Text=""
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Right"/>
            </DockPanel>
        </Grid>

    </Grid>
</UserControl>
