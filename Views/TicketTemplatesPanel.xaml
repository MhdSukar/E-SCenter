<UserControl x:Class="ESCenter.Views.TicketTemplatesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <GroupBox Style="{StaticResource GradientGroupBoxBlueCyan}"
              Margin="0,12,0,0">
        <GroupBox.Header>
            <StackPanel Orientation="Horizontal">
                <Image Source="{StaticResource Tickets}"
                       Width="14"
                       Height="14"
                       Margin="0,0,6,0" />
                <TextBlock Text="Ticket Templates"
                           Foreground="{StaticResource Gradient.Primary.Horizontal}" />
            </StackPanel>
        </GroupBox.Header>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ComboBox Grid.Row="0"
                      Height="28"
                      ItemsSource="{Binding Templates}"
                      SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                      DisplayMemberPath="Name"
                      Style="{StaticResource GradiantComboboxStyle11}" />

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Right">
                <Button Width="80"
                        Command="{Binding LoadTemplateCommand}"
                        Style="{StaticResource GradientBorderButtonStyleGreen}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource Add}"
                               Width="16"
                               Height="16"
                               Margin="0,0,6,0" />
                        <TextBlock Text="Load" />
                    </StackPanel>
                </Button>

                <Button Width="110"
                        Margin="6,0,0,0"
                        Command="{Binding SaveAsTemplateCommand}"
                        Style="{StaticResource GradientBorderButtonStyleBLueCyan}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource Save}"
                               Width="16"
                               Height="16"
                               Margin="0,0,6,0" />
                        <TextBlock Text="Save Current" />
                    </StackPanel>
                </Button>

                <Button Width="80"
                        Margin="6,0,0,0"
                        Command="{Binding DeleteTemplateCommand}"
                        Style="{StaticResource GradientBorderButtonStyleRed}"
                        IsEnabled="{Binding SelectedTemplate, Converter={StaticResource NullToBooleanConverter}, ConverterParameter=Invert=true}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource DeleteClose}"
                               Width="16"
                               Height="16"
                               Margin="0,0,6,0" />
                        <TextBlock Text="Delete" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </GroupBox>
</UserControl>
