<Window x:Class="ESCenter.Views.AddEditPartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add/Edit Part"
        Width="400"
        Height="560"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">


    <Window.Resources>
        <!-- ================= TITLE BAR BUTTON BASE ================= -->
        <Style x:Key="TitleBarButtonBase" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= CLOSE BUTTON ================= -->
        <Style x:Key="TitleBarCloseButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TitleBarButtonBase}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0,8,0,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E81123"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#C50F1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ===================== WINDOW SHELL ===================== -->
    <Border CornerRadius="12"
            Background="{StaticResource AppBackgroundBrushNew}"
            BorderBrush="{StaticResource DarkBorderBrush}"
            BorderThickness="0"
            SnapsToDevicePixels="True">

        <Grid>

            <!-- ===================== CUSTOM TITLE BAR ===================== -->
            <Border Height="36"
                    Background="{StaticResource DarkCardBrush}"
                    CornerRadius="12,12,0,0"
                    BorderBrush="{StaticResource DarkBorderBrush}"
                    BorderThickness="0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    VerticalAlignment="Top">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Icon -->
                    <Image Grid.Column="0"
                           Source="Z:\C#\Projects\E-SCenter\E-SCenter\Themes\E-SCenter.png"
                           Width="18"
                           Height="18"
                           Margin="10,0,6,0"
                           VerticalAlignment="Center"/>

                    <!-- Title -->
                    <TextBlock Grid.Column="1"
                               Text="Parts"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>

                    <!-- Window Buttons -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal">

                        <Button Style="{StaticResource TitleBarButtonBase}"
                                Content="—"
                                Click="btnMinimize_Click"
                                x:Name="btnMinimize"/>

                        <Button Style="{StaticResource TitleBarButtonBase}"
                                Content="□"
                                FontSize="17"
                                x:Name="btnMaximize"
                                Click="btnMaximize_Click"/>

                        <Button Style="{StaticResource TitleBarCloseButtonStyle}"
                                Content="✕"
                                Click="btnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================== MAIN CONTENT ===================== -->
            <Border Margin="0,36,0,0"
                    Padding="12"
                    CornerRadius="0,0,10,10"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ===================== FORM ===================== -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Part Code -->
                        <TextBlock Text="Part Code" Grid.Row="0" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                        <TextBox Text="{Binding Part.PartCode}" Grid.Row="0" Grid.Column="1" Style="{StaticResource NeonTextBoxStyle}" Margin="0,4"/>

                        <!-- Type -->
                        <TextBlock Text="Type" Grid.Row="1" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                        <ComboBox ItemsSource="{Binding PartTypes}"
                                  SelectedItem="{Binding Part.PartType}"
                                  Grid.Row="1" Grid.Column="1"
                                  Style="{StaticResource NeonComboBoxStyle}" Margin="0,4"/>

                        <!-- Quantity -->
                        <TextBlock Text="Quantity" Grid.Row="2" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                        <TextBox Text="{Binding Part.QuantityOnHand}" Grid.Row="2" Grid.Column="1" Style="{StaticResource NeonTextBoxStyle}" Margin="0,4"/>

                        <!-- Price -->
                        <TextBlock Text="Price" Grid.Row="3" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                        <TextBox Text="{Binding Part.Price}" Grid.Row="3" Grid.Column="1" Style="{StaticResource NeonTextBoxStyle}" Margin="0,4"/>

                        <!-- Quality -->
                        <TextBlock Text="Quality" Grid.Row="4" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                        <ComboBox ItemsSource="{Binding QualityOptions}"
                                  SelectedItem="{Binding SelectedQuality}"
                                  Grid.Row="4" Grid.Column="1"
                                  Style="{StaticResource NeonComboBoxStyle}" Margin="0,4"/>

                        <!-- Shelf -->
                        <TextBlock Text="Shelf" Grid.Row="5" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                        <TextBox Text="{Binding Part.LocationShelf}" Grid.Row="5" Grid.Column="1" Style="{StaticResource NeonTextBoxStyle}" Margin="0,4"/>

                        <!-- Bin -->
                        <TextBlock Text="Bin" Grid.Row="6" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                        <TextBox Text="{Binding Part.LocationBin}" Grid.Row="6" Grid.Column="1" Style="{StaticResource NeonTextBoxStyle}" Margin="0,4"/>

                        <!-- Unit 1 -->
                        <TextBlock Text="Unit 1 Value" Grid.Row="7" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                        <StackPanel Orientation="Horizontal" Grid.Row="7" Grid.Column="1">
                            <TextBox Width="80" Text="{Binding Part.UnitValue1}" Style="{StaticResource NeonTextBoxStyle}" Margin="0,4"/>
                            <ComboBox Width="80" Margin="10,0,0,0" ItemsSource="{Binding Unit1Options}" SelectedItem="{Binding Part.UnitCode1}" Style="{StaticResource NeonComboBoxStyle}"/>
                        </StackPanel>

                        <!-- Unit 2 -->
                        <TextBlock Text="Unit 2 Value" Grid.Row="8" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                        <StackPanel Orientation="Horizontal" Grid.Row="8" Grid.Column="1">
                            <TextBox Width="80" Text="{Binding Part.UnitValue2}" Style="{StaticResource NeonTextBoxStyle}" Margin="0,4"/>
                            <ComboBox Width="80" Margin="10,0,0,0" ItemsSource="{Binding Unit2Options}" SelectedItem="{Binding Part.UnitCode2}" Style="{StaticResource NeonComboBoxStyle}"/>
                        </StackPanel>

                        <!-- Chip PN -->
                        <TextBlock Text="Chip PN" Grid.Row="9" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                        <TextBox Text="{Binding Part.ChipPartNumber}" Grid.Row="9" Grid.Column="1" Style="{StaticResource NeonTextBoxStyle}" Margin="0,4"/>

                        <!-- Category -->
                        <TextBlock Text="Category" Grid.Row="10" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                        <ComboBox ItemsSource="{Binding CategoryOptions}"
                                  SelectedItem="{Binding Part.Category}"
                                  Grid.Row="10" Grid.Column="1"
                                  Style="{StaticResource NeonComboBoxStyle}" Margin="0,4"/>
                    </Grid>

                    <!-- ===================== BUTTON BAR ===================== -->
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0">

                        <!-- Cancel -->
                        <Button Width="120"
                                Style="{StaticResource NeonBorderButtonStyle}"
                                Command="{Binding CancelCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source ="{StaticResource cancel}"
                                       Width="16"
                                       Height="16"
                                       Margin="0,0,8,0"/>
                                <TextBlock Text="Cancel"/>
                            </StackPanel>
                        </Button>

                        <!-- Save -->
                        <Button Width="120"
                                Style="{StaticResource NeonGreenButtonStyle}"
                                Command="{Binding SaveCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source ="{StaticResource save}"
                                       Width="16"
                                       Height="16"
                                       Margin="0,0,8,0"/>
                                <TextBlock Text="Save"/>

                            </StackPanel>
                        </Button>

                    </StackPanel>

                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
