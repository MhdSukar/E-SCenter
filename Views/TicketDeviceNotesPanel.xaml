<UserControl x:Class="ESCenter.Views.TicketDeviceNotesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>

        <Style x:Key="SectionLine" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,14,0,8"/>
            <Setter Property="Background" Value="{StaticResource BorderDarkBrush}"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource SectionLine}"/>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="📋 NOTES" Style="{StaticResource SectionHeader}" Margin="0,14,0,6"/>

        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Top">
            <Image Source="{StaticResource Notes}" Width="13" Height="13" Margin="0,0,5,0"/>
            <TextBlock Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Top"
                       TextWrapping="Wrap" Width="110" Height="55">Notes: ( Passwords, Diagnoses, Email )</TextBlock>
        </StackPanel>
        <TextBox Grid.Row="1" Grid.Column="1"
                 Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Margin="4,0,0,8" Height="55" TextWrapping="Wrap" AcceptsReturn="True"
                 Style="{StaticResource GradiantTextboxStyle1}" TabIndex="10"/>

        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Top">
            <Image Source="{StaticResource BoardMod}" Width="13" Height="13" Margin="0,0,5,0"/>
            <TextBlock Text="Board Mods:" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Top"/>
        </StackPanel>
        <TextBox Grid.Row="2" Grid.Column="1"
                 Text="{Binding BoardModifications, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Margin="4,0,0,8" Height="55" TextWrapping="Wrap" AcceptsReturn="True"
                 Style="{StaticResource GradiantTextboxStyle1}"/>

    </Grid>
</UserControl>
