<UserControl x:Class="ESCenter.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ESCenter.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CustomersViewModel, IsDesignTimeCreatable=True}">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="0"
                Margin="0,0,10,0"
                ClipToBounds="True">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Padding="12,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{StaticResource BorderDarkBrush}">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{StaticResource AddressBook}" Width="26" Height="26" Margin="0,0,8,0"/>
                            <TextBlock Text="Customers"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Gradient.Primary.Horizontal}"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border CornerRadius="7"
                                    BorderBrush="{StaticResource BorderDarkBrush}"
                                    BorderThickness="1"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    Width="220"
                                    Height="32"
                                    Margin="0,0,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0"
                                           Source="{StaticResource AISearch}"
                                           Width="16"
                                           Height="16"
                                           Margin="10,0,6,0"
                                           VerticalAlignment="Center"
                                           Opacity="0.55"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource GradiantTextboxStyle1}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="0"/>
                                    <Button Grid.Column="2"
                                            Width="24"
                                            Height="24"
                                            Margin="4,0,4,0"
                                            Padding="0"
                                            Style="{StaticResource IconButtonStyle}"
                                            Command="{Binding ClearSearchCommand}">
                                        <Image Source="{StaticResource Clear}" Width="14" Height="14"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <Button Content="Add"
                                    Width="80"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource GradientBorderButtonStyleGreen}"
                                    Command="{Binding AddCommand}"/>
                            <Button Content="Delete"
                                    Width="80"
                                    Style="{StaticResource GradientBorderButtonStyleRed}"
                                    Command="{Binding DeleteCommand}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <DataGrid ItemsSource="{Binding Customers}"
                          SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Style="{StaticResource DarkDataGridStyle}"
                          RowStyle="{StaticResource CompactDataGridRowStyle}"
                          CellStyle="{StaticResource CompactDataGridCellStyle}"
                          ColumnHeaderStyle="{StaticResource CompactDataGridHeaderStyle}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="ID" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#1A237EF2" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CustomerId}" Foreground="#5AA7FF" FontFamily="Consolas" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Name" Width="*" Binding="{Binding FullName}"/>
                        <DataGridTextColumn Header="Phone" Width="130" Binding="{Binding PhoneNumber}"/>
                        <DataGridTextColumn Header="Email" Width="150" Binding="{Binding Email}"/>
                        <DataGridTextColumn Header="Notes" Width="200" Binding="{Binding Notes}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Customer Details" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <Border Height="2" Background="{StaticResource Gradient.Primary.Horizontal}" Margin="0,4,0,14"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
                    <Button Width="100" Command="{Binding SaveCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GradientBorderButtonStyleBLueCyan}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFormDirty}" Value="True">
                                        <Setter Property="BorderBrush" Value="#FF8C42"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Save"/>
                    </Button>

                    <Button Content="Clear"
                            Width="80"
                            Margin="6,0,0,0"
                            Command="{Binding ClearCommand}"
                            Style="{StaticResource GradientBorderButtonStyleYellow}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Full Name *" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                        <TextBox x:Name="FullNameBox" Grid.Row="0" Grid.Column="1"
                                 Text="{Binding FormFullName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8" TabIndex="1" Style="{StaticResource GradiantTextboxStyle1}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Phone Number" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding FormPhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8" TabIndex="2" Style="{StaticResource GradiantTextboxStyle1}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Email" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8" TabIndex="3" Style="{StaticResource GradiantTextboxStyle1}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Address" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Height="55"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Margin="0,0,0,8"
                                 TabIndex="4"
                                 Style="{StaticResource GradiantTextboxStyle1}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Notes" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="4" Grid.Column="1"
                                 Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}"
                                 Height="80"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Margin="0,0,0,8"
                                 TabIndex="5"
                                 Style="{StaticResource GradiantTextboxStyle1}"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
