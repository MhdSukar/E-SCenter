<Window x:Class="ESCenter.Views.AddEditInventoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory Item"
        Width="560"
        Height="700"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">

    <Window.Resources>

        <!-- ================= TITLE BAR BUTTON BASE ================= -->
        <Style x:Key="TitleBarButtonBase" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= CLOSE BUTTON ================= -->
        <Style x:Key="TitleBarCloseButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TitleBarButtonBase}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0,8,0,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E81123"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#C50F1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ===================== WINDOW SHELL ===================== -->
    <Border CornerRadius="12"
            Background="{StaticResource AppBackgroundBrushNew}"
            BorderBrush="{StaticResource DarkBorderBrush}"
            BorderThickness="0"
            SnapsToDevicePixels="True">

        <Grid>

            <!-- ===================== CUSTOM TITLE BAR ===================== -->
            <Border Height="36"
                    Background="{StaticResource DarkCardBrush}"
                    CornerRadius="12,12,0,0"
                    BorderBrush="{StaticResource DarkBorderBrush}"
                    BorderThickness="0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    VerticalAlignment="Top">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Icon -->
                    <Image Grid.Column="0"
                           Source="/Assets/Icons/Philips E-SCenter Logo.png"
                           Width="18"
                           Height="18"
                           Margin="10,0,6,0"
                           VerticalAlignment="Center"/>

                    <!-- Title -->
                    <TextBlock Grid.Column="1"
                               Text="Inventory Item"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>

                    <!-- Window Buttons -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal">

                        <Button Style="{StaticResource TitleBarButtonBase}"
                                Click="btnMinimize_Click"
                                x:Name="btnMinimize">
                            <Image Source="{StaticResource Minimize}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>

                        <Button Style="{StaticResource TitleBarButtonBase}"
                                FontSize="17"
                                x:Name="btnMaximize"
                                Click="btnMaximize_Click">
                            <Image Source="{StaticResource Maximize}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>

                        <Button Style="{StaticResource TitleBarCloseButtonStyle}"
                                Click="btnClose_Click">
                            <Image Source="{StaticResource Close}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================== MAIN CONTENT ===================== -->
            <Border Margin="0,36,0,0"
                    Padding="16"
                    CornerRadius="0,0,10,10"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ===================== HEADER ===================== -->
                    <TextBlock Text="Inventory Item"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,12"/>

                    <!-- ===================== FORM ===================== -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="0,0,6,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="65"/>
                                <RowDefinition Height="85"/>
                                <RowDefinition Height="90"/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>

                            <!-- ================= ITEM TYPE ================= -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Item Type"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                <ComboBox Width="115"
                                          Style="{StaticResource GradiantComboboxStyle11}"
                                          ItemsSource="{Binding ItemTypes}"
                                          SelectedItem="{Binding Item.ItemType}"/>
                                <Button MinWidth="10" Width="25"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Content="+"
                                        Command="{Binding AddNewTypeCommand}"/>
                            </StackPanel>

                            <!-- ================= BRAND ================= -->
                            <TextBlock Grid.Row="0" Grid.Column="2"
                                       Text="Brand"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                            <TextBox Grid.Row="0" Grid.Column="3"
                                     Style="{StaticResource GradiantTextboxStyle1}"
                                     Text="{Binding Item.Brand}"/>

                            <!-- ================= MODEL ================= -->
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="Model"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Style="{StaticResource GradiantTextboxStyle1}"
                                     Text="{Binding Item.Model}"/>

                            <!-- ================= VARIANT ================= -->
                            <TextBlock Grid.Row="1" Grid.Column="2"
                                       Text="Variant"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                            <TextBox Grid.Row="1" Grid.Column="3"
                                     Style="{StaticResource GradiantTextboxStyle1}"
                                     Text="{Binding Item.Variant}"/>

                            <!-- ================= COMPATIBILITY ================= -->
                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="Compatibility"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Grid.ColumnSpan="3"
                                     Style="{StaticResource GradiantTextboxStyle1}"
                                     Text="{Binding Item.Compatibility}"/>

                            <!-- ================= SPECS ================= -->
                            <TextBlock Grid.Row="3" Grid.Column="0"
                                       Text="Specs"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                            <TextBox Grid.Row="3" Grid.Column="1"
                                     Style="{StaticResource GradiantTextboxStyle1}"
                                     Text="{Binding Item.Specs}"/>

                            <!-- ================= SIZE ================= -->
                            <TextBlock Grid.Row="3" Grid.Column="2"
                                       Text="Size"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                            <TextBox Grid.Row="3" Grid.Column="3"
                                     Style="{StaticResource GradiantTextboxStyle1}"
                                     Text="{Binding Item.Size}"/>

                            <!-- ================= QUANTITY ================= -->
                            <TextBlock Grid.Row="4" Grid.Column="0"
                                       Text="Quantity"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                            <TextBox Grid.Row="4" Grid.Column="1"
                                     Style="{StaticResource GradiantTextboxStyle1}"
                                     Text="{Binding Item.QuantityOnHand}"/>

                            <!-- ================= PRICE ================= -->
                            <TextBlock Grid.Row="4" Grid.Column="2"
                                       Text="Price"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                            <StackPanel Grid.Row="4" Grid.Column="3" Orientation="Horizontal">
                                <TextBox Width="75"
                                         Style="{StaticResource GradiantTextboxStyle1}"
                                         Text="{Binding Item.Price}"/>
                                <ComboBox Width="69"
                                          Margin="6,0,0,0"
                                          Style="{StaticResource GradiantComboboxStyle11}"
                                          ItemsSource="{Binding Currencies}"
                                          SelectedItem="{Binding Item.PriceCurrency}"/>
                            </StackPanel>

                            <!-- ================= CONDITION ================= -->
                            <TextBlock Grid.Row="5" Grid.Column="0"
                                       Text="Condition"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                            <ComboBox Grid.Row="5" Grid.Column="1"
                                      Style="{StaticResource GradiantComboboxStyle11}"
                                      ItemsSource="{Binding Conditions}"
                                      SelectedItem="{Binding Item.Condition}"/>

                            <!-- ================= QUALITY ================= -->
                            <TextBlock Grid.Row="5" Grid.Column="2"
                                       Text="Quality"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                            <ComboBox Grid.Row="5" Grid.Column="3"
                                      Style="{StaticResource GradiantComboboxStyle11}"
                                      ItemsSource="{Binding QualityGrades}"
                                      SelectedItem="{Binding Item.QualityGrade}"/>

                            <!-- ================= SOURCE ================= -->
                            <TextBlock Grid.Row="6" Grid.Column="0"
                                       Text="Source"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                            <TextBox Grid.Row="6" Grid.Column="1"
                                     Style="{StaticResource GradiantTextboxStyle1}"
                                     Text="{Binding Item.Source}"/>

                            <!-- ================= LOCATION BOX ================= -->
                            <TextBlock Grid.Row="6" Grid.Column="2"
                                       Text="Box"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                            <TextBox Grid.Row="6" Grid.Column="3"
                                     Style="{StaticResource GradiantTextboxStyle1}"
                                     Text="{Binding Item.LocationBox}"/>

                            <!-- ================= DESCRIPTION ================= -->
                            <TextBlock Grid.Row="7" Grid.Column="0"
                                       Text="Description"
                                       Padding="0,6,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                            <TextBox Grid.Row="7" Grid.Column="1"
                                     Grid.ColumnSpan="3"
                                     Height="60"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Style="{StaticResource GradiantTextboxStyle1}"
                                     Text="{Binding Item.Description}"/>

                            <!-- ================= NOTES ================= -->
                            <TextBlock Grid.Row="8" Grid.Column="0"
                                       Text="Notes"
                                       Padding="0,6,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                            <TextBox Grid.Row="8" Grid.Column="1"
                                     Grid.ColumnSpan="3"
                                     Height="80"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Style="{StaticResource GradiantTextboxStyle1}"
                                     Text="{Binding Item.Notes}"/>

                            <!-- ================= TAGS ================= -->
                            <TextBlock Grid.Row="9" Grid.Column="0"
                                       Text="Tags"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                            <TextBox Grid.Row="9" Grid.Column="1"
                                     Grid.ColumnSpan="3"
                                     Style="{StaticResource GradiantTextboxStyle1}"
                                     Text="{Binding Item.Tags}"/>

                        </Grid>
                    </ScrollViewer>

                    <!-- ===================== BUTTON BAR ===================== -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0">

                       

                        <!-- CANCEL -->
                        <Button Width="120"
                                Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding CancelCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource DeleteClose}" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Cancel"/>
                            </StackPanel>
                        </Button>

                        <!-- SAVE -->
                        <Button Width="120"
                                 Margin="5,0,8,0"
                                 Style="{StaticResource PrimaryFilledButtonStyle}"
                                 Command="{Binding SaveCommand}"
                                
                                 CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource Save}" Width="20" Height="20" Margin="0,0,6,0"/>
                                <TextBlock Text="Save"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
