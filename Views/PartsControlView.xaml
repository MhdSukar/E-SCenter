<UserControl x:Class="ESCenter.Views.PartsControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ESCenter.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:ESCenter.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PartsControlViewModel, IsDesignTimeCreatable=True}"
             Height="Auto"
             Width="Auto">


    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- toolbar -->
            <RowDefinition Height="*"/>
            <!-- grid    -->
            <RowDefinition Height="Auto"/>
            <!-- status  -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════ TOOLBAR ══════════════════════════════════════ -->
        <Border Grid.Row="0"
                Margin="0,0,0,10"
                CornerRadius="10"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#00E5D4" BlurRadius="18" ShadowDepth="0" Opacity="0.08"/>
            </Border.Effect>

            <Grid>
                <!-- Left gradient accent bar -->
                <Border Width="4"
                        CornerRadius="10,0,0,10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00E5D4" Offset="0"/>
                            <GradientStop Color="#237EF2" Offset="0.5"/>
                            <GradientStop Color="#2952D9" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <DockPanel LastChildFill="False" Margin="16,10,12,10">

                    <!-- ── Title block ── -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Left"
                                Margin="0,0,16,0">
                        <Image Source="{StaticResource Parts}"
                               Width="26" Height="26"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Parts Control"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Gradient.Primary.Horizontal}"
                                       Margin="0,0,0,1"/>
                            <TextBlock Text="{Binding PartsCountDisplay}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Separator -->
                    <Separator DockPanel.Dock="Left"
                               Style="{x:Null}"
                               Width="1"
                               Background="{StaticResource BorderDarkBrush}"
                               Margin="0,4,16,4"/>

                    <!-- ── Search + Type filter ── -->
                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Left"
                                VerticalAlignment="Center"
                                Margin="0,0,16,0">

                        <!-- Search box -->
                        <Border CornerRadius="7"
                                BorderBrush="{StaticResource BorderDarkBrush}"
                                BorderThickness="1"
                                Background="{StaticResource CardBackgroundBrush}"
                                Width="230"
                                Height="32"
                                Margin="0,0,10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0"
                                       Source="{StaticResource AISearch}"
                                       Width="16" Height="16"
                                       Margin="10,0,6,0"
                                       VerticalAlignment="Center"
                                       Opacity="0.55"/>
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource GradiantTextboxStyle1}"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="0"/>
                                <Button Grid.Column="2"
                                        Width="24" Height="24"
                                        Margin="4,0,4,0"
                                        Padding="0"
                                        Opacity="0.7"
                                        Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding ClearSearchCommand}"
                                        ToolTip="Clear search">
                                    <Image Source="{StaticResource Clear}" Width="14" Height="14"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Part Type label + combo -->
                        <TextBlock Text="Type:"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Margin="0,0,6,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ComboBox Width="155"
                                  Height="32"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource GradiantComboboxStyle11}"
                                  ItemsSource="{Binding PartTypes}"
                                  SelectedItem="{Binding SelectedTypeFilter}"
                                  Margin="0,0,16,0"/>

                        <!-- ── Stock quick-filter pills ── -->
                        <Border Width="1"
                                Background="{StaticResource BorderDarkBrush}"
                                Margin="0,4,16,4"/>

                        <TextBlock Text="Stock:"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Margin="0,0,8,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <!-- All -->
                        <Button Height="28"
                                Margin="0,0,6,0"
                                Style="{StaticResource GradientBorderButtonStyleGreen}"
                                Command="{Binding FilterAllCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource AllList}"
                                       Width="14" Height="14" Margin="0,0,5,0"/>
                                <TextBlock Text="All" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <!-- Low -->
                        <Button Height="28"
                                Margin="0,0,6,0"
                                Style="{StaticResource GradientBorderButtonStyleYellow}"
                                Command="{Binding FilterLowCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource LowStock}"
                                       Width="14" Height="14" Margin="0,0,5,0"/>
                                <TextBlock Text="Low" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <!-- Out -->
                        <Button Height="28"
                                Style="{StaticResource GradientBorderButtonStyleRed}"
                                Command="{Binding FilterOutCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource OutStock}"
                                       Width="14" Height="14" Margin="0,0,5,0"/>
                                <TextBlock Text="Out" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- ── Action buttons (right) ── -->
                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Right"
                                VerticalAlignment="Center">

                        <Button Height="32"
                                Margin="0,0,8,0"
                                Style="{StaticResource GradientBorderButtonStyleRed}"
                                Command="{Binding ExportReorderListCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource LowStock}" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Reorder List" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <Button Width="98" Height="32"
                                Margin="0,0,8,0"
                                Style="{StaticResource GradientBorderButtonStyleAccent}"
                                Command="{Binding ExportPartsCsvCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource DBReport}" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Export CSV" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <Button Width="88" Height="32"
                                Margin="0,0,8,0"
                                Style="{StaticResource GradientBorderButtonStyleGreen}"
                                Command="{Binding AddPartCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource Add}" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Add" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <Button Width="88" Height="32"
                                Margin="0,0,8,0"
                                Style="{StaticResource GradientBorderButtonStyleBLueCyan}"
                                Command="{Binding EditPartCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource EditAI}" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Edit" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <Button Width="88" Height="32"
                                Style="{StaticResource GradientBorderButtonStyleRed}"
                                Command="{Binding RemovePartCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource DeleteClose}" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Remove" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </DockPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════ DATA GRID ══════════════════════════════════════ -->
        <Border Grid.Row="1"
                CornerRadius="10"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="1"
                ClipToBounds="True">

            <DataGrid ItemsSource="{Binding PartsView}"
                      AutoGenerateColumns="False"
                      SelectedItem="{Binding SelectedPart, Mode=TwoWay}"
                      Style="{StaticResource DarkDataGridStyle}"
                      RowStyle="{StaticResource TicketRowStyle}"
                      CellStyle="{StaticResource CompactDataGridCellStyle}"
                      ColumnHeaderStyle="{StaticResource CompactDataGridHeaderStyle}"
                      IsReadOnly="True">

                <DataGrid.Columns>

                    <!-- SKU — blue monospace chip -->
                    <DataGridTemplateColumn Header="SKU" Width="120" SortMemberPath="SKU">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SkuChipBorder}">
                                    <TextBlock Text="{Binding SKU}" Style="{StaticResource SkuChipText}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Part Code — secondary monospace chip -->
                    <DataGridTemplateColumn Header="Part Code" Width="190" SortMemberPath="PartCode">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PartCodeChipBorder}">
                                    <TextBlock Text="{Binding PartCode}" Style="{StaticResource PartCodeChipText}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Type — teal chip -->
                    <DataGridTemplateColumn Header="Type" Width="130" SortMemberPath="PartType">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TypeChipBorder}">
                                    <TextBlock Text="{Binding PartType}" Style="{StaticResource TypeChipText}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Stock Status — colour-coded pill -->
                    <DataGridTemplateColumn Header="Status" Width="90" SortMemberPath="StockStatus" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        CornerRadius="10"
                                        Padding="10,3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1A22C55E"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StockStatus}" Value="Low">
                                                    <Setter Property="Background" Value="#1AFBBF24"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StockStatus}" Value="Out">
                                                    <Setter Property="Background" Value="#2AEF4444"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StockStatus}" Value="Out of Stock">
                                                    <Setter Property="Background" Value="#2AEF4444"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StockStatus}" Value="Low Stock">
                                                    <Setter Property="Background" Value="#1AFBBF24"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StockStatus}"
                                               FontSize="11" FontWeight="SemiBold"
                                               HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#22C55E"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StockStatus}" Value="Low">
                                                        <Setter Property="Foreground" Value="#FBBF24"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StockStatus}" Value="Out">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StockStatus}" Value="Out of Stock">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StockStatus}" Value="Low Stock">
                                                        <Setter Property="Foreground" Value="#FBBF24"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Qty — colour-coded badge -->
                    <DataGridTemplateColumn Header="Qty" Width="70" SortMemberPath="QuantityOnHand">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        CornerRadius="5"
                                        Padding="10,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1A22C55E"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding QuantityOnHand}" Value="0">
                                                    <Setter Property="Background" Value="#2AEF4444"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding QuantityOnHand}" Value="1">
                                                    <Setter Property="Background" Value="#2AF97316"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding QuantityOnHand}" Value="2">
                                                    <Setter Property="Background" Value="#2AFBBF24"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding QuantityOnHand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#22C55E"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding QuantityOnHand}" Value="0">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding QuantityOnHand}" Value="1">
                                                        <Setter Property="Foreground" Value="#F97316"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding QuantityOnHand}" Value="2">
                                                        <Setter Property="Foreground" Value="#FBBF24"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Price — right-aligned gradient -->
                    <DataGridTemplateColumn Header="Price" Width="90" SortMemberPath="Price">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{StaticResource Gradient.Primary}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,6,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0:F2} {1}">
                                            <Binding Path="Price"/>
                                            <Binding Path="PriceCurrency"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Quality Grade — letter grade colours -->
                    <DataGridTemplateColumn Header="Quality" Width="70" SortMemberPath="QualityGrade">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding QualityGrade}"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding QualityGrade}" Value="A">
                                                    <Setter Property="Foreground" Value="#22C55E"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding QualityGrade}" Value="B">
                                                    <Setter Property="Foreground" Value="#5AA7FF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding QualityGrade}" Value="C">
                                                    <Setter Property="Foreground" Value="#FBBF24"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding QualityGrade}" Value="D">
                                                    <Setter Property="Foreground" Value="#F97316"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding QualityGrade}" Value="F">
                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Shelf + Bin — side-by-side monospace capsules in one cell -->
                    <DataGridTemplateColumn Header="Location" Width="130" SortMemberPath="LocationShelf">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <!-- Shelf -->
                                    <Border Background="#14FFFFFF"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            Margin="0,0,4,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="S:"
                                                       FontFamily="Consolas"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Opacity="0.6"/>
                                            <TextBlock Text="{Binding LocationShelf}"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Bin -->
                                    <Border Background="#14FFFFFF"
                                            CornerRadius="4"
                                            Padding="6,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="B:"
                                                       FontFamily="Consolas"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Opacity="0.6"/>
                                            <TextBlock Text="{Binding LocationBin}"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Unit 1 -->
                    <DataGridTextColumn Header="Unit 1"    Binding="{Binding Unit1Display}"    Width="120"/>

                    <!-- Unit 2 -->
                    <DataGridTextColumn Header="Unit 2"    Binding="{Binding Unit2Display}"    Width="120"/>

                    <!-- Chip Part Number — monospace secondary chip -->
                    <DataGridTemplateColumn Header="Chip PN" Width="145" SortMemberPath="ChipPartNumber">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PartCodeChipBorder}">
                                    <TextBlock Text="{Binding ChipPartNumber}" Style="{StaticResource PartCodeChipText}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Category — subtle accent chip -->
                    <DataGridTemplateColumn Header="Category" Width="125" SortMemberPath="Category">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#121A23F2"
                                        BorderBrush="#20237EF2"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="7,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Category}"
                                               Foreground="#8899BB"
                                               FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Description -->
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="250"/>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ══════════════════════════════════════ STATUS BAR ══════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="0,8,0,0">

            <!-- Gradient separator line -->
            <Border Height="1" VerticalAlignment="Top">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#0000E5D4" Offset="0"/>
                        <GradientStop Color="#3000E5D4" Offset="0.3"/>
                        <GradientStop Color="#30237EF2" Offset="0.7"/>
                        <GradientStop Color="#00237EF2" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <DockPanel Margin="4,5,4,0">

                <!-- Parts count chip -->
                <Border DockPanel.Dock="Left"
                        Background="#14237EF2"
                        BorderBrush="#25237EF2"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,3">
                    <TextBlock Text="{Binding PartsCountDisplay}"
                               Foreground="#5AA7FF"
                               FontWeight="SemiBold"
                               FontSize="11"/>
                </Border>

                <!-- Stock summary chips (right side) -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <!-- Low stock indicator -->
                    <Border Background="#12FBBF24"
                            BorderBrush="#20FBBF24"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,3"
                            Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#FBBF24"
                                     Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Low Stock"
                                       Foreground="#FBBF24"
                                       FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- Out of stock indicator -->
                    <Border Background="#12EF4444"
                            BorderBrush="#20EF4444"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,3">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#EF4444"
                                     Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Out of Stock"
                                       Foreground="#EF4444"
                                       FontSize="11"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <TextBlock Text="" Foreground="Transparent"/>
            </DockPanel>
        </Grid>

    </Grid>
</UserControl>
