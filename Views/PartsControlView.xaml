<UserControl x:Class="ESCenter.Views.PartsControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ESCenter.ViewModels"
             Height="Auto"
             Width="Auto">

    <UserControl.DataContext>
        <vm:PartsControlViewModel/>
    </UserControl.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== TOOLBAR ===================== -->
        <Border Grid.Row="0"
                Padding="10"
                CornerRadius="8"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="1"
                Margin="0,0,0,10">

            <DockPanel LastChildFill="False">

                <!-- Left: Title + Search + Filters -->
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Left"
                            VerticalAlignment="Center">

                    <!-- Title -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,24,0">
                        <Image Source="{StaticResource Parts}"
                               Width="28"
                               Height="28"
                               Margin="0,0,8,0"/>
                        <TextBlock Text="Parts Control"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource NewPrimaryBlueBrush}"
                               Margin="0,0,8,0"/>

                </StackPanel>


                    <!-- Search with icon -->
                    <Grid Width="260" Margin="0,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Image Source="{StaticResource AISearch}"
                               Width="25"
                               Height="25"
                               Margin="8,0,6,0"
                               VerticalAlignment="Center"/>

                        <TextBox Grid.Column="1"
                                 VerticalAlignment="Center"
                                 Style="{StaticResource NeonDarkCyanTextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Grid.Column="2"
                                MinWidth="28"
                                Width="28"
                                Height="28"
                                Margin="6,0,0,0"
                                Padding="0"
                                Style="{StaticResource GradientBorderButtonStyleRed}"
                                Command="{Binding ClearSearchCommand}"
                                ToolTip="Clear search">
                            <Image Source="{StaticResource Clear}" Width="20" Height="20"/>
                        </Button>
                    </Grid>

                    <!-- Part Type -->
                    <TextBlock Text="Part Type:"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>

                    <ComboBox Width="170"
                              Margin="10,0,0,0"
                              Style="{StaticResource NeonDarkCyanComboBoxStyle}"
                              ItemsSource="{Binding PartTypes}"
                              SelectedItem="{Binding SelectedTypeFilter}"
                              VerticalAlignment="Center"/>

                    <!-- Quantity Quick Filters -->
                    <TextBlock Text="Quantity:"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>

                    <Button Margin="10,0,0,0"
                            Style="{StaticResource GradientBorderButtonStyleGreen}"
                            Command="{Binding FilterAllCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{StaticResource AllList}" Width="20" Height="20" Margin="0,0,6,0"/>
                            <TextBlock Text="All"/>
                        </StackPanel>
                    </Button>

                    <Button Margin="6,0,0,0"
                            Style="{StaticResource GradientBorderButtonStyleYellow}"
                            Command="{Binding FilterLowCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{StaticResource LowStock}" Width="20" Height="20" Margin="0,0,6,0"/>
                            <TextBlock Text="Low"/>
                        </StackPanel>
                    </Button>

                    <Button Margin="6,0,0,0"
                            Style="{StaticResource GradientBorderButtonStyleRed}"
                            Command="{Binding FilterOutCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{StaticResource OutStock}" Width="20" Height="20" Margin="0,0,6,0"/>
                            <TextBlock Text="Out"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

                <!-- Right: Actions -->
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right">

                    <!-- Add -->
                    <Button Width="90"
                            Margin="0,0,8,0"
                            Style="{StaticResource GradientBorderButtonStyleGreen}"
                            Command="{Binding AddPartCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{StaticResource Add}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Add"/>
                        </StackPanel>
                    </Button>

                    <!-- Edit -->
                    <Button Width="90"
                            Margin="0,0,8,0"
                            Style="{StaticResource GradientBorderButtonStyleBLueCyan}"
                            Command="{Binding EditPartCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{StaticResource EditAI}" Width="23" Height="23" Margin="0,0,6,0"/>
                            <TextBlock Text="Edit" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Remove -->
                    <Button Width="90"
                            Style="{StaticResource GradientBorderButtonStyleRed}"
                            Command="{Binding RemovePartCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{StaticResource DeleteClose}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Remove"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ===================== GRID ===================== -->
        <Border Grid.Row="1"
                CornerRadius="8"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="1">

            <DataGrid ItemsSource="{Binding PartsView}"
                      AutoGenerateColumns="False"
                      SelectedItem="{Binding SelectedPart, Mode=TwoWay}"
                      Style="{StaticResource DarkDataGridStyle}"
                      RowStyle="{StaticResource TicketRowStyle}"
                      CellStyle="{StaticResource CompactDataGridCellStyle}"
                      ColumnHeaderStyle="{StaticResource CompactDataGridHeaderStyle}">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="120"/>
                    <DataGridTextColumn Header="Part Code" Binding="{Binding PartCode}" Width="200"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding PartType}" Width="130"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding StockStatus}" IsReadOnly="True" Width="80"/>
                    <DataGridTextColumn Header="Qty"
                                        Binding="{Binding QuantityOnHand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="70"/>
                    <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat={}{0:F2}}" Width="90"/>
                    <DataGridTextColumn Header="Quality" Binding="{Binding QualityGrade}" Width="70"/>
                    <DataGridTextColumn Header="Shelf" Binding="{Binding LocationShelf}" Width="80"/>
                    <DataGridTextColumn Header="Bin" Binding="{Binding LocationBin}" Width="80"/>
                    <DataGridTextColumn Header="Unit 1" Binding="{Binding Unit1Display}" Width="130"/>
                    <DataGridTextColumn Header="Unit 2" Binding="{Binding Unit2Display}" Width="130"/>
                    <DataGridTextColumn Header="Chip PN" Binding="{Binding ChipPartNumber}" Width="150"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="130"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="260"/>

                </DataGrid.Columns>
            </DataGrid>

        </Border>

        <!-- ===================== STATUS BAR ===================== -->
        <DockPanel Grid.Row="2"
                   Margin="4,8,4,0">

            <TextBlock Text="{Binding PartsCountDisplay}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       DockPanel.Dock="Left"/>

            <TextBlock Text=""
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</UserControl>
