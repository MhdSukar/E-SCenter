<UserControl x:Class="ESCenter.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ESCenter.ViewModels"
             Height="Auto"
             Width="Auto">

    <UserControl.DataContext>
        <vm:DashboardViewModel/>
    </UserControl.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Main content stretches -->
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Operations Dashboard"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{StaticResource NewPrimaryBlueBrush}"
                       DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource NeonCyanButtonStyle}"
                        Width="100" Margin="10,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ===== MAIN CONTENT ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <!-- Left column -->
                <ColumnDefinition Width="*"/>
                <!-- Right column -->
            </Grid.ColumnDefinitions>

            <!-- ===== LEFT COLUMN ===== -->
            <StackPanel Grid.Column="0" VerticalAlignment="Stretch">
                <!-- Recent Tickets -->
                <Border CornerRadius="8"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="1"
                        Margin="0,0,2,0"
                        Padding="12"
                        VerticalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="Recent Open Tickets"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <DataGrid ItemsSource="{Binding RecentTickets}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Style="{StaticResource DarkDataGridStyle}"
                                  RowStyle="{StaticResource TicketRowStyle}"
                                  ColumnHeaderStyle="{StaticResource CompactDataGridHeaderStyle}"
                                  SelectionUnit="FullRow"
                                  CanUserResizeRows="False"
                                  CanUserResizeColumns="True"
                                  GridLinesVisibility="None"
                                  VerticalAlignment="Stretch"
                                  >
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ESC-ID" Binding="{Binding EscTicketId}" Width="70"/>
                                <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName}" Width="150"/>
                                <DataGridTextColumn Header="Device" Binding="{Binding DeviceCategory}" Width="120"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding RepairStatus}" Width="150"/>
                                <DataGridTextColumn Header="Priority" Binding="{Binding PriorityLevel}" Width="60" CellStyle="{StaticResource PriorityCellStyle}"/>
                                <DataGridTextColumn Header="Received" Binding="{Binding ReceiveDate, StringFormat='yyyy-MM-dd HH:mm'}" Width="120"/>
                                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="150"/>
                                <DataGridTextColumn Header="Final Cost" Binding="{Binding FinalCostDisplay}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== RIGHT COLUMN ===== -->
            <StackPanel Grid.Column="1" VerticalAlignment="Stretch">
                <!-- Priority Stats -->
                <Border CornerRadius="8"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="1"
                        Margin="0,0,0,12"
                        Padding="12"
                        VerticalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="Priority Distribution (Open)"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Height="240">
                            <ItemsControl ItemsSource="{Binding PriorityStats}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Priority}" Grid.Column="0" VerticalAlignment="Center"/>
                                            <ProgressBar Grid.Column="1" Height="16"
                                                         Minimum="0"
                                                         Maximum="{Binding OpenTickets, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         Value="{Binding Count}"
                                                         Style="{StaticResource ModernProgressBarStyle}">
                                                <ProgressBar.ToolTip>
                                                    <TextBlock FontWeight="SemiBold">
                                                        <TextBlock.Text>
                                                            <Binding Path="Count" StringFormat="{}{0} tickets"/>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </ProgressBar.ToolTip>
                                            </ProgressBar>
                                            <TextBlock Text="{Binding Count}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Quick Actions -->
                <Border CornerRadius="8"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="1"
                        Padding="12"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Quick actions" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <UniformGrid Columns="2" Rows="1">
                            <Border>
                                <Button Style="{StaticResource NeonPurpleButtonStyle}" Width="110" Command="{Binding OpenTicketsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,3,6,0"/>
                                        <TextBlock Text="New Ticket"/>
                                    </StackPanel>
                                </Button>
                            </Border>
                            <Border>
                                <Button Style="{StaticResource NeonBlueButtonStyle}" Width="110" Command="{Binding ClosedTicketsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,3,4,0"/>
                                        <TextBlock Text="Closed Tickets"/>
                                    </StackPanel>
                                </Button>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
