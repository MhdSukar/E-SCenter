<UserControl x:Class="ESCenter.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ESCenter.ViewModels"
             Height="Auto"
             Width="Auto">

    <UserControl.DataContext>
        <vm:DashboardViewModel/>
    </UserControl.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Main content stretches -->
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Operations Dashboard"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{StaticResource NewPrimaryBlueBrush}"
                       DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource NeonCyanButtonStyle}"
                        Width="100" Margin="10,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ===== MAIN CONTENT ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <!-- Left column -->
                <ColumnDefinition Width="*"/>
                <!-- Right column -->
            </Grid.ColumnDefinitions>

            <!-- ===== LEFT COLUMN ===== -->
            <StackPanel Grid.Column="0" VerticalAlignment="Stretch">
                <!-- Recent Tickets -->
                <Border CornerRadius="8"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="1"
                        Margin="0,0,2,0"
                        Padding="12"
                        VerticalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="Recent Open Tickets"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <DataGrid ItemsSource="{Binding RecentTickets}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Style="{StaticResource DarkDataGridStyle}"
                                  RowStyle="{StaticResource TicketRowStyle}"
                                  ColumnHeaderStyle="{StaticResource CompactDataGridHeaderStyle}"
                                  SelectionUnit="FullRow"
                                  CanUserResizeRows="False"
                                  CanUserResizeColumns="True"
                                  GridLinesVisibility="None"
                                  VerticalAlignment="Stretch"
                                  >
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ESC-ID" Binding="{Binding EscTicketId}" Width="70"/>
                                <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName}" Width="150"/>
                                <DataGridTextColumn Header="Device" Binding="{Binding DeviceCategory}" Width="120"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding RepairStatus}" Width="150"/>
                                <DataGridTextColumn Header="Priority" Binding="{Binding PriorityLevel}" Width="60" CellStyle="{StaticResource PriorityCellStyle}"/>
                                <DataGridTextColumn Header="Received" Binding="{Binding ReceiveDate, StringFormat='yyyy-MM-dd HH:mm'}" Width="120"/>
                                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="150"/>
                                <DataGridTextColumn Header="Final Cost" Binding="{Binding FinalCostDisplay}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== RIGHT COLUMN ===== -->
            <StackPanel Grid.Column="1" VerticalAlignment="Stretch">
                <!-- Parts Risk Counter -->
                <Border CornerRadius="8"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="1"
                        Margin="0,0,0,12"
                        Padding="12"
                        VerticalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="Parts Risk Counter"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Low parts (SKU &lt; 5)"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Height="110">
                            <ItemsControl ItemsSource="{Binding LowPartSkus}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <TextBlock Text="{Binding Label}" DockPanel.Dock="Left"/>
                                            <TextBlock Text="{Binding Quantity}"
                                                       DockPanel.Dock="Right"
                                                       FontWeight="SemiBold"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="Low inventory items (&lt; 2)"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,10,0,6"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Height="110">
                            <ItemsControl ItemsSource="{Binding LowInventoryItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <TextBlock Text="{Binding Label}" DockPanel.Dock="Left"/>
                                            <TextBlock Text="{Binding Quantity}"
                                                       DockPanel.Dock="Right"
                                                       FontWeight="SemiBold"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
