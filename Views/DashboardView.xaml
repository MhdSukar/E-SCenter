<UserControl x:Class="ESCenter.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto">

    <UserControl.Resources>

        <!-- Priority colour helper -->
        <Style x:Key="PriorityDotStyle" TargetType="Ellipse">
            <Setter Property="Width"  Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- Ticket card style -->
        <Style x:Key="TicketCardStyle" TargetType="Border">
            <Setter Property="Background"        Value="#1A1A1A"/>
            <Setter Property="BorderBrush"       Value="#12FFFFFF"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="CornerRadius"      Value="8"/>
            <Setter Property="Padding"           Value="12,10"/>
            <Setter Property="Margin"            Value="0,0,0,6"/>
            <Setter Property="Cursor"            Value="Hand"/>
        </Style>

        <!-- Low stock row -->
        <Style x:Key="LowStockRowStyle" TargetType="Border">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="#08FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding"         Value="8,8"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header ═════════════════════════════════════════════ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14" Width="290"
                   HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="{StaticResource Dashboard}"
                       Width="30" Height="30" Margin="0,0,8,0"/>
                <TextBlock Text="Operations Dashboard"
                           FontSize="18" FontWeight="SemiBold" 
                           Foreground="{StaticResource Gradient.Primary.Horizontal}">
                </TextBlock>
            </StackPanel>

            <Button DockPanel.Dock="Right"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource IconButtonStyle}"
                    Width="30" Height="30" ToolTip="Refresh">
                <Image Source="{StaticResource Refresh}" Width="18" Height="18"/>
            </Button>
        </DockPanel>

        <!-- ═══ Main grid ══════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══ LEFT — Recent open tickets (cards) ══════════════ -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Section header -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Recent Open Tickets"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <!-- Count badge -->
                    <Border DockPanel.Dock="Left"
                            Background="#18237EF2"
                            BorderBrush="#30237EF2"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10,5"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding RecentTickets.Count}"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="#5AA7FF"/>
                    </Border>
                </DockPanel>

                <!-- Card list -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding RecentTickets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TicketCardStyle}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.OpenTicketCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <!-- Hover state via EventTrigger not needed — 
                                         wire NavigateToTicket via MouseLeftButtonUp
                                         in code-behind if desired -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Priority colour stripe -->
                                        <Border Grid.Column="0"
                                                Width="3" CornerRadius="2"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Stretch">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#404040"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PriorityLevel}" Value="Critical">
                                                            <Setter Property="Background" Value="#FF5A5A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PriorityLevel}" Value="Major">
                                                            <Setter Property="Background" Value="#FFD54A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PriorityLevel}" Value="Normal">
                                                            <Setter Property="Background" Value="#5AA7FF"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PriorityLevel}" Value="Minor">
                                                            <Setter Property="Background" Value="#606060"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <!-- Content -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <!-- Top row: ID + customer name -->
                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,0,0,4">
                                                <Border Background="#1A5AA7FF"
                                                        CornerRadius="3"
                                                        Padding="5,1"
                                                        Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding EscTicketId}"
                                                               FontSize="10"
                                                               FontFamily="Consolas"
                                                               FontWeight="SemiBold"
                                                               Foreground="#5AA7FF"/>
                                                </Border>
                                                <TextBlock Text="{Binding CustomerName}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Bottom row: device + status -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DeviceCategory}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text=" · "
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextTertiaryBrush}"/>
                                                <TextBlock Text="{Binding RepairStatus}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Right: date + cost -->
                                        <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding ReceiveDate,
                                                              StringFormat='{}{0:MMM dd}'}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding DashboardCostDisplay}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#00E5D4"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ══ RIGHT — stock + weekly KPIs ════════════════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Low stock panel -->
                <Border Grid.Row="0"
                        Background="#161616"
                        BorderThickness="1"
                        CornerRadius="10"
                        Margin="0,0,0,10">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#30FF6B6B" Offset="0.0"/>
                            <GradientStop Color="#30D50000" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" CornerRadius="10,10,0,0" Padding="12,10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#0CFF6B6B" Offset="0.0"/>
                                    <GradientStop Color="#00161616" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <DockPanel>
                                <Border DockPanel.Dock="Left"
                                        Width="3" CornerRadius="2"
                                        Margin="0,0,10,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FF6B6B" Offset="0"/>
                                            <GradientStop Color="#D50000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Button DockPanel.Dock="Right"
                                        Command="{Binding ExportReorderListCommand}"
                                        Style="{StaticResource IconButtonStyle}"
                                        Width="26" Height="26"
                                        Margin="0,0,6,0"
                                        ToolTip="Reorder List">
                                    <Image Source="{StaticResource LowStock}" Width="14" Height="14"/>
                                </Button>
                                <TextBlock Text="Low Stock Alert"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Border DockPanel.Dock="Right"
                                        Background="#18FF3B3B"
                                        BorderBrush="#30FF3B3B"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,5"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LowStockItems.Count}"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource NeonRedBrush}"/>
                                </Border>
                            </DockPanel>
                        </Border>

                        <!-- Divider -->
                        <Border Grid.Row="0" Height="1"
                                VerticalAlignment="Bottom"
                                Margin="12,0,12,0" Opacity="0.1"
                                Background="{StaticResource NeonRedBrush}"/>

                        <!-- Stock item rows -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="4,4">
                            <ItemsControl ItemsSource="{Binding LowStockItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource LowStockRowStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Source badge -->
                                                <Border Grid.Column="0"
                                                        Background="#15FFFFFF"
                                                        CornerRadius="3"
                                                        Padding="5,1"
                                                        Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Source}"
                                                               FontSize="9"
                                                               Foreground="{StaticResource TextTertiaryBrush}"/>
                                                </Border>

                                                <!-- Item name -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <!-- Quantity — red if critical -->
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Quantity}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource NeonRedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Quantity}" Value="0">
                                                                    <Setter Property="Foreground" Value="#FF3B3B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <Button Grid.Column="3"
                                                        Command="{Binding DataContext.RestockItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        Width="24"
                                                        Height="20"
                                                        Margin="6,0,0,0"
                                                        ToolTip="Restock this item">
                                                    <TextBlock Text="+"
                                                               FontSize="14"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource NeonCyanBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Weekly KPI card -->
                <Border Grid.Row="1"
                        Background="#161616"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,12">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3000E5D4" Offset="0.0"/>
                            <GradientStop Color="#30237EF2" Offset="0.5"/>
                            <GradientStop Color="#302952D9" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <StackPanel>

                        <!-- Title row -->
                        <DockPanel Margin="0,0,0,12">
                            <Border DockPanel.Dock="Left"
                                    Width="3" CornerRadius="2" Margin="0,0,10,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00E5D4" Offset="0"/>
                                        <GradientStop Color="#2952D9" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock Text="This week"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Three KPI numbers -->
                        <UniformGrid Columns="3" Margin="0,0,0,12">
                            <!-- Finished -->
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding WeeklyFinishedTickets}"
                                           FontSize="24" FontWeight="Bold"
                                           HorizontalAlignment="Center">
                                    <TextBlock.Foreground>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#00E5D4" Offset="0"/>
                                            <GradientStop Color="#237EF2" Offset="1"/>
                                        </LinearGradientBrush>
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <TextBlock Text="Done"
                                           FontSize="9"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextTertiaryBrush}"/>
                            </StackPanel>

                            <!-- Total -->
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding WeeklyTotalTickets}"
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Total"
                                           FontSize="9"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextTertiaryBrush}"/>
                            </StackPanel>

                            <!-- Income -->
                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="{Binding WeeklyIncomeSP, StringFormat='{}{0:F0} S.P'}"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource NeonGreenBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding WeeklyIncomeUSD, StringFormat='{}{0:F2} USD'}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource NeonCyanBrush}"
                                               HorizontalAlignment="Center">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding WeeklyIncomeUSD}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Text="Income"
                                           FontSize="9"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextTertiaryBrush}"/>
                            </StackPanel>
                        </UniformGrid>

                        <!-- Completion progress bar -->
                        <ProgressBar Minimum="0" Maximum="100"
                                     Value="{Binding WeeklyCompletionPercent}"
                                     Height="6"
                                     Style="{StaticResource ModernProgressBarStyle}"
                                     Margin="0,0,0,6"/>

                        <!-- Completion label -->
                        <DockPanel>
                            <TextBlock Text="Completion"
                                       FontSize="10"
                                       Foreground="{StaticResource TextTertiaryBrush}"/>
                            <TextBlock Text="{Binding WeeklyCompletionPercent,
                                              StringFormat='{}{0:F1}%'}"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Right"
                                       DockPanel.Dock="Right"/>
                        </DockPanel>

                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
