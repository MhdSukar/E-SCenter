<UserControl x:Class="ESCenter.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ESCenter.ViewModels"
             Height="Auto"
             Width="Auto">

    <UserControl.DataContext>
        <vm:DashboardViewModel/>
    </UserControl.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Operations Dashboard"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{StaticResource NewPrimaryBlueBrush}"
                       DockPanel.Dock="Left"/>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Refresh"
                        Width="100"
                        Margin="10,0"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource NeonCyanButtonStyle}"/>
            </StackPanel>
        </DockPanel>

        <!-- Main -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left column -->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Border CornerRadius="8"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="1"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Recent Open Tickets"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,8"/>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding RecentTickets}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Style="{StaticResource DarkDataGridStyle}"
                                  RowStyle="{StaticResource TicketRowStyle}"
                                  ColumnHeaderStyle="{StaticResource CompactDataGridHeaderStyle}"
                                  SelectionUnit="FullRow"
                                  CanUserResizeRows="False"
                                  CanUserResizeColumns="True"
                                  GridLinesVisibility="None">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ESC-ID" Binding="{Binding EscTicketId}" Width="70"/>
                                <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName}" Width="150"/>
                                <DataGridTextColumn Header="Device" Binding="{Binding DeviceCategory}" Width="120"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding RepairStatus}" Width="130"/>
                                <DataGridTextColumn Header="Priority"
                                                    Binding="{Binding PriorityLevel}"
                                                    Width="70"
                                                    CellStyle="{StaticResource PriorityCellStyle}"/>
                                <DataGridTextColumn Header="Received"
                                                    Binding="{Binding ReceiveDate, StringFormat='yyyy-MM-dd HH:mm'}"
                                                    Width="130"/>
                                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="160"/>
                                <DataGridTextColumn Header="Final Cost" Binding="{Binding FinalCostDisplay}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right column -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Priority distribution -->
                <Border Grid.Row="0"
                        CornerRadius="8"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="1"
                        Margin="0,0,0,12"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="Priority Distribution (Open)"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,8"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Height="165">
                            <ItemsControl ItemsSource="{Binding PriorityStats}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Priority}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                                            <ProgressBar Grid.Column="1"
                                                         Height="16"
                                                         Minimum="0"
                                                         Maximum="{Binding OpenTickets, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         Value="{Binding Count}"
                                                         Style="{StaticResource ModernProgressBarStyle}"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Count}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Weekly progress -->
                <Border Grid.Row="1"
                        CornerRadius="8"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="1"
                        Margin="0,0,0,12"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="Weekly Tickets Progress"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding WeeklyFinishedTickets, StringFormat=Finished: {0}}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding WeeklyTotalTickets, StringFormat=Total this week: {0}}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,8"/>

                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding WeeklyCompletionPercent}"
                                     Height="16"
                                     Style="{StaticResource ModernProgressBarStyle}"/>

                        <TextBlock Text="{Binding WeeklyCompletionPercent, StringFormat=Completion: {0:F1}%}"
                                   Margin="0,8,0,4"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>

                        <TextBlock Text="{Binding WeeklyIncome, StringFormat=Weekly income from finished tickets: {0:F2}}"
                                   Foreground="{StaticResource NeonGreenBrush}"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
