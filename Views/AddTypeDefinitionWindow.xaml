<Window x:Class="ESCenter.Views.AddTypeDefinitionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Type" Width="420" Height="300" WindowStartupLocation="CenterOwner"
        Background="{StaticResource CardBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Type Name" Foreground="{StaticResource TextSecondaryBrush}"/>
        <TextBox Grid.Row="1" Text="{Binding TypeNameValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GradiantTextboxStyle1}"/>
        <TextBlock Grid.Row="2" Text="Unit 1 (parts only)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" Visibility="{Binding PartsModeVisibility}"/>
        <TextBox Grid.Row="3" Text="{Binding Unit1Value}" Style="{StaticResource GradiantTextboxStyle1}" Visibility="{Binding PartsModeVisibility}"/>
        <TextBlock Grid.Row="4" Text="Unit 2 (parts only)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" Visibility="{Binding PartsModeVisibility}" VerticalAlignment="Top"/>
        <TextBox Grid.Row="4" Margin="0,26,0,0" Text="{Binding Unit2Value}" Style="{StaticResource GradiantTextboxStyle1}" Height="30" VerticalAlignment="Top" Visibility="{Binding PartsModeVisibility}"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Width="100" Margin="0,0,8,0" Style="{StaticResource GhostButtonStyle}" Click="Cancel_Click" Content="Cancel"/>
            <Button Width="100" Style="{StaticResource GreenButtonStyle}" Click="Save_Click" Content="Save"/>
        </StackPanel>
    </Grid>
</Window>
