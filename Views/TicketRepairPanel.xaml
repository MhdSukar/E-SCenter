<UserControl x:Class="ESCenter.Views.TicketRepairPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>

        <Style x:Key="SectionLine" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,14,0,8"/>
            <Setter Property="Background" Value="{StaticResource BorderDarkBrush}"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource SectionLine}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#30F97316" Offset="0"/>
                    <GradientStop Color="#00F97316" Offset="0.5"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="🔧 REPAIR" Style="{StaticResource SectionHeader}"
                   Foreground="#F97316" Margin="0,14,0,6"/>

        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
            <Image Source="{StaticResource RepairStatus}" Width="13" Height="13" Margin="0,0,5,0"/>
            <TextBlock Text="Repair Status:" Style="{StaticResource FieldLabel}" Margin="0"/>
        </StackPanel>
        <ComboBox Grid.Row="1" Grid.Column="1"
                  SelectedItem="{Binding RepairStatus, Mode=TwoWay}"
                  Margin="4,0,0,8" Style="{StaticResource GradiantComboboxStyle11}" TabIndex="11">
            <ComboBox.ItemsSource>
                <x:Array Type="{x:Type sys:String}">
                    <sys:String>Received</sys:String>
                    <sys:String>Diagnosing</sys:String>
                    <sys:String>Waiting for Parts</sys:String>
                    <sys:String>In Repair</sys:String>
                    <sys:String>Testing</sys:String>
                    <sys:String>Waiting For Client Approval</sys:String>
                    <sys:String>Completed</sys:String>
                    <sys:String>Cancelled</sys:String>
                </x:Array>
            </ComboBox.ItemsSource>
        </ComboBox>

        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
            <Image Source="{StaticResource Priority}" Width="13" Height="13" Margin="0,0,5,0"/>
            <TextBlock Text="Priority:" Style="{StaticResource FieldLabel}" Margin="0"/>
        </StackPanel>
        <ComboBox Grid.Row="2" Grid.Column="1"
                  SelectedItem="{Binding PriorityLevel, Mode=TwoWay}"
                  Width="130" HorizontalAlignment="Left"
                  Margin="4,0,0,8" Style="{StaticResource GradiantComboboxStyle11}" TabIndex="12">
            <ComboBox.ItemsSource>
                <x:Array Type="{x:Type sys:String}">
                    <sys:String>Minor</sys:String>
                    <sys:String>Normal</sys:String>
                    <sys:String>Major</sys:String>
                    <sys:String>Critical</sys:String>
                </x:Array>
            </ComboBox.ItemsSource>
        </ComboBox>

        <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
            <Image Source="{StaticResource EstimatedCost}" Width="13" Height="13" Margin="0,0,5,0"/>
            <TextBlock Text="Estimated Cost:" Style="{StaticResource FieldLabel}" Margin="0"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,8">
            <TextBox Width="120" Margin="0,0,6,0"
                     Text="{Binding EstimatedCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                     Style="{StaticResource GradiantTextboxStyle1}" TabIndex="14"
                     KeyDown="SingleLineTextBox_KeyDown"/>
            <ComboBox Width="80" SelectedItem="{Binding EstimatedCostCurrency, Mode=TwoWay}"
                      Style="{StaticResource GradiantComboboxStyle11}" ItemsSource="{Binding Currencies}"/>
            <TextBlock Text="{Binding EstimatedCostEquivalent}" Foreground="#FFD54A"
                       FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
            <Image Source="{StaticResource FinalCost}" Width="13" Height="13" Margin="0,0,5,0"/>
            <TextBlock Text="Final Cost:" Style="{StaticResource FieldLabel}" Margin="0"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,8">
            <TextBox Width="120" Margin="0,0,6,0"
                     Text="{Binding FinalCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                     Style="{StaticResource GradiantTextboxStyle1}" TabIndex="15"
                     KeyDown="SingleLineTextBox_KeyDown"/>
            <ComboBox Width="80" SelectedItem="{Binding FinalCostCurrency, Mode=TwoWay}"
                      Style="{StaticResource GradiantComboboxStyle11}" ItemsSource="{Binding Currencies}"/>
            <TextBlock Text="{Binding FinalCostEquivalent}" Foreground="#FFD54A"
                       FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
            <Image Source="{StaticResource Warranty}" Width="18" Height="18" Margin="-3,0,3,0"/>
            <TextBlock Text="Warranty:" Style="{StaticResource FieldLabel}" Margin="0"/>
        </StackPanel>
        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,8">
            <CheckBox IsChecked="{Binding HasWarranty}"
                      Style="{StaticResource GradientCheckBoxStyle}"
                      Margin="0,0,8,0" TabIndex="18"/>
            <ComboBox Width="160" IsEnabled="{Binding HasWarranty}"
                      SelectedItem="{Binding WarrantyPeriod, Mode=TwoWay}"
                      Style="{StaticResource GradiantComboboxStyle11}" TabIndex="19">
                <ComboBox.ItemsSource>
                    <x:Array Type="{x:Type sys:String}">
                        <sys:String>1 Day</sys:String>
                        <sys:String>7 Days</sys:String>
                        <sys:String>14 Days</sys:String>
                        <sys:String>30 Days</sys:String>
                        <sys:String>90 Days</sys:String>
                        <sys:String>6 Months</sys:String>
                        <sys:String>1 Year</sys:String>
                    </x:Array>
                </ComboBox.ItemsSource>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
            <Image Source="{StaticResource RepOnWar}" Width="13" Height="13" Margin="0,0,5,0"/>
            <TextBlock Text="Rep. on Warranty:" Style="{StaticResource FieldLabel}" Margin="0"/>
        </StackPanel>
        <CheckBox Grid.Row="6" Grid.Column="1"
                  IsChecked="{Binding IsWarrantyRepair}"
                  Margin="4,0,0,8" Style="{StaticResource GradientCheckBoxStyle}" TabIndex="20"/>

        <StackPanel Grid.Row="7" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,0" VerticalAlignment="Center">
            <Image Source="{StaticResource RootCause}" Width="13" Height="13" Margin="0,0,5,0"/>
            <TextBlock Text="Root Cause:" Style="{StaticResource FieldLabel}" Margin="0"/>
        </StackPanel>
        <ComboBox Grid.Row="7" Grid.Column="1"
                  SelectedItem="{Binding RootCause, Mode=TwoWay}"
                  Margin="4,0,0,0" Style="{StaticResource GradiantComboboxStyle11}" TabIndex="16">
            <ComboBox.ItemsSource>
                <x:Array Type="{x:Type sys:String}">
                    <sys:String>Electrical Cause</sys:String>
                    <sys:String>Mechanical Cause</sys:String>
                    <sys:String>Environmental Cause</sys:String>
                    <sys:String>Human Cause</sys:String>
                </x:Array>
            </ComboBox.ItemsSource>
        </ComboBox>

    </Grid>
</UserControl>
