<UserControl x:Class="ESCenter.Views.TicketListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Border Style="{StaticResource CardBorderStyle}"
            Padding="8"
            Margin="0,0,10,0">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                    <Image Source="{StaticResource Tickets}" Width="26" Height="26" Margin="0,0,6,0" />
                    <TextBlock Text="Repair Tickets" FontSize="20" FontWeight="Bold" Foreground="{StaticResource NewPrimaryBlueBrush}" DockPanel.Dock="Left" Margin="0,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Command="{Binding CloseCommand}" Style="{StaticResource GradientBorderButtonStyleGreen}" Width="80" Margin="4,0" IsEnabled="{Binding SelectedTicket}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{StaticResource TickClosed}" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock Text="Close" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ReopenCommand}" Style="{StaticResource GradientBorderButtonStyleYellow}" Width="80" Margin="4,0" IsEnabled="{Binding SelectedTicket}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{StaticResource Reopen1}" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock Text="Reopen" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding DeleteCommand}" Style="{StaticResource GradientBorderButtonStyleRed}" Width="80" Margin="4,0" IsEnabled="{Binding SelectedTicket}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{StaticResource DeleteClose}" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock Text="Delete" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <Border DockPanel.Dock="Top" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="6" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Image Source="{StaticResource AISearch}" Width="25" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>

                        <TextBox Width="240" Margin="0,0,6,0" 
                                 Style="{StaticResource NeonDarkCyanTextBoxStyle}" 
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button MinWidth="28" Width="28" Height="28" 
                                Margin="0,0,12,0" Padding="0" 
                                Style="{StaticResource GradientBorderButtonStyleRed}" 
                                Command="{Binding ClearSearchCommand}" ToolTip="Clear search">
                            <Image Source="{StaticResource Clear}" Width="20" Height="20"/>
                        </Button>

                        <TextBlock Text="Ticket Status:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource Gradient.Warning}"/>
                        <ComboBox Width="140" Margin="0,0,10,0" Style="{StaticResource NeonDarkCyanComboBoxStyle}" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}" />

                        <TextBlock Text="Ticket Priority:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource Gradient.Danger}"/>
                        <ComboBox Width="140" Style="{StaticResource NeonDarkCyanComboBoxStyle}" ItemsSource="{Binding PriorityFilters}" SelectedItem="{Binding SelectedPriorityFilter}" />

                        <Button MinWidth="28" Width="28" Height="28" Margin="10,0,0,0" Padding="0" Style="{StaticResource GradientBorderButtonStyleRed}" Command="{Binding ResetFiltersCommand}" ToolTip="Reset filters">
                            <Image Source="{StaticResource Clear}" Width="20" Height="20"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <DataGrid ItemsSource="{Binding TicketsView}" SelectedItem="{Binding SelectedTicket, Mode=TwoWay}" IsSynchronizedWithCurrentItem="True" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource DarkDataGridStyle}" RowStyle="{StaticResource TicketRowStyle}" CellStyle="{StaticResource TicketCellStyle}" ColumnHeaderStyle="{StaticResource CompactDataGridHeaderStyle}" SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="" Binding="{Binding SymbolDisplay}" Width="34" />
                    <DataGridTextColumn Header="ESC-ID" Binding="{Binding EscTicketId}" Width="70" />
                    <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName}" Width="120" />
                    <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="100" />
                    <DataGridTextColumn Header="Device" Binding="{Binding DeviceCategory}" Width="80" />
                    <DataGridTextColumn Header="Model" Binding="{Binding DeviceModel}" Width="100" />
                    <DataGridTextColumn Header="Status" Binding="{Binding RepairStatus}" Width="90" />
                    <DataGridTextColumn Header="Priority" Binding="{Binding PriorityLevel}" Width="75" CellStyle="{StaticResource PriorityCellStyle}" />
                    <DataGridTextColumn Header="Received" Binding="{Binding ReceiveDate, StringFormat='yyyy-MM-dd HH:mm'}" Width="100" />
                    <DataGridTextColumn Header="Delivery" Binding="{Binding DeliveryDate, StringFormat='yyyy-MM-dd HH:mm'}" Width="100" />
                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
