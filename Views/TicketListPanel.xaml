<UserControl x:Class="ESCenter.Views.TicketListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Border Style="{StaticResource CardBorderStyle}"
            CornerRadius="10"
            Padding="0"
            Margin="0,0,10,0"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#237EF2" BlurRadius="16" ShadowDepth="0" Opacity="0.07"/>
        </Border.Effect>

        <DockPanel>

            <!-- ── Header with gradient accent bar ── -->
            <Border DockPanel.Dock="Top"
                    Padding="12,10"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="0,0,0,1"
                    Background="{StaticResource CardBackgroundBrush}">
                <Grid>
                    <!-- Accent bar -->
                    <Border Width="4" CornerRadius="10,0,0,0"
                            HorizontalAlignment="Left" VerticalAlignment="Stretch"
                            Margin="-12,-10,0,-10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00E5D4" Offset="0"/>
                                <GradientStop Color="#237EF2" Offset="0.5"/>
                                <GradientStop Color="#2952D9" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <DockPanel LastChildFill="False" Margin="8,0,0,0">

                        <!-- Title -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                                    VerticalAlignment="Center" Margin="0,0,16,0">
                            <Image Source="{StaticResource Tickets}"
                                   Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Repair Tickets"
                                       FontSize="17" FontWeight="Bold"
                                       Foreground="{StaticResource Gradient.Primary.Horizontal}"/>
                        </StackPanel>

                        <!-- Action buttons -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding ExportTicketsCsvCommand}"
                                    Style="{StaticResource GradientBorderButtonStyleAccent}"
                                    Width="96" Height="28" Margin="4,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource DBReport}" Width="14" Height="14" Margin="0,0,5,0"/>
                                    <TextBlock Text="Export CSV" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CloseCommand}"
                                    Style="{StaticResource GradientBorderButtonStyleGreen}"
                                    Width="78" Height="28" Margin="4,0"
                                    IsEnabled="{Binding SelectedTicket}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource TickClosed}" Width="14" Height="14" Margin="0,0,5,0"/>
                                    <TextBlock Text="Close" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ReopenCommand}"
                                    Style="{StaticResource GradientBorderButtonStyleYellow}"
                                    Width="80" Height="28" Margin="4,0"
                                    IsEnabled="{Binding SelectedTicket}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource Reopen1}" Width="14" Height="14" Margin="0,0,5,0"/>
                                    <TextBlock Text="Reopen" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CopyPickupMessageCommand}"
                                    Style="{StaticResource GradientBorderButtonStyleBLueCyan}"
                                    Width="78" Height="28" Margin="4,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource Notify}" Width="14" Height="14" Margin="0,0,5,0"/>
                                    <TextBlock Text="Notify" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CopyReceiptCommand}"
                                    Style="{StaticResource GradientBorderButtonStyleGreen}"
                                    Width="104" Height="28" Margin="4,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource Receipt}" Width="14" Height="14" Margin="0,0,5,0"/>
                                    <TextBlock Text="Copy Receipt" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding PrintReceiptCommand}"
                                    Style="{StaticResource GradientBorderButtonStyleGreen}"
                                    Width="78" Height="28" Margin="4,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource Print}" Width="14" Height="14" Margin="0,0,5,0"/>
                                    <TextBlock Text="Print" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding DeleteCommand}"
                                    Style="{StaticResource GradientBorderButtonStyleRed}"
                                    Width="78" Height="28" Margin="4,0"
                                    IsEnabled="{Binding SelectedTicket}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource DeleteClose}" Width="14" Height="14" Margin="0,0,5,0"/>
                                    <TextBlock Text="Delete" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- ── Filter bar ── -->
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="10,7">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">

                        <!-- Search box -->
                        <Border CornerRadius="7" BorderBrush="{StaticResource BorderDarkBrush}"
                                BorderThickness="1" Background="{StaticResource CardBackgroundBrush}"
                                Width="220" Height="30" Margin="0,0,10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="{StaticResource AISearch}"
                                       Width="15" Height="15" Margin="8,0,5,0"
                                       VerticalAlignment="Center" Opacity="0.55"/>
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource GradiantTextboxStyle1}"
                                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center"
                                         BorderThickness="0" Background="Transparent" Padding="0"/>
                                <Button Grid.Column="2" Width="22" Height="22"
                                        Margin="3,0,3,0" Padding="0" Opacity="0.7"
                                        Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding ClearSearchCommand}" ToolTip="Clear search">
                                    <Image Source="{StaticResource Clear}" Width="13" Height="13"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Status filter -->
                        <TextBlock Text="Status:" VerticalAlignment="Center"
                                   Margin="0,0,5,0" FontSize="11"
                                   Foreground="{StaticResource Gradient.Warning}"/>
                        <ComboBox Width="130" Height="28" Margin="0,0,10,0"
                                  Style="{StaticResource GradiantComboboxStyle11}"
                                  ItemsSource="{Binding StatusFilters}"
                                  SelectedItem="{Binding SelectedStatusFilter}"/>

                        <!-- Priority filter -->
                        <TextBlock Text="Priority:" VerticalAlignment="Center"
                                   Margin="0,0,5,0" FontSize="11"
                                   Foreground="{StaticResource Gradient.Danger}"/>
                        <ComboBox Width="130" Height="28" Margin="0,0,8,0"
                                  Style="{StaticResource GradiantComboboxStyle11}"
                                  ItemsSource="{Binding PriorityFilters}"
                                  SelectedItem="{Binding SelectedPriorityFilter}"/>

                        <!-- Reset -->
                        <Button MinWidth="28" Width="28" Height="28" Padding="0"
                                Style="{StaticResource IconButtonStyle}"
                                Command="{Binding ResetFiltersCommand}" ToolTip="Reset filters">
                            <Image Source="{StaticResource Clear}" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ── Tickets DataGrid ── -->
            <DataGrid ItemsSource="{Binding TicketsView}"
                      SelectedItem="{Binding SelectedTicket, Mode=TwoWay}"
                      IsSynchronizedWithCurrentItem="True"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Style="{StaticResource DarkDataGridStyle}"
                      RowStyle="{StaticResource TicketRowStyle}"
                      CellStyle="{StaticResource TicketCellStyle}"
                      ColumnHeaderStyle="{StaticResource CompactDataGridHeaderStyle}"
                      SelectionUnit="FullRow">
                <DataGrid.Columns>

                    <!-- Symbol / icon column -->
                    <DataGridTextColumn Header="" Binding="{Binding SymbolDisplay}" Width="32"/>

                    <!-- ESC-ID chip -->
                    <DataGridTemplateColumn Header="ESC-ID" Width="95" SortMemberPath="EscTicketId">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#1A237EF2" BorderBrush="#30237EF2"
                                        BorderThickness="1" CornerRadius="4"
                                        Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding EscTicketId}"
                                               Foreground="#5AA7FF" FontFamily="Consolas"
                                               FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName}" Width="120"/>
                    <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="115"/>
                    <DataGridTextColumn Header="Device" Binding="{Binding DeviceCategory}" Width="80"/>
                    <DataGridTextColumn Header="Model" Binding="{Binding DeviceModel}" Width="100"/>

                    <!-- Status pill -->
                    <DataGridTemplateColumn Header="Status" Width="160" SortMemberPath="RepairStatus">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                                        CornerRadius="8" Padding="8,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1A5AA7FF"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RepairStatus}" Value="Ready for Pickup">
                                                    <Setter Property="Background" Value="#1A22C55E"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RepairStatus}" Value="Completed">
                                                    <Setter Property="Background" Value="#1422C55E"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RepairStatus}" Value="Cancelled">
                                                    <Setter Property="Background" Value="#1AEF4444"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RepairStatus}" Value="In Repair">
                                                    <Setter Property="Background" Value="#1A00E5D4"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RepairStatus}" Value="Waiting for Parts">
                                                    <Setter Property="Background" Value="#1AFBBF24"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding RepairStatus}"
                                               FontSize="10" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#5AA7FF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RepairStatus}" Value="Ready for Pickup">
                                                        <Setter Property="Foreground" Value="#22C55E"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RepairStatus}" Value="Completed">
                                                        <Setter Property="Foreground" Value="#22C55E"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RepairStatus}" Value="Cancelled">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RepairStatus}" Value="In Repair">
                                                        <Setter Property="Foreground" Value="#00E5D4"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RepairStatus}" Value="Waiting for Parts">
                                                        <Setter Property="Foreground" Value="#FBBF24"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Priority pill -->
                    <DataGridTemplateColumn Header="Priority" Width="85" SortMemberPath="PriorityLevel">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PriorityPillBorderStyle}">
                                    <TextBlock Text="{Binding PriorityLevel}"
                                               Style="{StaticResource PriorityPillTextStyle}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Received"
                                        Binding="{Binding ReceiveDate, StringFormat='yyyy-MM-dd HH:mm'}" Width="117"/>
                    <DataGridTextColumn Header="Delivery"
                                        Binding="{Binding DeliveryDate, StringFormat='yyyy-MM-dd HH:mm'}" Width="118"/>
   
                </DataGrid.Columns>
            </DataGrid>

        </DockPanel>
    </Border>
</UserControl>
