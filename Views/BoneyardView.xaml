<UserControl x:Class="ESCenter.Views.BoneyardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ESCenter.ViewModels"
             Height="Auto"
             Width="Auto">

    <UserControl.DataContext>
        <vm:BoneyardViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="TypeChipBorder" TargetType="Border">
            <Setter Property="Background"      Value="#1A00E5D4"/>
            <Setter Property="BorderBrush"     Value="#2500E5D4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="4"/>
            <Setter Property="Padding"         Value="8,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ TOOLBAR ══ -->
        <Border Grid.Row="0"
                Margin="0,0,0,10"
                CornerRadius="10"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#F97316" BlurRadius="18" ShadowDepth="0" Opacity="0.07"/>
            </Border.Effect>
            <Grid>
                <!-- Orange accent bar (boneyard = salvage, orange fits) -->
                <Border Width="4" CornerRadius="10,0,0,10"
                        HorizontalAlignment="Left" VerticalAlignment="Stretch">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#F97316" Offset="0"/>
                            <GradientStop Color="#EF4444" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <DockPanel LastChildFill="False" Margin="16,10,12,10">

                    <!-- Title -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                                VerticalAlignment="Center" Margin="0,0,16,0">
                        <Image Source="{StaticResource Boneyard}"
                               Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Boneyard"
                                       FontSize="17" FontWeight="Bold"
                                       Margin="0,0,0,1">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#F97316" Offset="0"/>
                                        <GradientStop Color="#EF4444" Offset="1"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <TextBlock Text="{Binding DevicesCountDisplay}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Separator -->
                    <Separator DockPanel.Dock="Left" Style="{x:Null}" Width="1"
                               Background="{StaticResource BorderDarkBrush}" Margin="0,4,16,4"/>

                    <!-- Search -->
                    <Border DockPanel.Dock="Left"
                            CornerRadius="7"
                            BorderBrush="{StaticResource BorderDarkBrush}"
                            BorderThickness="1"
                            Background="{StaticResource CardBackgroundBrush}"
                            Width="240" Height="32"
                            Margin="0,0,0,0"
                            VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="{StaticResource AISearch}"
                                   Width="16" Height="16" Margin="10,0,6,0"
                                   VerticalAlignment="Center" Opacity="0.55"/>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource GradiantTextboxStyle1}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center"
                                     BorderThickness="0" Background="Transparent" Padding="0"/>
                            <Button Grid.Column="2" Width="24" Height="24"
                                    Margin="4,0,4,0" Padding="0" Opacity="0.7"
                                    Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding ClearSearchCommand}" ToolTip="Clear search">
                                <Image Source="{StaticResource Clear}" Width="14" Height="14"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Action buttons -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Width="88" Height="32" Margin="0,0,8,0"
                                Style="{StaticResource GradientBorderButtonStyleGreen}"
                                Command="{Binding AddCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource Add}" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Add" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <Button Width="88" Height="32" Margin="0,0,8,0"
                                Style="{StaticResource GradientBorderButtonStyleBLueCyan}"
                                Command="{Binding EditCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource EditAI}" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Edit" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <Button Width="88" Height="32"
                                Style="{StaticResource GradientBorderButtonStyleRed}"
                                Command="{Binding DeleteCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource DeleteClose}" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Remove" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </DockPanel>
            </Grid>
        </Border>

        <!-- ══ DATA GRID ══ -->
        <Border Grid.Row="1"
                CornerRadius="10"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="1"
                ClipToBounds="True">

            <DataGrid ItemsSource="{Binding Devices}"
                      AutoGenerateColumns="False"
                      SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                      Style="{StaticResource DarkDataGridStyle}"
                      RowStyle="{StaticResource CompactDataGridRowStyle}"
                      CellStyle="{StaticResource CompactDataGridCellStyle}"
                      ColumnHeaderStyle="{StaticResource CompactDataGridHeaderStyle}">
                <DataGrid.Columns>

                    <!-- ID chip -->
                    <DataGridTemplateColumn Header="ID" Width="80" SortMemberPath="DeviceId" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#1A237EF2" BorderBrush="#30237EF2" BorderThickness="1"
                                        CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DeviceId}" Foreground="#5AA7FF"
                                               FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Type — teal chip -->
                    <DataGridTemplateColumn Header="Type" Width="110" SortMemberPath="DeviceTypeText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TypeChipBorder}">
                                    <TextBlock Text="{Binding DeviceTypeText}"
                                               Foreground="#00E5D4" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Brand" Binding="{Binding Brand}" Width="150"/>
                    <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="160"/>

                    <!-- Condition pill -->
                    <DataGridTemplateColumn Header="Condition" Width="110" SortMemberPath="Condition">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                        CornerRadius="10" Padding="10,3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1A5AA7FF"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Condition}" Value="New">
                                                    <Setter Property="Background" Value="#1A22C55E"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Condition}" Value="Faulty">
                                                    <Setter Property="Background" Value="#2AEF4444"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Condition}" Value="Used">
                                                    <Setter Property="Background" Value="#1AF97316"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Condition}" FontSize="11" FontWeight="SemiBold"
                                               HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#5AA7FF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Condition}" Value="New">
                                                        <Setter Property="Foreground" Value="#22C55E"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Condition}" Value="Faulty">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Condition}" Value="Used">
                                                        <Setter Property="Foreground" Value="#F97316"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Holder -->
                    <DataGridTemplateColumn Header="Holder" Width="110" SortMemberPath="HolderID">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#14FFFFFF" CornerRadius="4" Padding="6,2"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding HolderID}" FontFamily="Consolas" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Added date -->
                    <DataGridTextColumn Header="Added" Binding="{Binding AddedAt}" Width="150"/>

                    <!-- Price -->
                    <DataGridTemplateColumn Header="Price" Width="90" SortMemberPath="Price">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Price, StringFormat={}${0:F2}}"
                                           Foreground="{StaticResource Gradient.Primary}"
                                           FontWeight="SemiBold" FontSize="12"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Margin="0,0,6,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="240"/>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ══ STATUS BAR ══ -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Border Height="1" VerticalAlignment="Top">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#00F97316" Offset="0"/>
                        <GradientStop Color="#30F97316" Offset="0.3"/>
                        <GradientStop Color="#30EF4444" Offset="0.7"/>
                        <GradientStop Color="#00EF4444" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <DockPanel Margin="4,5,4,0">
                <Border DockPanel.Dock="Left" Background="#14F97316"
                        BorderBrush="#25F97316" BorderThickness="1"
                        CornerRadius="6" Padding="10,3">
                    <TextBlock Text="{Binding DevicesCountDisplay}"
                               Foreground="#F97316" FontWeight="SemiBold" FontSize="11"/>
                </Border>
            </DockPanel>
        </Grid>

    </Grid>
</UserControl>
