<UserControl x:Class="ESCenter.Views.BoneyardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ESCenter.ViewModels"
             Height="Auto"
             Width="Auto">

    <UserControl.DataContext>
        <vm:BoneyardViewModel/>
    </UserControl.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== TOOLBAR ===================== -->
        <Border Grid.Row="0"
                Padding="10"
                CornerRadius="8"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="1"
                Margin="0,0,0,10">

            <DockPanel LastChildFill="False">

                <!-- Left: Title + Search -->
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Left"
                            VerticalAlignment="Center">

                    <!-- Title -->
                    <TextBlock Text="Boneyard"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource NewPrimaryBlueBrush}"
                               Margin="0,0,16,0"/>

                    <!-- Search with icon -->
                    <Grid Width="260">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Source="{StaticResource search_insights}"
                               Width="16"
                               Height="16"
                               Margin="8,0,6,0"
                               VerticalAlignment="Center"/>

                        <TextBox Grid.Column="1"
                                 Padding="6,4"
                                 VerticalAlignment="Center"
                                 Style="{StaticResource NeonTextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                </StackPanel>

                <!-- Right: Actions -->
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right">

                    <!-- Add -->
                    <Button Width="90"
                            Margin="0,0,8,0"
                            Style="{StaticResource NeonGreenButtonStyle}"
                            Command="{Binding AddCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{StaticResource AddTask}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Add"/>
                        </StackPanel>
                    </Button>

                    <!-- Edit -->
                    <Button Width="90"
                            Margin="0,0,8,0"
                            Style="{StaticResource NeonCyanButtonStyle}"
                            Command="{Binding EditCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{StaticResource edit_document}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Edit"/>
                        </StackPanel>
                    </Button>

                    <!-- Remove -->
                    <Button Width="90"
                            Style="{StaticResource NeonRedButtonStyle}"
                            Command="{Binding DeleteCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{StaticResource Delete}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Remove"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ===================== GRID ===================== -->
        <Border Grid.Row="1"
                CornerRadius="8"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="1">

            <DataGrid ItemsSource="{Binding Devices}"
                      AutoGenerateColumns="False"
                      SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                      Style="{StaticResource DarkDataGridStyle}"
                      RowStyle="{StaticResource CompactDataGridRowStyle}"
                      CellStyle="{StaticResource CompactDataGridCellStyle}"
                      ColumnHeaderStyle="{StaticResource CompactDataGridHeaderStyle}">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding DeviceId}"
                                        Width="70"
                                        IsReadOnly="True"/>

                    <DataGridTextColumn Header="Type"
                                        Binding="{Binding DeviceType}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Brand"
                                        Binding="{Binding Brand}"
                                        Width="160"/>

                    <DataGridTextColumn Header="Model"
                                        Binding="{Binding Model}"
                                        Width="160"/>

                    <DataGridTextColumn Header="Condition"
                                        Binding="{Binding Condition}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Holder"
                                        Binding="{Binding HolderID}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Added"
                                        Binding="{Binding AddedAt}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Price"
                                        Binding="{Binding Price, StringFormat={}{0:F2}}"
                                        Width="90"/>

                    <DataGridTextColumn Header="Notes"
                                        Binding="{Binding Notes}"
                                        Width="260"/>

                </DataGrid.Columns>
            </DataGrid>

        </Border>

        <!-- ===================== STATUS BAR ===================== -->
        <DockPanel Grid.Row="2"
                   Margin="4,8,4,0">

            <TextBlock Text="{Binding DevicesCountDisplay}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       DockPanel.Dock="Left"/>

        </DockPanel>
    </Grid>
</UserControl>
