<UserControl x:Class="ESCenter.Views.TicketFormPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Section header style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin"       Value="0,14,0,6"/>
        </Style>

        <!-- Section divider -->
        <Style x:Key="SectionLine" TargetType="Border">
            <Setter Property="Height"     Value="1"/>
            <Setter Property="Margin"     Value="0,14,0,8"/>
            <Setter Property="Background" Value="{StaticResource BorderDarkBrush}"/>
        </Style>

        <!-- Field row margin -->
        <Thickness x:Key="FieldMargin">0,0,0,8</Thickness>

        <!-- Label style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"           Value="11"/>
            <Setter Property="Foreground"         Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment"  Value="Center"/>
            <Setter Property="Margin"             Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <!-- 0 Ready for Pickup -->
            <RowDefinition Height="Auto"/>
            <!-- 1 ESC Code -->
            <RowDefinition Height="Auto"/>

            <!-- Section: Customer -->
            <RowDefinition Height="Auto"/>
            <!-- 3 Customer ID -->
            <RowDefinition Height="Auto"/>
            <!-- 4 Customer Name -->
            <RowDefinition Height="Auto"/>
            <!-- 5 Phone -->
            <RowDefinition Height="Auto"/>
            <!-- 6 Contact Method -->
            <RowDefinition Height="Auto"/>

            <!-- Section: Device -->
            <RowDefinition Height="Auto"/>
            <!-- 8 Device Category -->
            <RowDefinition Height="Auto"/>
            <!-- 9 Device Brand -->
            <RowDefinition Height="Auto"/>
            <!-- 10 Device Model -->
            <RowDefinition Height="Auto"/>
            <!-- 11 Damage History -->
            <RowDefinition Height="Auto"/>
            <!-- 12 Serial / IMEI -->
            <RowDefinition Height="Auto"/>
            <!-- 13 Problem Description -->
            <RowDefinition Height="Auto"/>

            <!-- Section: Notes & Board -->
            <RowDefinition Height="Auto"/>
            <!-- 15 Notes -->
            <RowDefinition Height="Auto"/>
            <!-- 16 Board Modifications -->
            <RowDefinition Height="Auto"/>

            <!-- Section: Repair -->
            <RowDefinition Height="Auto"/>
            <!-- 18 Repair Status -->
            <RowDefinition Height="Auto"/>
            <!-- 19 Priority -->
            <RowDefinition Height="Auto"/>
            <!-- 20 Estimated Cost -->
            <RowDefinition Height="Auto"/>
            <!-- 21 Final Cost -->
            <RowDefinition Height="Auto"/>
            <!-- 22 Warranty -->
            <RowDefinition Height="Auto"/>
            <!-- 23 Repair on Warranty -->
            <RowDefinition Height="Auto"/>
            <!-- 24 Root Cause -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Ready for Pickup ── -->
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal"
                    Margin="0,4,0,8" VerticalAlignment="Center">
            <Image Source="{StaticResource ReadyToPick}" Width="14" Height="14" Margin="0,0,5,0"/>
            <TextBlock Text="Ready for Pickup:" Style="{StaticResource FieldLabel}" Margin="0"/>
        </StackPanel>
        <CheckBox Grid.Row="0" Grid.Column="1"
                  IsChecked="{Binding IsReadyForPickup, Mode=TwoWay}"
                  Margin="4,0,0,8" Style="{StaticResource GradientCheckBoxSuccessStyle}"
                  TabIndex="21" KeyDown="SaveOrAddOnEnter"/>

        <!-- ── ESC Code ── -->
        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal"
                    Margin="0,0,0,8" VerticalAlignment="Center">
            <Image Source="{StaticResource ESCID2}" Width="14" Height="14" Margin="0,0,5,0"/>
            <TextBlock Text="ESC Code:" Style="{StaticResource FieldLabel}" Margin="0"/>
        </StackPanel>
        <TextBox Grid.Row="1" Grid.Column="1"
                 Text="{Binding EscTicketId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Margin="4,0,0,8" Style="{StaticResource GradiantTextboxStyle1}"
                 ToolTip="Format: ESC-000001" Focusable="False" IsTabStop="False"/>

        <!-- ─── SECTION: Customer ─── -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource SectionLine}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#305AA7FF" Offset="0"/>
                    <GradientStop Color="#005AA7FF" Offset="0.5"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="👤 CUSTOMER" Style="{StaticResource SectionHeader}"
                   Foreground="#5AA7FF" Margin="0,14,0,6"/>

        <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
            <Image Source="{StaticResource IDTitle}" Width="13" Height="13" Margin="0,0,5,0"/>
            <TextBlock Text="Customer ID:" Style="{StaticResource FieldLabel}" Margin="0"/>
        </StackPanel>
        <TextBox Grid.Row="3" Grid.Column="1"
                 Text="{Binding CustomerIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Margin="4,0,0,8" Style="{StaticResource GradiantTextboxStyle1}"
                 TabIndex="1" KeyDown="SingleLineTextBox_KeyDown"/>

        <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
            <Image Source="{StaticResource AddressBook}" Width="13" Height="13" Margin="0,0,5,0"/>
            <TextBlock Text="Customer Name:" Style="{StaticResource FieldLabel}" Margin="0"/>
            <TextBlock Text=" *" Foreground="#FF5A5A" FontWeight="Bold" VerticalAlignment="Center" FontSize="13"/>
        </StackPanel>
        <TextBox x:Name="CustomerNameBox" Grid.Row="4" Grid.Column="1"
                 Text="{Binding CustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Margin="4,0,0,8" Style="{StaticResource GradiantTextboxStyle1}"
                 TabIndex="2" KeyDown="SingleLineTextBox_KeyDown"/>

        <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
            <Image Source="{StaticResource PhoneNumber}" Width="13" Height="13" Margin="0,0,5,0"/>
            <TextBlock Text="Phone Number:" Style="{StaticResource FieldLabel}" Margin="0"/>
            <TextBlock Text=" *" Foreground="#FF5A5A" FontWeight="Bold" VerticalAlignment="Center" FontSize="13"/>
        </StackPanel>
        <TextBox Grid.Row="5" Grid.Column="1"
                 Text="{Binding PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Margin="4,0,0,8" Style="{StaticResource GradiantTextboxStyle1}"
                 TabIndex="3" KeyDown="SingleLineTextBox_KeyDown"/>

        <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
            <Image Source="{StaticResource ContactAI}" Width="13" Height="13" Margin="0,0,5,0"/>
            <TextBlock Text="Contact Method:" Style="{StaticResource FieldLabel}" Margin="0"/>
        </StackPanel>
        <ComboBox Grid.Row="6" Grid.Column="1"
                  SelectedItem="{Binding ContactMethod, Mode=TwoWay}"
                  Margin="4,0,0,8" Style="{StaticResource GradiantComboboxStyle11}" TabIndex="4">
            <ComboBox.ItemsSource>
                <x:Array Type="{x:Type sys:String}">
                    <sys:String>Call</sys:String>
                    <sys:String>WhatsApp</sys:String>
                    <sys:String>SMS</sys:String>
                    <sys:String>Email</sys:String>
                    <sys:String>None</sys:String>
                </x:Array>
            </ComboBox.ItemsSource>
        </ComboBox>

        <!-- ─── SECTION: Device ─── -->
        <Border Grid.Row="7" Grid.ColumnSpan="2" Style="{StaticResource SectionLine}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#3000E5D4" Offset="0"/>
                    <GradientStop Color="#0000E5D4" Offset="0.5"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <TextBlock Grid.Row="7" Grid.Column="0" Text="📱 DEVICE" Style="{StaticResource SectionHeader}"
                   Foreground="#00E5D4" Margin="0,14,0,6"/>

        <StackPanel Grid.Row="8" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
            <Image Source="{StaticResource CategoryList}" Width="13" Height="13" Margin="0,0,5,0"/>
            <TextBlock Text="Device Category:" Style="{StaticResource FieldLabel}" Margin="0"/>
            <TextBlock Text=" *" Foreground="#FF5A5A" FontWeight="Bold" VerticalAlignment="Center" FontSize="13"/>
        </StackPanel>
        <TextBox Grid.Row="8" Grid.Column="1"
                 Text="{Binding DeviceCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Margin="4,0,0,8" Style="{StaticResource GradiantTextboxStyle1}"
                 TabIndex="5" KeyDown="SingleLineTextBox_KeyDown"/>

        <StackPanel Grid.Row="9" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
            <Image Source="{StaticResource Brand}" Width="13" Height="13" Margin="0,0,5,0"/>
            <TextBlock Text="Device Brand:" Style="{StaticResource FieldLabel}" Margin="0"/>
            <TextBlock Text=" *" Foreground="#FF5A5A" FontWeight="Bold" VerticalAlignment="Center" FontSize="13"/>
        </StackPanel>
        <TextBox Grid.Row="9" Grid.Column="1"
                 Text="{Binding DeviceBrand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Margin="4,0,0,8" Style="{StaticResource GradiantTextboxStyle1}"
                 TabIndex="6" KeyDown="SingleLineTextBox_KeyDown"/>

        <StackPanel Grid.Row="10" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
            <Image Source="{StaticResource Model}" Width="13" Height="13" Margin="0,0,5,0"/>
            <TextBlock Text="Device Model:" Style="{StaticResource FieldLabel}" Margin="0"/>
        </StackPanel>
        <TextBox Grid.Row="10" Grid.Column="1"
                 Text="{Binding DeviceModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Margin="4,0,0,8" Style="{StaticResource GradiantTextboxStyle1}"
                 TabIndex="7" KeyDown="SingleLineTextBox_KeyDown"/>

        <StackPanel Grid.Row="11" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Top">
            <Image Source="{StaticResource DmgHistory2}" Width="13" Height="13" Margin="0,0,5,0"/>
            <TextBlock Text="Damage History:" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Top"/>
        </StackPanel>
        <TextBox Grid.Row="11" Grid.Column="1"
                 Text="{Binding DamageHistory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Margin="4,0,0,8" Height="55" TextWrapping="Wrap" AcceptsReturn="True"
                 Style="{StaticResource GradiantTextboxStyle1}"/>

        <StackPanel Grid.Row="12" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
            <Image Source="{StaticResource SerialTitle  }" Width="13" Height="13" Margin="0,0,5,0"/>
            <TextBlock Text="Serial / IMEI:" Style="{StaticResource FieldLabel}" Margin="0"/>
            <TextBlock Text=" *" Foreground="#FF5A5A" FontWeight="Bold" VerticalAlignment="Center" FontSize="13"/>
        </StackPanel>
        <TextBox Grid.Row="12" Grid.Column="1"
                 Text="{Binding SerialIMEI, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Margin="4,0,0,8" Style="{StaticResource GradiantTextboxStyle1}"
                 TabIndex="8" KeyDown="SingleLineTextBox_KeyDown"/>

        <StackPanel Grid.Row="13" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Top">
            <Image Source="{StaticResource ProblemDescription}" Width="13" Height="13" Margin="0,0,5,0"/>
            <TextBlock Text="Problem Desc:" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Top"/>
        </StackPanel>
        <TextBox Grid.Row="13" Grid.Column="1"
                 Text="{Binding ProblemDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Margin="4,0,0,8" Height="55" TextWrapping="Wrap" AcceptsReturn="True"
                 Style="{StaticResource GradiantTextboxStyle1}" TabIndex="9"/>

        <!-- ─── SECTION: Notes & Board ─── -->
        <Border Grid.Row="14" Grid.ColumnSpan="2" Style="{StaticResource SectionLine}"/>
        <TextBlock Grid.Row="14" Grid.Column="0" Text="📋 NOTES" Style="{StaticResource SectionHeader}" Margin="0,14,0,6"/>

        <StackPanel Grid.Row="15" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Top">
            <Image Source="{StaticResource Notes}" Width="13" Height="13" Margin="0,0,5,0"/>
            <TextBlock Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Top"
                       TextWrapping="Wrap" Width="110" Height="55">Notes: ( Passwords, Diagnoses, Email )</TextBlock>
        </StackPanel>
        <TextBox Grid.Row="15" Grid.Column="1"
                 Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Margin="4,0,0,8" Height="55" TextWrapping="Wrap" AcceptsReturn="True"
                 Style="{StaticResource GradiantTextboxStyle1}" TabIndex="10"/>

        <StackPanel Grid.Row="16" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Top">
            <Image Source="{StaticResource BoardMod}" Width="13" Height="13" Margin="0,0,5,0"/>
            <TextBlock Text="Board Mods:" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Top"/>
        </StackPanel>
        <TextBox Grid.Row="16" Grid.Column="1"
                 Text="{Binding BoardModifications, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Margin="4,0,0,8" Height="55" TextWrapping="Wrap" AcceptsReturn="True"
                 Style="{StaticResource GradiantTextboxStyle1}"/>

        <!-- ─── SECTION: Repair ─── -->
        <Border Grid.Row="17" Grid.ColumnSpan="2" Style="{StaticResource SectionLine}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#30F97316" Offset="0"/>
                    <GradientStop Color="#00F97316" Offset="0.5"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <TextBlock Grid.Row="17" Grid.Column="0" Text="🔧 REPAIR" Style="{StaticResource SectionHeader}"
                   Foreground="#F97316" Margin="0,14,0,6"/>

        <StackPanel Grid.Row="18" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
            <Image Source="{StaticResource RepairStatus}" Width="13" Height="13" Margin="0,0,5,0"/>
            <TextBlock Text="Repair Status:" Style="{StaticResource FieldLabel}" Margin="0"/>
        </StackPanel>
        <ComboBox Grid.Row="18" Grid.Column="1"
                  SelectedItem="{Binding RepairStatus, Mode=TwoWay}"
                  Margin="4,0,0,8" Style="{StaticResource GradiantComboboxStyle11}" TabIndex="11">
            <ComboBox.ItemsSource>
                <x:Array Type="{x:Type sys:String}">
                    <sys:String>Received</sys:String>
                    <sys:String>Diagnosing</sys:String>
                    <sys:String>Waiting for Parts</sys:String>
                    <sys:String>In Repair</sys:String>
                    <sys:String>Testing</sys:String>
                    <sys:String>Waiting For Client Approval</sys:String>
                    <sys:String>Ready for Pickup</sys:String>
                    <sys:String>Completed</sys:String>
                    <sys:String>Cancelled</sys:String>
                </x:Array>
            </ComboBox.ItemsSource>
        </ComboBox>

        <StackPanel Grid.Row="19" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
            <Image Source="{StaticResource Priority}" Width="13" Height="13" Margin="0,0,5,0"/>
            <TextBlock Text="Priority:" Style="{StaticResource FieldLabel}" Margin="0"/>
        </StackPanel>
        <ComboBox Grid.Row="19" Grid.Column="1"
                  SelectedItem="{Binding PriorityLevel, Mode=TwoWay}"
                  Width="130" HorizontalAlignment="Left"
                  Margin="4,0,0,8" Style="{StaticResource GradiantComboboxStyle11}" TabIndex="12">
            <ComboBox.ItemsSource>
                <x:Array Type="{x:Type sys:String}">
                    <sys:String>Minor</sys:String>
                    <sys:String>Normal</sys:String>
                    <sys:String>Major</sys:String>
                    <sys:String>Critical</sys:String>
                </x:Array>
            </ComboBox.ItemsSource>
        </ComboBox>

        <StackPanel Grid.Row="20" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
            <Image Source="{StaticResource EstimatedCost}" Width="13" Height="13" Margin="0,0,5,0"/>
            <TextBlock Text="Estimated Cost:" Style="{StaticResource FieldLabel}" Margin="0"/>
        </StackPanel>
        <StackPanel Grid.Row="20" Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,8">
            <TextBox Width="120" Margin="0,0,6,0"
                     Text="{Binding EstimatedCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                     Style="{StaticResource GradiantTextboxStyle1}" TabIndex="14"
                     KeyDown="SingleLineTextBox_KeyDown"/>
            <ComboBox Width="80" SelectedItem="{Binding EstimatedCostCurrency, Mode=TwoWay}"
                      Style="{StaticResource GradiantComboboxStyle11}" ItemsSource="{Binding Currencies}"/>
            <TextBlock Text="{Binding EstimatedCostEquivalent}" Foreground="#FFD54A"
                       FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="21" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
            <Image Source="{StaticResource FinalCost}" Width="13" Height="13" Margin="0,0,5,0"/>
            <TextBlock Text="Final Cost:" Style="{StaticResource FieldLabel}" Margin="0"/>
        </StackPanel>
        <StackPanel Grid.Row="21" Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,8">
            <TextBox Width="120" Margin="0,0,6,0"
                     Text="{Binding FinalCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                     Style="{StaticResource GradiantTextboxStyle1}" TabIndex="15"
                     KeyDown="SingleLineTextBox_KeyDown"/>
            <ComboBox Width="80" SelectedItem="{Binding FinalCostCurrency, Mode=TwoWay}"
                      Style="{StaticResource GradiantComboboxStyle11}" ItemsSource="{Binding Currencies}"/>
            <TextBlock Text="{Binding FinalCostEquivalent}" Foreground="#FFD54A"
                       FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="22" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
            <Image Source="{StaticResource Warranty}" Width="18" Height="18" Margin="-3,0,3,0"/>
            <TextBlock Text="Warranty:" Style="{StaticResource FieldLabel}" Margin="0"/>
        </StackPanel>
        <StackPanel Grid.Row="22" Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,8">
            <CheckBox IsChecked="{Binding HasWarranty}"
                      Style="{StaticResource GradientCheckBoxStyle}"
                      Margin="0,0,8,0" TabIndex="18"/>
            <ComboBox Width="160" IsEnabled="{Binding HasWarranty}"
                      SelectedItem="{Binding WarrantyPeriod, Mode=TwoWay}"
                      Style="{StaticResource GradiantComboboxStyle11}" TabIndex="19">
                <ComboBox.ItemsSource>
                    <x:Array Type="{x:Type sys:String}">
                        <sys:String>1 Day</sys:String>
                        <sys:String>7 Days</sys:String>
                        <sys:String>14 Days</sys:String>
                        <sys:String>30 Days</sys:String>
                        <sys:String>90 Days</sys:String>
                        <sys:String>6 Months</sys:String>
                        <sys:String>1 Year</sys:String>
                    </x:Array>
                </ComboBox.ItemsSource>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="23" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
            <Image Source="{StaticResource RepOnWar}" Width="13" Height="13" Margin="0,0,5,0"/>
            <TextBlock Text="Rep. on Warranty:" Style="{StaticResource FieldLabel}" Margin="0"/>
        </StackPanel>
        <CheckBox Grid.Row="23" Grid.Column="1"
                  IsChecked="{Binding IsWarrantyRepair}"
                  Margin="4,0,0,8" Style="{StaticResource GradientCheckBoxStyle}" TabIndex="20"/>

        <StackPanel Grid.Row="24" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,0" VerticalAlignment="Center">
            <Image Source="{StaticResource RootCause}" Width="13" Height="13" Margin="0,0,5,0"/>
            <TextBlock Text="Root Cause:" Style="{StaticResource FieldLabel}" Margin="0"/>
        </StackPanel>
        <ComboBox Grid.Row="24" Grid.Column="1"
                  SelectedItem="{Binding RootCause, Mode=TwoWay}"
                  Margin="4,0,0,0" Style="{StaticResource GradiantComboboxStyle11}" TabIndex="16">
            <ComboBox.ItemsSource>
                <x:Array Type="{x:Type sys:String}">
                    <sys:String>Electrical Cause</sys:String>
                    <sys:String>Mechanical Cause</sys:String>
                    <sys:String>Environmental Cause</sys:String>
                    <sys:String>Human Cause</sys:String>
                </x:Array>
            </ComboBox.ItemsSource>
        </ComboBox>

    </Grid>
</UserControl>
