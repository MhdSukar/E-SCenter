<UserControl x:Class="ESCenter.Views.TicketFormPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="Transparent">
    <Grid Margin="0,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0" Margin="0,6" VerticalAlignment="Center">
            <Image Source="{StaticResource ReadyToPick}" Width="16" Height="16" Margin="0,0,6,0" />
            <TextBlock Text="Ready for Pickup:" VerticalAlignment="Center" Foreground="{StaticResource Gradient.Success}" />
        </StackPanel>
        <CheckBox IsChecked="{Binding IsReadyForPickup, Mode=TwoWay}" Grid.Row="0" Grid.Column="1" Margin="4" Style="{StaticResource NeonCheckBoxStyle}" TabIndex="21" KeyDown="SaveOrAddOnEnter" />

        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0" Margin="0,6" VerticalAlignment="Center">
            <Image Source="{StaticResource ESCID2}" Width="17" Height="17" Margin="0,0,6,0" />
            <TextBlock Text="ESC Code:" VerticalAlignment="Center" />
        </StackPanel>
        <TextBox Text="{Binding EscTicketId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Margin="4" Style="{StaticResource NeonDarkCyanTextBoxStyle}" ToolTip="Format: ESC-000001" Focusable="False" IsTabStop="False" />

        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="0" Margin="0,6" VerticalAlignment="Center"><Image Source="{StaticResource IDTitle}" Width="16" Height="16" Margin="0,0,6,0" /><TextBlock Text="Customer ID:" VerticalAlignment="Center" /></StackPanel>
        <TextBox Text="{Binding CustomerIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1" Margin="4" Style="{StaticResource NeonDarkCyanTextBoxStyle}" TabIndex="1" KeyDown="SingleLineTextBox_KeyDown" />

        <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="0" Margin="0,6" VerticalAlignment="Center"><Image Source="{StaticResource AddressBook}" Width="16" Height="16" Margin="0,0,6,0" /><TextBlock Text="Customer Name:" VerticalAlignment="Center" /><TextBlock Text=" *" Foreground="#FF5A5A" FontWeight="Bold" VerticalAlignment="Center" FontSize="13" /></StackPanel>
        <TextBox x:Name="CustomerNameBox" Text="{Binding CustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="1" Margin="4" Style="{StaticResource NeonDarkCyanTextBoxStyle}" TabIndex="2" KeyDown="SingleLineTextBox_KeyDown" />

        <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="0" Margin="0,6" VerticalAlignment="Center"><Image Source="{StaticResource PhoneNumber}" Width="16" Height="16" Margin="0,0,6,0" /><TextBlock Text="Phone Number:" VerticalAlignment="Center" /><TextBlock Text=" *" Foreground="#FF5A5A" FontWeight="Bold" VerticalAlignment="Center" FontSize="13" /></StackPanel>
        <TextBox Text="{Binding PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="4" Grid.Column="1" Margin="4" Style="{StaticResource NeonDarkCyanTextBoxStyle}" TabIndex="3" KeyDown="SingleLineTextBox_KeyDown" />

        <StackPanel Orientation="Horizontal" Grid.Row="5" Grid.Column="0" Margin="0,6" VerticalAlignment="Center"><Image Source="{StaticResource ContactAI}" Width="16" Height="16" Margin="0,0,6,0" /><TextBlock Text="Contact Method:" VerticalAlignment="Center" /></StackPanel>
        <ComboBox SelectedItem="{Binding ContactMethod, Mode=TwoWay}" Grid.Row="5" Grid.Column="1" Margin="4" Style="{StaticResource NeonDarkCyanComboBoxStyle}" TabIndex="4"><ComboBox.ItemsSource><x:Array Type="{x:Type sys:String}"><sys:String>Call</sys:String><sys:String>WhatsApp</sys:String><sys:String>SMS</sys:String><sys:String>Email</sys:String><sys:String>None</sys:String></x:Array></ComboBox.ItemsSource></ComboBox>

        <StackPanel Orientation="Horizontal" Grid.Row="6" Grid.Column="0" Margin="0,6" VerticalAlignment="Center"><Image Source="{StaticResource CategoryList}" Width="16" Height="16" Margin="0,0,6,0" /><TextBlock Text="Device Category:" VerticalAlignment="Center" /><TextBlock Text=" *" Foreground="#FF5A5A" FontWeight="Bold" VerticalAlignment="Center" FontSize="13" /></StackPanel>
        <TextBox Text="{Binding DeviceCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="6" Grid.Column="1" Margin="4" Style="{StaticResource NeonDarkCyanTextBoxStyle}" TabIndex="5" KeyDown="SingleLineTextBox_KeyDown" />

        <StackPanel Orientation="Horizontal" Grid.Row="7" Grid.Column="0" Margin="0,6" VerticalAlignment="Center"><Image Source="{StaticResource Brand}" Width="16" Height="16" Margin="0,0,6,0" /><TextBlock Text="Device Brand:" VerticalAlignment="Center" /><TextBlock Text=" *" Foreground="#FF5A5A" FontWeight="Bold" VerticalAlignment="Center" FontSize="13" /></StackPanel>
        <TextBox Text="{Binding DeviceBrand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="7" Grid.Column="1" Margin="4" Style="{StaticResource NeonDarkCyanTextBoxStyle}" TabIndex="6" KeyDown="SingleLineTextBox_KeyDown" />

        <StackPanel Orientation="Horizontal" Grid.Row="8" Grid.Column="0" Margin="0,6" VerticalAlignment="Center"><Image Source="{StaticResource Model}" Width="16" Height="16" Margin="0,0,6,0" /><TextBlock Text="Device Model:" VerticalAlignment="Center" /></StackPanel>
        <TextBox Text="{Binding DeviceModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="8" Grid.Column="1" Margin="4" Style="{StaticResource NeonDarkCyanTextBoxStyle}" TabIndex="7" KeyDown="SingleLineTextBox_KeyDown" />

        <StackPanel Orientation="Horizontal" Grid.Row="9" Grid.Column="0" Margin="0,6" VerticalAlignment="Top"><Image Source="{StaticResource DmgHistory2}" Width="16" Height="16" Margin="0,0,6,0" /><TextBlock Text="Damage History:" VerticalAlignment="Top" /></StackPanel>
        <TextBox Text="{Binding DamageHistory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="9" Grid.Column="1" Margin="4" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Style="{StaticResource NeonDarkCyanTextBoxStyle}" />

        <StackPanel Orientation="Horizontal" Grid.Row="10" Grid.Column="0" Margin="0,6" VerticalAlignment="Center"><Image Source="{StaticResource SerialTitle  }" Width="16" Height="16" Margin="0,0,6,0" /><TextBlock Text="Serial / IMEI:" VerticalAlignment="Center" /><TextBlock Text=" *" Foreground="#FF5A5A" FontWeight="Bold" VerticalAlignment="Center" FontSize="13" /></StackPanel>
        <TextBox Text="{Binding SerialIMEI, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="10" Grid.Column="1" Margin="4" Style="{StaticResource NeonDarkCyanTextBoxStyle}" TabIndex="8" KeyDown="SingleLineTextBox_KeyDown" />

        <StackPanel Orientation="Horizontal" Grid.Row="11" Grid.Column="0" Margin="0,6" VerticalAlignment="Top"><Image Source="{StaticResource ProblemDescription}" Width="16" Height="16" Margin="0,0,6,0" /><TextBlock Text="Problem Description:" VerticalAlignment="Top" /></StackPanel>
        <TextBox Text="{Binding ProblemDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="11" Grid.Column="1" Margin="4" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Style="{StaticResource NeonDarkCyanTextBoxStyle}" TabIndex="9" />

        <StackPanel Orientation="Horizontal" Grid.Row="12" Grid.Column="0" Margin="0,6" VerticalAlignment="Top"><Image Source="{StaticResource Notes}" Width="16" Height="16" Margin="0,0,6,0" /><TextBlock Text="Notes: ( Device Passwords, Device Diagnoses, Email )" TextWrapping="Wrap" VerticalAlignment="Top" Width="110" Height="60" /></StackPanel>
        <TextBox Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="12" Grid.Column="1" Margin="4" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Style="{StaticResource NeonDarkCyanTextBoxStyle}" TabIndex="10" />

        <StackPanel Orientation="Horizontal" Grid.Row="13" Grid.Column="0" Margin="0,6" VerticalAlignment="Top"><Image Source="{StaticResource BoardMod}" Width="16" Height="16" Margin="0,0,6,0" /><TextBlock Text="Board Modifications:" VerticalAlignment="Top" /></StackPanel>
        <TextBox Text="{Binding BoardModifications, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="13" Grid.Column="1" Margin="4" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Style="{StaticResource NeonDarkCyanTextBoxStyle}" />

        <StackPanel Orientation="Horizontal" Grid.Row="14" Grid.Column="0" Margin="0,6" VerticalAlignment="Center"><Image Source="{StaticResource RepairStatus}" Width="16" Height="16" Margin="0,0,6,0" /><TextBlock Text="Repair Status:" VerticalAlignment="Center" /></StackPanel>
        <ComboBox SelectedItem="{Binding RepairStatus, Mode=TwoWay}" Grid.Row="14" Grid.Column="1" Margin="4" Style="{StaticResource NeonDarkCyanComboBoxStyle}" TabIndex="11"><ComboBox.ItemsSource><x:Array Type="{x:Type sys:String}"><sys:String>Received</sys:String><sys:String>Diagnosing</sys:String><sys:String>Waiting for Parts</sys:String><sys:String>In Repair</sys:String><sys:String>Testing</sys:String><sys:String>Waiting For Client Approval</sys:String><sys:String>Ready for Pickup</sys:String><sys:String>Completed</sys:String><sys:String>Cancelled</sys:String></x:Array></ComboBox.ItemsSource></ComboBox>

        <StackPanel Orientation="Horizontal" Grid.Row="15" Grid.Column="0" Margin="0,6" VerticalAlignment="Center"><Image Source="{StaticResource Priority}" Width="16" Height="16" Margin="0,0,6,0" /><TextBlock Text="Priority:" VerticalAlignment="Center" /></StackPanel>
        <ComboBox SelectedItem="{Binding PriorityLevel, Mode=TwoWay}" Grid.Row="15" Grid.Column="1" Width="130" Margin="4" HorizontalAlignment="Left" Style="{StaticResource NeonDarkCyanComboBoxStyle}" TabIndex="12"><ComboBox.ItemsSource><x:Array Type="{x:Type sys:String}"><sys:String>Minor</sys:String><sys:String>Normal</sys:String><sys:String>Major</sys:String><sys:String>Critical</sys:String></x:Array></ComboBox.ItemsSource></ComboBox>

        <StackPanel Orientation="Horizontal" Grid.Row="16" Grid.Column="0" Margin="0,6" VerticalAlignment="Center"><Image Source="{StaticResource EstimatedCost}" Width="16" Height="16" Margin="0,0,6,0" /><TextBlock Text="Estimated Cost:" VerticalAlignment="Center" /></StackPanel>
        <StackPanel Grid.Row="16" Grid.Column="1" Orientation="Horizontal" Margin="4">
            <TextBox Text="{Binding EstimatedCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Width="120" Margin="0,0,6,0" Style="{StaticResource NeonDarkCyanTextBoxStyle}" TabIndex="14" KeyDown="SingleLineTextBox_KeyDown" />
            <ComboBox Width="80" SelectedItem="{Binding EstimatedCostCurrency, Mode=TwoWay}" Style="{StaticResource NeonDarkCyanComboBoxStyle}" ItemsSource="{Binding Currencies}"/>
            <TextBlock Text="{Binding EstimatedCostEquivalent}" Foreground="#FFD54A" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="17" Grid.Column="0" Margin="0,6" VerticalAlignment="Center"><Image Source="{StaticResource FinalCost}" Width="16" Height="16" Margin="0,0,6,0" /><TextBlock Text="Final Cost:" VerticalAlignment="Center" /></StackPanel>
        <StackPanel Grid.Row="17" Grid.Column="1" Orientation="Horizontal" Margin="4">
            <TextBox Text="{Binding FinalCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Width="120" Margin="0,0,6,0" Style="{StaticResource NeonDarkCyanTextBoxStyle}" TabIndex="15" KeyDown="SingleLineTextBox_KeyDown" />
            <ComboBox Width="80" SelectedItem="{Binding FinalCostCurrency, Mode=TwoWay}" Style="{StaticResource NeonDarkCyanComboBoxStyle}" ItemsSource="{Binding Currencies}"/>
            <TextBlock Text="{Binding FinalCostEquivalent}" Foreground="#FFD54A" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="18" Grid.Column="0" Margin="0,6" VerticalAlignment="Center"><Image Source="{StaticResource Warranty}" Width="22" Height="22" Margin="-3,0,3,0" /><TextBlock Text="Warranty:" VerticalAlignment="Center" /></StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="18" Grid.Column="1" Margin="4"><CheckBox IsChecked="{Binding HasWarranty}" Style="{StaticResource NeonCheckBoxStyle}" Margin="0,0,8,0" TabIndex="18" /><ComboBox Width="160" IsEnabled="{Binding HasWarranty}" SelectedItem="{Binding WarrantyPeriod, Mode=TwoWay}" Style="{StaticResource NeonDarkCyanComboBoxStyle}" TabIndex="19"><ComboBox.ItemsSource><x:Array Type="{x:Type sys:String}"><sys:String>1 Day</sys:String><sys:String>7 Days</sys:String><sys:String>14 Days</sys:String><sys:String>30 Days</sys:String><sys:String>90 Days</sys:String><sys:String>6 Months</sys:String><sys:String>1 Year</sys:String></x:Array></ComboBox.ItemsSource></ComboBox></StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="19" Grid.Column="0" Margin="0,6" VerticalAlignment="Center"><Image Source="{StaticResource RepOnWar}" Width="16" Height="16" Margin="0,0,6,0" /><TextBlock Text="Repair on Warranty:" VerticalAlignment="Center" /></StackPanel>
        <CheckBox IsChecked="{Binding IsWarrantyRepair}" Grid.Row="19" Grid.Column="1" Margin="4" Style="{StaticResource NeonCheckBoxStyle}" TabIndex="20" />

        <StackPanel Orientation="Horizontal" Grid.Row="20" Grid.Column="0" Margin="0,6" VerticalAlignment="Center"><Image Source="{StaticResource RootCause}" Width="16" Height="16" Margin="0,0,6,0" /><TextBlock Text="Root Cause:" VerticalAlignment="Center" /></StackPanel>
        <ComboBox SelectedItem="{Binding RootCause, Mode=TwoWay}" Grid.Row="20" Grid.Column="1" Margin="4" Style="{StaticResource NeonDarkCyanComboBoxStyle}" TabIndex="16"><ComboBox.ItemsSource><x:Array Type="{x:Type sys:String}"><sys:String>Electrical Cause</sys:String><sys:String>Mechanical Cause</sys:String><sys:String>Environmental Cause</sys:String><sys:String>Human Cause</sys:String></x:Array></ComboBox.ItemsSource></ComboBox>
    </Grid>
</UserControl>
