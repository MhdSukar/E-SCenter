<UserControl x:Class="ESCenter.Views.AlBarakaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.7*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════ LEFT: GRID + HEADER + FILTERS ══════════ -->
        <Border Grid.Column="0"
                CornerRadius="10"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="1"
                Margin="0,0,10,0"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#FBBF24" BlurRadius="18" ShadowDepth="0" Opacity="0.06"/>
            </Border.Effect>

            <DockPanel>

                <!-- ── Left toolbar header ── -->
                <Border DockPanel.Dock="Top"
                        Padding="12,10"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <!-- Left yellow accent bar -->
                        <Border Width="4" CornerRadius="10,0,0,0"
                                HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                Margin="-12,-10,0,-10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FBBF24" Offset="0"/>
                                    <GradientStop Color="#F59E0B" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <DockPanel LastChildFill="False" Margin="8,0,0,0">

                            <!-- Title -->
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                                        VerticalAlignment="Center" Margin="0,0,16,0">
                                <Image Source="{StaticResource Baraka}" Width="26" Height="26"
                                       Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Accounts Records" FontSize="17" FontWeight="Bold"
                                               Margin="0,0,0,1">
                                        <TextBlock.Foreground>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                <GradientStop Color="#FBBF24" Offset="0"/>
                                                <GradientStop Color="#F59E0B" Offset="1"/>
                                            </LinearGradientBrush>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <!-- Right: totals + action buttons -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <!-- Total chips -->
                                <Border Background="#12FBBF24" BorderBrush="#20FBBF24"
                                        BorderThickness="1" CornerRadius="6" Padding="10,4"
                                        Margin="0,0,8,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Total (S.P): " FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TotalSP, StringFormat=N2}"
                                                   FontWeight="Bold" FontSize="12"
                                                   Foreground="#FBBF24" VerticalAlignment="Center"
                                                   Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#12FBBF24" BorderBrush="#20FBBF24"
                                        BorderThickness="1" CornerRadius="6" Padding="10,4"
                                        Margin="0,0,12,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Total (USD): " FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TotalUSD, StringFormat=N2}"
                                                   FontWeight="Bold" FontSize="12"
                                                   Foreground="#22C55E" VerticalAlignment="Center"
                                                   Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Exchange Rate button -->
                                <Button Command="{Binding OpenExchangeRatesCommand}"
                                        Style="{StaticResource GradientBorderButtonStyleRed}"
                                        Height="30" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="{StaticResource Settings}" Width="14" Height="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="Exchange Rate" FontSize="12"/>
                                    </StackPanel>
                                </Button>

                                <!-- Refresh -->
                                <Button Command="{Binding RefreshCommand}"
                                        Style="{StaticResource IconButtonStyle}"
                                        MinWidth="10" Width="30" Height="30">
                                    <Image Source="{StaticResource Refresh}" Width="18" Height="18"/>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- ── Filters bar ── -->
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="From:" VerticalAlignment="Center"
                                   Margin="0,0,6,0" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <DatePicker Width="145" Height="28"
                                    SelectedDate="{Binding FilterStart, Mode=TwoWay, StringFormat=YYYY-MM-DD}"/>

                        <TextBlock Text="To:" VerticalAlignment="Center"
                                   Margin="12,0,6,0" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <DatePicker Width="145" Height="28"
                                    SelectedDate="{Binding FilterEnd, Mode=TwoWay, StringFormat=yyyy-MM-dd}"/>

                        <TextBlock Text="Category:" VerticalAlignment="Center"
                                   Margin="12,0,6,0" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ComboBox Width="150" Height="28"
                                  Style="{StaticResource GradiantComboboxStyle11}"
                                  ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding FilterCategory}"/>
                    </StackPanel>
                </Border>

                <!-- ── Records DataGrid ── -->
                <DataGrid ItemsSource="{Binding Records}"
                          SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Style="{StaticResource DarkDataGridStyle}"
                          RowStyle="{StaticResource CompactDataGridRowStyle}"
                          CellStyle="{StaticResource CompactDataGridCellStyle}"
                          ColumnHeaderStyle="{StaticResource CompactDataGridHeaderStyle}"
                          RowHeight="27">
                    <DataGrid.Columns>

                        <!-- Date chip -->
                        <DataGridTemplateColumn Header="Date" Width="100" SortMemberPath="Date">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#14FFFFFF" CornerRadius="4" Padding="6,2"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Date, StringFormat='yyyy-MM-dd'}"
                                                   FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="*"/>

                        <!-- Price -->
                        <DataGridTemplateColumn Header="Price" Width="90" SortMemberPath="Price">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Price}"
                                               Foreground="{StaticResource Gradient.Primary}"
                                               FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Currency pill -->
                        <DataGridTemplateColumn Header="Cur" Width="60" SortMemberPath="PriceCurrency">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#1A5AA7FF" BorderBrush="#205AA7FF"
                                            BorderThickness="1" CornerRadius="10"
                                            Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PriceCurrency}"
                                                   Foreground="#5AA7FF" FontSize="10" FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Category chip -->
                        <DataGridTemplateColumn Header="Category" Width="120" SortMemberPath="Category">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#1200E5D4" BorderBrush="#2500E5D4"
                                            BorderThickness="1" CornerRadius="4"
                                            Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Category}"
                                                   Foreground="#00E5D4" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="120"/>

                    </DataGrid.Columns>
                </DataGrid>

            </DockPanel>
        </Border>

        <!-- ══════════ RIGHT: FORM ══════════ -->
        <Border Grid.Column="1"
                Style="{StaticResource CardBorderStyle}"
                CornerRadius="10"
                Padding="14"
                Width="400">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Form title -->
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Add / Edit Record"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,2"/>
                    <Border Height="2" CornerRadius="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FBBF24" Offset="0"/>
                                <GradientStop Color="#00FBBF24" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Grid.Row="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,0,0,14">
                    <Button Command="{Binding AddNewCommand}"
                            Style="{StaticResource GradientBorderButtonStyleGreen}"
                            Width="80" Margin="4,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{StaticResource Add}" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock Text="New"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveCommand}"
                            Style="{StaticResource GradientBorderButtonStyleBLueCyan}"
                            Width="100" Margin="4,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{StaticResource EditAI}" Width="18" Height="18" Margin="0,0,6,0"/>
                            <TextBlock Text="Save" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DeleteCommand}"
                            Style="{StaticResource GradientBorderButtonStyleRed}"
                            Width="80" Margin="4,0"
                            IsEnabled="{Binding SelectedRecord}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{StaticResource DeleteClose}" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Delete"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Form fields -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
                    <Grid Margin="0,4,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Date:"
                                   VerticalAlignment="Center" Margin="0,0,0,10"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <DatePicker Grid.Row="0" Grid.Column="1"
                                    SelectedDate="{Binding Date, Mode=TwoWay, StringFormat=yyyy-MM-dd}"
                                    Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Item Name:"
                                   VerticalAlignment="Center" Margin="0,0,0,10"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding ItemName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource GradiantTextboxStyle1}"
                                 Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Price:"
                                   VerticalAlignment="Center" Margin="0,0,0,10"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBox Width="130"
                                     Text="{Binding Price, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource GradiantTextboxStyle1}" Margin="0,0,8,0"/>
                            <ComboBox Width="66"
                                      ItemsSource="{Binding Currencies}"
                                      SelectedItem="{Binding PriceCurrency}"
                                      Style="{StaticResource GradiantComboboxStyle11}"/>
                            <TextBlock Text="{Binding PriceEquivalent}"
                                       Foreground="#FBBF24" FontSize="12"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- Exchange rate display -->
                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="Rate (S.P):"
                                   Foreground="#FBBF24" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="3" Grid.Column="1"
                                   Text="{Binding PriceEquivalent}"
                                   Foreground="#FBBF24" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Category:"
                                   VerticalAlignment="Center" Margin="0,0,0,10"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ComboBox Grid.Row="4" Grid.Column="1"
                                  ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding Category}"
                                  Style="{StaticResource GradiantComboboxStyle11}"
                                  Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Account:"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ComboBox Grid.Row="5" Grid.Column="1"
                                  ItemsSource="{Binding Accounts}"
                                  SelectedItem="{Binding Account}"
                                  Style="{StaticResource GradiantComboboxStyle11}"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
