<UserControl x:Class="ESCenter.Views.AlBarakaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.7*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT: GRID + FILTERS -->
        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="8" Margin="0,0,10,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Image Source="{StaticResource Baraka}" Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                    <TextBlock Text="Accounts Records" FontSize="20" FontWeight="Bold" Foreground="{StaticResource NeonOrangeBrush}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button Command="{Binding OpenExchangeRatesCommand}" Style="{StaticResource GradientBorderButtonStyleRed}" Margin="4,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource Settings}" Width="19" Height="19" Margin="0,0,6,0" />
                                <TextBlock Text="Exchange Rate" Width="90"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding RefreshCommand}" Style="{StaticResource GradientBorderButtonStyleYellow}" MinWidth="10" Width="30" Margin="4,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource Refresh}" Width="23" Height="23" Margin="0,0,0,0" />
                                
                            </StackPanel>
                        </Button>

                        <!-- Auto expenses summary for filtered items -->
                        <Border Background="Transparent" Padding="8,4" Margin="8,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Total (S.P): " Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalSP, StringFormat=N2}" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Total (USD): " Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalUSD, StringFormat=N2}" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- Filters -->
                <Border DockPanel.Dock="Top" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <DatePicker Width="160" SelectedDate="{Binding FilterStart, Mode=TwoWay, StringFormat=YYYY-MM-DD}" />
                        <TextBlock Text="To:" VerticalAlignment="Center" Margin="12,0,6,0" />
                        <DatePicker Width="160" SelectedDate="{Binding FilterEnd, Mode=TwoWay, StringFormat=yyyy-MM-dd}"  />
                        <TextBlock Text="Category:" VerticalAlignment="Center" Margin="12,0,6,0" />
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding FilterCategory}" Style="{StaticResource NeonDarkCyanComboBoxStyle}" Width="160" />
                    </StackPanel>
                </Border>

                <!-- DataGrid (compact style) -->
                <DataGrid ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True"
                          Style="{StaticResource DarkDataGridStyle}"
                          RowStyle="{StaticResource CompactDataGridRowStyle}"
                          CellStyle="{StaticResource CompactDataGridCellStyle}"
                          ColumnHeaderStyle="{StaticResource CompactDataGridHeaderStyle}"
                          AlternatingRowBackground="{StaticResource DataGridRowAltBackgroundBrush}"
                          RowHeight="25">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='yyyy-MM-dd'}" Width="90" />
                        <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="*" />
                        <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="90" />
                        <DataGridTextColumn Header="Cur" Binding="{Binding PriceCurrency}" Width="60" />
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" />
                        <DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- RIGHT: FORM -->
        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" 
                Padding="12" Width="400">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Add / Edit Record" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,12">
                    <Button Command="{Binding AddNewCommand}" Style="{StaticResource GradientBorderButtonStyleGreen}" Width="80" Margin="4,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{StaticResource Add}" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock Text="New" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SaveCommand}" Style="{StaticResource GradientBorderButtonStyleBLueCyan}" Width="100" Margin="4,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{StaticResource EditAI}" Width="23" Height="23" Margin="0,0,6,0" />
                            <TextBlock Text="Save" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding DeleteCommand}" Style="{StaticResource GradientBorderButtonStyleRed}" Width="80" Margin="4,0" IsEnabled="{Binding SelectedRecord}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{StaticResource DeleteClose}" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock Text="Delete" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
                    <Grid Margin="0,6,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,10">Date:</TextBlock>
                        <DatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding Date, Mode=TwoWay, StringFormat=yyyy-MM-dd}" Margin="0,0,0,10" />

                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,10">Item Name:</TextBlock>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ItemName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NeonTextBoxStyle}" Margin="0,0,0,10" />

                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,10">Price:</TextBlock>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBox Width="140" Text="{Binding Price, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NeonTextBoxStyle}" />
                            <ComboBox Width="66" Margin="8,0,0,0" ItemsSource="{Binding Currencies}" SelectedItem="{Binding PriceCurrency}" Style="{StaticResource NeonDarkCyanComboBoxStyle}" />
                            
                        </StackPanel>
                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="Exchange Rate (S.P):"
                                   Foreground="#FFD54A"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,10">

                        </TextBlock>
                        <TextBlock Text="{Binding PriceEquivalent}"
                                   Foreground="#FFD54A"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,10"
                                   Grid.Row="3" Grid.Column="1"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,10">Category:</TextBlock>
                        <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Style="{StaticResource NeonDarkCyanComboBoxStyle}" Margin="0,0,0,10" />

                        <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center">Account:</TextBlock>
                        <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}" Style="{StaticResource NeonDarkCyanComboBoxStyle}" />

                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
