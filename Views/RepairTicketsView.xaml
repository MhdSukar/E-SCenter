<UserControl x:Class="ESCenter.Views.RepairTicketsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ESCenter.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:ESCenter.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:RepairTicketsViewModel, IsDesignTimeCreatable=True}"
             Background="Transparent"
             Height="Auto"
             Width="Auto">

    <UserControl.Resources>

        <Style TargetType="GroupBox">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT: TICKETS GRID ================= -->
        <views:TicketListPanel />

        <!-- ================= RIGHT: DETAIL INSPECTOR ================= -->
        <Border Grid.Column="1"
                Style="{StaticResource CardBorderStyle}"
                Padding="12"
                KeyboardNavigation.TabNavigation="Cycle">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <DockPanel Grid.Row="0"
                           Margin="0,0,0,12">
                    <TextBlock Text="Ticket Details"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <Border Margin="12,0,0,0"
                            Padding="6,2"
                            CornerRadius="4"
                            Background="#2A1800"
                            BorderBrush="#FF8C42"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUnsavedChanges}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="● Unsaved changes"
                                   Foreground="#FF8C42"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                    </Border>
                </DockPanel>

                <!-- Footer -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,12">

                    <Button Command="{Binding AddCommand}"
                            Style="{StaticResource GradientBorderButtonStyleGreen}"
                            Width="80"
                            Margin="4,0"
                            TabIndex="22"
                            IsDefault="False">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Image Source="{StaticResource Add}"
                                   Width="16"
                                   Height="16"
                                   Margin="0,0,6,0" />
                            <TextBlock Text="Add" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SaveCommand}"
                            Width="100"
                            Margin="4,0"
                            TabIndex="23"
                            IsDefault="False">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource GradientBorderButtonStyleBLueCyan}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUnsavedChanges}"
                                                 Value="True">
                                        <Setter Property="BorderBrush"
                                                Value="#FF8C42" />
                                        <Setter Property="BorderThickness"
                                                Value="1.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Image Source="{StaticResource Save}"
                                   Width="23"
                                   Height="23"
                                   Margin="0,0,6,0" />
                            <TextBlock Text="Save" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ClearCommand}"
                            Style="{StaticResource GradientBorderButtonStyleYellow}"
                            Width="80"
                            Margin="4,0"
                            TabIndex="24"
                            IsDefault="False">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Image Source="{StaticResource Clear}"
                                   Width="16"
                                   Height="16"
                                   Margin="0,0,6,0" />
                            <TextBlock Text="Clear" />
                        </StackPanel>
                    </Button>

                </StackPanel>

                <!-- Form -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Hidden">
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <!-- 0 -->
                            <RowDefinition Height="Auto" />
                            <!-- 1 -->
                            <RowDefinition Height="Auto" />
                            <!-- 2 -->
                            <RowDefinition Height="Auto" />
                            <!-- 3 -->
                            <RowDefinition Height="Auto" />
                            <!-- 4 -->
                            <RowDefinition Height="Auto" />
                            <!-- 5 -->
                            <RowDefinition Height="Auto" />
                            <!-- 6 -->
                            <RowDefinition Height="Auto" />
                            <!-- 7 -->
                            <RowDefinition Height="Auto" />
                            <!-- 8 -->
                            <RowDefinition Height="Auto" />
                            <!-- 9 -->
                            <RowDefinition Height="Auto" />
                            <!-- 10 -->
                            <RowDefinition Height="Auto" />
                            <!-- 11 -->
                            <RowDefinition Height="Auto" />
                            <!-- 12 -->
                            <RowDefinition Height="Auto" />
                            <!-- 13 -->
                            <RowDefinition Height="Auto" />
                            <!-- 14 -->
                            <RowDefinition Height="Auto" />
                            <!-- 15 -->
                            <RowDefinition Height="Auto" />
                            <!-- 16 -->
                            <RowDefinition Height="Auto" />
                            <!-- 17 -->
                            <RowDefinition Height="Auto" />
                            <!-- 18 -->
                            <RowDefinition Height="Auto" />
                            <!-- 19 -->
                            <RowDefinition Height="Auto" />
                            <!-- 20 -->
                            <RowDefinition Height="Auto" />
                            <!-- 21 -->
                            <RowDefinition Height="Auto" />
                            <!-- 22 -->
                            <RowDefinition Height="Auto" />
                            <!-- 23 -->
                            <RowDefinition Height="Auto" />
                            <!-- 24 -->
                            <RowDefinition Height="Auto" />
                            <!-- 25 -->
                            <RowDefinition Height="Auto" />
                            <!-- 26 -->
                        </Grid.RowDefinitions>

                        <views:TicketFormPanel Grid.Row="0"
                                               Grid.ColumnSpan="2"
                                               Grid.RowSpan="21"
                                               x:Name="CustomerNameBox" />

                        <GroupBox Header="Recent Client History"
                                  Grid.Row="25"
                                  Grid.ColumnSpan="2"
                                  Margin="0,12,0,0"
                                  Style="{StaticResource GradientGroupBoxAccent}"
                                  Visibility="{Binding HasClientHistory, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Expander IsExpanded="False"
                                      Background="Transparent"
                                      BorderThickness="0">
                                <DataGrid ItemsSource="{Binding ClientHistory}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          MinHeight="110"
                                          MaxHeight="220"
                                          Style="{StaticResource DarkDataGridStyle}"
                                          RowStyle="{StaticResource CompactDataGridRowStyle}"
                                          CellStyle="{StaticResource CompactDataGridCellStyle}"
                                          ColumnHeaderStyle="{StaticResource CompactDataGridHeaderStyle}"
                                          AlternatingRowBackground="{StaticResource DataGridRowAltBackgroundBrush}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Ticket ID" Width="95">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.SelectClientHistoryTicketCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource GradientBorderButtonStyleBLueCyan}"
                                                            Padding="8,2"
                                                            MinWidth="74"
                                                            HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding TicketId}" />
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Date"
                                                            Binding="{Binding ReceiveDate, StringFormat={}{0:yyyy-MM-dd}}"
                                                            Width="110" />
                                        <DataGridTextColumn Header="Device"
                                                            Binding="{Binding DeviceModel}"
                                                            Width="*" />
                                        <DataGridTextColumn Header="Status"
                                                            Binding="{Binding RepairStatus}"
                                                            Width="140" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Expander>
                        </GroupBox>

                        <views:TicketPartsPanel Grid.Row="21"
                                                Grid.ColumnSpan="2" />

                        <GroupBox Header="Status Timeline"
                                  Grid.Row="22"
                                  Grid.ColumnSpan="2"
                                  Margin="0,12,0,0"
                                  Style="{StaticResource GradientGroupBoxAccent}">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Note for status change:"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11"/>
                                    <TextBox Text="{Binding StatusChangeNote, UpdateSourceTrigger=PropertyChanged}"
                                             Width="220"
                                             Style="{StaticResource GradiantTextboxStyle1}"/>
                                </StackPanel>

                                <ItemsControl Grid.Row="1" ItemsSource="{Binding StatusHistory}" MaxHeight="160">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                <TextBlock Text="{Binding ChangedAtDisplay}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="11"
                                                           Width="115"/>
                                                <TextBlock Text="{Binding OldStatus}" Foreground="#FF9A9A" FontSize="11"/>
                                                <TextBlock Text=" → " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding NewStatus}" Foreground="#5AA7FF" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Note, StringFormat=' — {0}'}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="11"
                                                           FontStyle="Italic"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </GroupBox>

                        <!-- ================= DEVICE CHECK LIST ================= -->
                        <GroupBox Header="Device Check List"
                                  Grid.Row="23"
                                  Grid.ColumnSpan="2"
                                  Margin="0,12,0,0"
                                  FontWeight="Bold"
                                  Style="{StaticResource GradientGroupBoxRed}">
                            <UniformGrid Columns="2"
                                         Margin="8">

                                <!-- ===== Power & System ===== -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Powers On:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckPowerOn}"
                                              Style="{StaticResource GradientCheckBoxDangerStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Boots to OS:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckBoots}"
                                              Style="{StaticResource GradientCheckBoxDangerStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Battery Charging:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckBatteryCharging}"
                                              Style="{StaticResource GradientCheckBoxDangerStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Battery Health:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckBatteryHealth}"
                                              Style="{StaticResource GradientCheckBoxDangerStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Overheating:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckOverheating}"
                                              Style="{StaticResource GradientCheckBoxDangerStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <!-- ===== Display & Input ===== -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Screen / Display:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckScreen}"
                                              Style="{StaticResource GradientCheckBoxDangerStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Touch Response:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckTouch}"
                                              Style="{StaticResource GradientCheckBoxDangerStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Dead Pixels / Lines:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckDeadPixels}"
                                              Style="{StaticResource GradientCheckBoxDangerStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Buttons:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckButtons}"
                                              Style="{StaticResource GradientCheckBoxDangerStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <!-- ===== Audio & Camera ===== -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Speaker:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckSpeaker}"
                                              Style="{StaticResource GradientCheckBoxDangerStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Microphone:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckMicrophone}"
                                              Style="{StaticResource GradientCheckBoxDangerStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Front Camera:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckFrontCamera}"
                                              Style="{StaticResource GradientCheckBoxDangerStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Rear Camera:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckRearCamera}"
                                              Style="{StaticResource GradientCheckBoxDangerStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <!-- ===== Connectivity ===== -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="WiFi:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckWiFi}"
                                              Style="{StaticResource GradientCheckBoxDangerStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Bluetooth:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckBluetooth}"
                                              Style="{StaticResource GradientCheckBoxDangerStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Cellular / Signal:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckCellular}"
                                              Style="{StaticResource GradientCheckBoxDangerStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="USB / Ports:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckPorts}"
                                              Style="{StaticResource GradientCheckBoxDangerStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <!-- ===== Security & Software ===== -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Face ID / Fingerprint:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckBiometrics}"
                                              Style="{StaticResource GradientCheckBoxDangerStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Activation / Account Lock:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckActivationLock}"
                                              Style="{StaticResource GradientCheckBoxDangerStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Storage Detected:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckStorage}"
                                              Style="{StaticResource GradientCheckBoxDangerStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <!-- ===== Physical Condition ===== -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Frame / Chassis:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckFrame}"
                                              Style="{StaticResource GradientCheckBoxDangerStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Back Cover:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckCover}"
                                              Style="{StaticResource GradientCheckBoxDangerStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Liquid Damage Indicators:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckLiquidDamage}"
                                              Style="{StaticResource GradientCheckBoxDangerStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Signs of Previous Repair:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckPreviousRepair}"
                                              Style="{StaticResource GradientCheckBoxDangerStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                            </UniformGrid>
                        </GroupBox>

                        
                        <!-- ================= ACCESSORIES ================= -->
                        <GroupBox Header="Accessories"
                                  Grid.Row="24"
                                  Grid.ColumnSpan="2"
                                  Margin="0,12,0,0"
                                  FontWeight="Bold"
                                  Style="{StaticResource GradientGroupBoxYellow}">
                            <UniformGrid Columns="2"
                                         Margin="8">

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Software:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessorySoftware}"
                                              Style="{StaticResource GradientCheckBoxWarningStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="USB Stick:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessoryUSBStick}"
                                              Style="{StaticResource GradientCheckBoxWarningStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Case:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessoryCase}"
                                              Style="{StaticResource GradientCheckBoxWarningStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Charger:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessoryCharger}"
                                              Style="{StaticResource GradientCheckBoxWarningStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Battery:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessoryBattery}"
                                              Style="{StaticResource GradientCheckBoxWarningStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Monitor:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessoryMonitor}"
                                              Style="{StaticResource GradientCheckBoxWarningStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Power Cord:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessoryPowerCord}"
                                              Style="{StaticResource GradientCheckBoxWarningStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Original Package:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessoryOriginalPackage}"
                                              Style="{StaticResource GradientCheckBoxWarningStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Memory Card:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessoryMemoryCard}"
                                              Style="{StaticResource GradientCheckBoxWarningStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Cables:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessoryCables}"
                                              Style="{StaticResource GradientCheckBoxWarningStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Mouse:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessoryMouse}"
                                              Style="{StaticResource GradientCheckBoxWarningStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Keyboard:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessoryKeyboard}"
                                              Style="{StaticResource GradientCheckBoxWarningStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <!-- ===== Added Professional Intake Items ===== -->

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="SIM Card:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessorySIMCard}"
                                              Style="{StaticResource GradientCheckBoxWarningStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="SD Adapter:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessorySDAdapter}"
                                              Style="{StaticResource GradientCheckBoxWarningStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Stylus / Pen:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessoryStylus}"
                                              Style="{StaticResource GradientCheckBoxWarningStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Docking Station:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessoryDock}"
                                              Style="{StaticResource GradientCheckBoxWarningStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="External Drive:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessoryExternalDrive}"
                                              Style="{StaticResource GradientCheckBoxWarningStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Headphones / Earbuds:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessoryHeadphones}"
                                              Style="{StaticResource GradientCheckBoxWarningStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                            </UniformGrid>
                        </GroupBox>

                        <!-- ================= CUSTOMER PROFILE ================= -->
                        <GroupBox Header="{Binding CustomerProfileHeader}"
                                  Grid.Row="26"
                                  Grid.ColumnSpan="2"
                                  Margin="0,12,0,0"
                                  FontWeight="Bold"
                                  Style="{StaticResource GradientGroupBoxAccent}">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Margin="0,0,0,6"
                                           Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="Repeat records: " />
                                    <Run Text="{Binding CustomerProfileRepeatCount}" FontWeight="SemiBold" />
                                </TextBlock>

                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding CustomerProfileHistory}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          MinHeight="140"
                                          MaxHeight="220"
                                          Style="{StaticResource DarkDataGridStyle}"
                                          RowStyle="{StaticResource CompactDataGridRowStyle}"
                                          CellStyle="{StaticResource CompactDataGridCellStyle}"
                                          ColumnHeaderStyle="{StaticResource CompactDataGridHeaderStyle}"
                                          AlternatingRowBackground="{StaticResource DataGridRowAltBackgroundBrush}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Device Serial"
                                    Binding="{Binding SerialIMEI}"
                                    Width="107" />
                                        <DataGridTextColumn Header="Problem Description"
                                    Binding="{Binding ProblemDescription}"
                                    Width="150" />
                                        <DataGridTextColumn Header="Damage History"
                                    Binding="{Binding DamageHistory}"
                                    Width="150" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </GroupBox>

                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
