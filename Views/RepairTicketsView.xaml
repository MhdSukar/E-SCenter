<UserControl x:Class="ESCenter.Views.RepairTicketsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ESCenter.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:RepairTicketsViewModel, IsDesignTimeCreatable=True}"
             Background="Transparent"
             Height="Auto"
             Width="Auto">

    <UserControl.Resources>

        <Style TargetType="GroupBox">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT: TICKETS GRID ================= -->
        <Border Style="{StaticResource CardBorderStyle}"
                Padding="8"
                Margin="0,0,10,0">
            <DockPanel>

                <!-- ================= HEADER ================= -->
                <DockPanel DockPanel.Dock="Top"
                           Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,0,4">
                        <Image Source="{StaticResource Tickets}"
                               Width="26"
                               Height="26"
                               Margin="0,0,6,0" />
                        <TextBlock Text="Repair Tickets"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource NewPrimaryBlueBrush}"
                                   DockPanel.Dock="Left" Margin="0,0,0,0"/>
                    </StackPanel>
                    

                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Right"
                                VerticalAlignment="Center">

                        <Button Command="{Binding CloseCommand}"
                                Style="{StaticResource NeonGreenButtonStyle}"
                                Width="80"
                                Margin="4,0"
                                IsEnabled="{Binding SelectedTicket}">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Image Source="{StaticResource TickClosed}"
                                       Width="16"
                                       Height="16"
                                       Margin="0,0,6,0" />
                                <TextBlock Text="Close" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ReopenCommand}"
                                Style="{StaticResource NeonOrangeButtonStyle}"
                                Width="80"
                                Margin="4,0"
                                IsEnabled="{Binding SelectedTicket}">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Image Source="{StaticResource Reopen1}"
                                       Width="16"
                                       Height="16"
                                       Margin="0,0,6,0" />
                                <TextBlock Text="Reopen" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding DeleteCommand}"
                                Style="{StaticResource NeonRedButtonStyle}"
                                Width="80"
                                Margin="4,0"
                                IsEnabled="{Binding SelectedTicket}">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Image Source="{StaticResource DeleteClose}"
                                       Width="16"
                                       Height="16"
                                       Margin="0,0,6,0" />
                                <TextBlock Text="Delete" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </DockPanel>

                <!-- ================= SEARCH + FILTER BAR ================= -->
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8"
                        Margin="0,0,0,8">

                    <DockPanel LastChildFill="False">

                        <!-- Left side -->
                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Left"
                                    VerticalAlignment="Center">

                            <!-- Icon slot -->
                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="6"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderDarkBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <Image Source="{StaticResource AISearch}"
                                       Width="25"
                                       Height="25"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                            </Border>

                            <!-- Search box -->
                            <TextBox Width="240"
                                     Margin="0,0,6,0"
                                     Padding="6,4"
                                     Style="{StaticResource NeonTextBoxStyle}"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />

                            <Button MinWidth="28" Width="28"
                                    Height="28"
                                    Margin="0,0,12,0"
                                    Padding="0"
                                    Style="{StaticResource NeonRedButtonStyle}"
                                    Command="{Binding ClearSearchCommand}"
                                    ToolTip="Clear search">
                                <Image Source="{StaticResource Clear}" Width="20" Height="20"/>
                            </Button>

                            <!-- Status filter -->
                            <TextBlock Text="Ticket Status:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0" Foreground="{StaticResource Gradient.Warning}"/>
                            <ComboBox Width="140"
                                      Margin="0,0,10,0"
                                      Style="{StaticResource NeonComboBoxStyle}"
                                      ItemsSource="{Binding StatusFilters}"
                                      SelectedItem="{Binding SelectedStatusFilter}" />

                            <!-- Priority filter -->
                            <TextBlock Text="Ticket Priority:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0" Foreground="{StaticResource Gradient.Danger}"/>
                            <ComboBox Width="140"
                                      Style="{StaticResource NeonComboBoxStyle}"
                                      ItemsSource="{Binding PriorityFilters}"
                                      SelectedItem="{Binding SelectedPriorityFilter}" />

                            <Button MinWidth="28" Width="28"
                                    Height="28"
                                    Margin="10,0,0,0"
                                    Padding="0"
                                    Style="{StaticResource NeonRedButtonStyle}"
                                    Command="{Binding ResetFiltersCommand}"
                                    ToolTip="Reset filters">
                                <Image Source="{StaticResource Clear}" Width="20" Height="20"/>
                            </Button>

                        </StackPanel>

                    </DockPanel>
                </Border>

                <!-- ================= TICKETS GRID ================= -->
                <DataGrid ItemsSource="{Binding TicketsView}"
                          SelectedItem="{Binding SelectedTicket, Mode=TwoWay}"
                          IsSynchronizedWithCurrentItem="True"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Style="{StaticResource DarkDataGridStyle}"
                          RowStyle="{StaticResource TicketRowStyle}"
                          CellStyle="{StaticResource TicketCellStyle}"
                          ColumnHeaderStyle="{StaticResource CompactDataGridHeaderStyle}" 
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header=""
                                            Binding="{Binding SymbolDisplay}"
                                            Width="34" />
                        <DataGridTextColumn Header="ESC-ID"
                                            Binding="{Binding EscTicketId}"
                                            Width="70" />
                        <DataGridTextColumn Header="Customer Name"
                                            Binding="{Binding CustomerName}"
                                            Width="120" />
                        <DataGridTextColumn Header="Phone"
                                            Binding="{Binding PhoneNumber}"
                                            Width="100" />
                        <DataGridTextColumn Header="Device"
                                            Binding="{Binding DeviceCategory}"
                                            Width="80" />
                        <DataGridTextColumn Header="Model"
                                            Binding="{Binding DeviceModel}"
                                            Width="100" />
                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding RepairStatus}"
                                            Width="90" />
                        <DataGridTextColumn Header="Priority"
                                            Binding="{Binding PriorityLevel}"
                                            Width="75"
                                            CellStyle="{StaticResource PriorityCellStyle}" />
                        <DataGridTextColumn Header="Received"
                                            Binding="{Binding ReceiveDate, StringFormat='yyyy-MM-dd HH:mm'}"
                                            Width="100" />
                        <DataGridTextColumn Header="Delivery"
                                            Binding="{Binding DeliveryDate, StringFormat='yyyy-MM-dd HH:mm'}"
                                            Width="100" />
                        <DataGridTextColumn Header="Notes"
                                            Binding="{Binding Notes}"
                                            Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

            </DockPanel>
        </Border>

        <!-- ================= RIGHT: DETAIL INSPECTOR ================= -->
        <Border Grid.Column="1"
                Style="{StaticResource CardBorderStyle}"
                Padding="12"
                KeyboardNavigation.TabNavigation="Cycle">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <DockPanel Grid.Row="0"
                           Margin="0,0,0,12">
                    <TextBlock Text="Ticket Details"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <Border Margin="12,0,0,0"
                            Padding="6,2"
                            CornerRadius="4"
                            Background="#2A1800"
                            BorderBrush="#FF8C42"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUnsavedChanges}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="● Unsaved changes"
                                   Foreground="#FF8C42"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                    </Border>
                </DockPanel>

                <!-- Footer -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,12">

                    <Button Command="{Binding AddCommand}"
                            Style="{StaticResource NeonGreenButtonStyle}"
                            Width="80"
                            Margin="4,0"
                            TabIndex="22"
                            IsDefault="False">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Image Source="{StaticResource Add}"
                                   Width="16"
                                   Height="16"
                                   Margin="0,0,6,0" />
                            <TextBlock Text="Add" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SaveCommand}"
                            Width="100"
                            Margin="4,0"
                            TabIndex="23"
                            IsDefault="False">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource NeonCyanButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUnsavedChanges}"
                                                 Value="True">
                                        <Setter Property="BorderBrush"
                                                Value="#FF8C42" />
                                        <Setter Property="BorderThickness"
                                                Value="1.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Image Source="{StaticResource Save}"
                                   Width="23"
                                   Height="23"
                                   Margin="0,0,6,0" />
                            <TextBlock Text="Save" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ClearCommand}"
                            Style="{StaticResource NeonOrangeButtonStyle}"
                            Width="80"
                            Margin="4,0"
                            TabIndex="24"
                            IsDefault="False">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Image Source="{StaticResource Clear}"
                                   Width="16"
                                   Height="16"
                                   Margin="0,0,6,0" />
                            <TextBlock Text="Clear" />
                        </StackPanel>
                    </Button>

                </StackPanel>

                <!-- Form -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Hidden">
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <!-- 0 -->
                            <RowDefinition Height="Auto" />
                            <!-- 1 -->
                            <RowDefinition Height="Auto" />
                            <!-- 2 -->
                            <RowDefinition Height="Auto" />
                            <!-- 3 -->
                            <RowDefinition Height="Auto" />
                            <!-- 4 -->
                            <RowDefinition Height="Auto" />
                            <!-- 5 -->
                            <RowDefinition Height="Auto" />
                            <!-- 6 -->
                            <RowDefinition Height="Auto" />
                            <!-- 7 -->
                            <RowDefinition Height="Auto" />
                            <!-- 8 -->
                            <RowDefinition Height="Auto" />
                            <!-- 9 -->
                            <RowDefinition Height="Auto" />
                            <!-- 10 -->
                            <RowDefinition Height="Auto" />
                            <!-- 11 -->
                            <RowDefinition Height="Auto" />
                            <!-- 12 -->
                            <RowDefinition Height="Auto" />
                            <!-- 13 -->
                            <RowDefinition Height="Auto" />
                            <!-- 14 -->
                            <RowDefinition Height="Auto" />
                            <!-- 15 -->
                            <RowDefinition Height="Auto" />
                            <!-- 16 -->
                            <RowDefinition Height="Auto" />
                            <!-- 17 -->
                            <RowDefinition Height="Auto" />
                            <!-- 18 -->
                            <RowDefinition Height="Auto" />
                            <!-- 19 -->
                            <RowDefinition Height="Auto" />
                            <!-- 20 -->
                            <RowDefinition Height="Auto" />
                            <!-- 21 -->
                            <RowDefinition Height="Auto" />
                            <!-- 22 -->
                            <RowDefinition Height="Auto" />
                            <!-- 23 -->
                            <RowDefinition Height="Auto" />
                            <!-- 24 -->
                            <RowDefinition Height="Auto" />
                            <!-- 25 -->
                        </Grid.RowDefinitions>

                        <!-- ================= CUSTOMER INFO ================= -->
                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,6"
                                    VerticalAlignment="Center">
                            <Image Source="{StaticResource ReadyToPick}"
                                   Width="16"
                                   Height="16"
                                   Margin="0,0,6,0" />
                            <TextBlock Text="Ready for Pickup:"
                                       VerticalAlignment="Center" Foreground="{StaticResource Gradient.Success}" />
                        </StackPanel>
                        <CheckBox IsChecked="{Binding IsReadyForPickup, Mode=TwoWay}"
                                  Grid.Row="0"
                                  Grid.Column="1"
                                  Margin="4"
                                  Style="{StaticResource NeonCheckBoxStyle}"
                                  TabIndex="21"
                                  KeyDown="SaveOrAddOnEnter" />

                        <!-- ================= UNIQUE ESC ID ================= -->
                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,6"
                                    VerticalAlignment="Center">
                            <Image Source="{StaticResource ESCID2}"
                                   Width="17"
                                   Height="17"
                                   Margin="0,0,6,0" />
                            <TextBlock Text="ESC Code:"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBox Text="{Binding EscTicketId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="4"
                                 Style="{StaticResource NeonTextBoxStyle}"
                                 ToolTip="Format: ESC-000001"
                                 Focusable="False"
                                 IsTabStop="False" />

                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="0,6"
                                    VerticalAlignment="Center">
                            <Image Source="{StaticResource IDTitle}"
                                   Width="16"
                                   Height="16"
                                   Margin="0,0,6,0" />
                            <TextBlock Text="Customer ID:"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBox Text="{Binding CustomerIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Margin="4"
                                 Style="{StaticResource NeonTextBoxStyle}"
                                 TabIndex="1"
                                 KeyDown="SingleLineTextBox_KeyDown" />

                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Margin="0,6"
                                    VerticalAlignment="Center">
                            <Image Source="{StaticResource AddressBook}"
                                   Width="16"
                                   Height="16"
                                   Margin="0,0,6,0" />
                            <TextBlock Text="Customer Name:"
                                       VerticalAlignment="Center" />
                            <TextBlock Text=" *"
                                       Foreground="#FF5A5A"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       FontSize="13" />
                        </StackPanel>
                        <TextBox x:Name="CustomerNameBox"
                                 Text="{Binding CustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="3"
                                 Grid.Column="1"
                                 Margin="4"
                                 Style="{StaticResource NeonTextBoxStyle}"
                                 TabIndex="2"
                                 KeyDown="SingleLineTextBox_KeyDown" />

                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Margin="0,6"
                                    VerticalAlignment="Center">
                            <Image Source="{StaticResource PhoneNumber}"
                                   Width="16"
                                   Height="16"
                                   Margin="0,0,6,0" />
                            <TextBlock Text="Phone Number:"
                                       VerticalAlignment="Center" />
                            <TextBlock Text=" *"
                                       Foreground="#FF5A5A"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       FontSize="13" />
                        </StackPanel>
                        <TextBox Text="{Binding PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="4"
                                 Grid.Column="1"
                                 Margin="4"
                                 Style="{StaticResource NeonTextBoxStyle}"
                                 TabIndex="3"
                                 KeyDown="SingleLineTextBox_KeyDown" />

                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    Margin="0,6"
                                    VerticalAlignment="Center">
                            <Image Source="{StaticResource ContactAI}"
                                   Width="16"
                                   Height="16"
                                   Margin="0,0,6,0" />
                            <TextBlock Text="Contact Method:"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ComboBox SelectedItem="{Binding ContactMethod, Mode=TwoWay}"
                                  Grid.Row="5"
                                  Grid.Column="1"
                                  Margin="4"
                                  Style="{StaticResource NeonComboBoxStyle}"
                                  TabIndex="4">
                            <ComboBox.ItemsSource>
                                <x:Array Type="{x:Type sys:String}"
                                         xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                    <sys:String>Call</sys:String>
                                    <sys:String>WhatsApp</sys:String>
                                    <sys:String>SMS</sys:String>
                                    <sys:String>Email</sys:String>
                                    <sys:String>None</sys:String>
                                </x:Array>
                            </ComboBox.ItemsSource>
                        </ComboBox>

                        <!-- ================= DEVICE INFO ================= -->
                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="6"
                                    Grid.Column="0"
                                    Margin="0,6"
                                    VerticalAlignment="Center">
                            <Image Source="{StaticResource CategoryList}"
                                   Width="16"
                                   Height="16"
                                   Margin="0,0,6,0" />
                            <TextBlock Text="Device Category:"
                                       VerticalAlignment="Center" />
                            <TextBlock Text=" *"
                                       Foreground="#FF5A5A"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       FontSize="13" />
                        </StackPanel>
                        <TextBox Text="{Binding DeviceCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="6"
                                 Grid.Column="1"
                                 Margin="4"
                                 Style="{StaticResource NeonTextBoxStyle}"
                                 TabIndex="5"
                                 KeyDown="SingleLineTextBox_KeyDown" />

                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="7"
                                    Grid.Column="0"
                                    Margin="0,6"
                                    VerticalAlignment="Center">
                            <Image Source="{StaticResource Brand}"
                                   Width="16"
                                   Height="16"
                                   Margin="0,0,6,0" />
                            <TextBlock Text="Device Brand:"
                                       VerticalAlignment="Center" />
                            <TextBlock Text=" *"
                                       Foreground="#FF5A5A"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       FontSize="13" />
                        </StackPanel>
                        <TextBox Text="{Binding DeviceBrand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="7"
                                 Grid.Column="1"
                                 Margin="4"
                                 Style="{StaticResource NeonTextBoxStyle}"
                                 TabIndex="6"
                                 KeyDown="SingleLineTextBox_KeyDown" />

                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="8"
                                    Grid.Column="0"
                                    Margin="0,6"
                                    VerticalAlignment="Center">
                            <Image Source="{StaticResource Model}"
                                   Width="16"
                                   Height="16"
                                   Margin="0,0,6,0" />
                            <TextBlock Text="Device Model:"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBox Text="{Binding DeviceModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="8"
                                 Grid.Column="1"
                                 Margin="4"
                                 Style="{StaticResource NeonTextBoxStyle}"
                                 TabIndex="7"
                                 KeyDown="SingleLineTextBox_KeyDown" />

                        <!-- ================= DAMAGE HISTORY ================= -->
                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="9"
                                    Grid.Column="0"
                                    Margin="0,6"
                                    VerticalAlignment="Top">
                            <Image Source="{StaticResource DmgHistory2}"
                                   Width="16"
                                   Height="16"
                                   Margin="0,0,6,0" />
                            <TextBlock Text="Damage History:"
                                       VerticalAlignment="Top" />
                        </StackPanel>
                        <TextBox Text="{Binding DamageHistory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="9"
                                 Grid.Column="1"
                                 Margin="4"
                                 Height="60"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Style="{StaticResource NeonTextBoxStyle}" />

                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="10"
                                    Grid.Column="0"
                                    Margin="0,6"
                                    VerticalAlignment="Center">
                            <Image Source="{StaticResource SerialTitle  }"
                                   Width="16"
                                   Height="16"
                                   Margin="0,0,6,0" />
                            <TextBlock Text="Serial / IMEI:"
                                       VerticalAlignment="Center" />
                            <TextBlock Text=" *"
                                       Foreground="#FF5A5A"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       FontSize="13" />
                        </StackPanel>
                        <TextBox Text="{Binding SerialIMEI, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="10"
                                 Grid.Column="1"
                                 Margin="4"
                                 Style="{StaticResource NeonTextBoxStyle}"
                                 TabIndex="8"
                                 KeyDown="SingleLineTextBox_KeyDown" />

                        <!-- ================= DESCRIPTION & NOTES ================= -->
                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="11"
                                    Grid.Column="0"
                                    Margin="0,6"
                                    VerticalAlignment="Top">
                            <Image Source="{StaticResource ProblemDescription}"
                                   Width="16"
                                   Height="16"
                                   Margin="0,0,6,0" />
                            <TextBlock Text="Problem Description:"
                                       VerticalAlignment="Top" />
                        </StackPanel>
                        <TextBox Text="{Binding ProblemDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="11"
                                 Grid.Column="1"
                                 Margin="4"
                                 Height="60"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Style="{StaticResource NeonTextBoxStyle}"
                                 TabIndex="9" />

                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="12"
                                    Grid.Column="0"
                                    Margin="0,6"
                                    VerticalAlignment="Top">
                            <Image Source="{StaticResource Notes}"
                                   Width="16"
                                   Height="16"
                                   Margin="0,0,6,0" />
                            <TextBlock Text="Notes: ( Device Passwords, Device Diagnoses, Email )"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Top"
                                       Width="110"
                                       Height="60" />
                        </StackPanel>
                        <TextBox Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="12"
                                 Grid.Column="1"
                                 Margin="4"
                                 Height="60"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Style="{StaticResource NeonTextBoxStyle}"
                                 TabIndex="10" />

                        <!-- ================= BOARD MODIFICATIONS ================= -->
                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="13"
                                    Grid.Column="0"
                                    Margin="0,6"
                                    VerticalAlignment="Top">
                            <Image Source="{StaticResource BoardMod}"
                                   Width="16"
                                   Height="16"
                                   Margin="0,0,6,0" />
                            <TextBlock Text="Board Modifications:"
                                       VerticalAlignment="Top" />
                        </StackPanel>
                        <TextBox Text="{Binding BoardModifications, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="13"
                                 Grid.Column="1"
                                 Margin="4"
                                 Height="60"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Style="{StaticResource NeonTextBoxStyle}" />

                        <!-- ================= STATUS & PRIORITY ================= -->
                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="14"
                                    Grid.Column="0"
                                    Margin="0,6"
                                    VerticalAlignment="Center">
                            <Image Source="{StaticResource RepairStatus}"
                                   Width="16"
                                   Height="16"
                                   Margin="0,0,6,0" />
                            <TextBlock Text="Repair Status:"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ComboBox SelectedItem="{Binding RepairStatus, Mode=TwoWay}"
                                  Grid.Row="14"
                                  Grid.Column="1"
                                  Margin="4"
                                  Style="{StaticResource NeonComboBoxStyle}"
                                  TabIndex="11">
                            <ComboBox.ItemsSource>
                                <x:Array Type="{x:Type sys:String}"
                                         xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                    <sys:String>Received</sys:String>
                                    <sys:String>Diagnosing</sys:String>
                                    <sys:String>Waiting for Parts</sys:String>
                                    <sys:String>In Repair</sys:String>
                                    <sys:String>Testing</sys:String>
                                    <sys:String>Waiting For Client Approval</sys:String>
                                    <sys:String>Ready for Pickup</sys:String>
                                    <sys:String>Completed</sys:String>
                                    <sys:String>Cancelled</sys:String>
                                </x:Array>
                            </ComboBox.ItemsSource>
                        </ComboBox>

                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="15"
                                    Grid.Column="0"
                                    Margin="0,6"
                                    VerticalAlignment="Center">
                            <Image Source="{StaticResource Priority}"
                                   Width="16"
                                   Height="16"
                                   Margin="0,0,6,0" />
                            <TextBlock Text="Priority:"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ComboBox SelectedItem="{Binding PriorityLevel, Mode=TwoWay}"
                                  Grid.Row="15"
                                  Grid.Column="1"
                                  Width="130"
                                  Margin="4"
                                  HorizontalAlignment="Left"
                                  Style="{StaticResource NeonComboBoxStyle}"
                                  TabIndex="12">
                                <ComboBox.ItemsSource>
                                    <x:Array Type="{x:Type sys:String}"
                                             xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                        <sys:String>Minor</sys:String>
                                        <sys:String>Normal</sys:String>
                                        <sys:String>Major</sys:String>
                                        <sys:String>Critical</sys:String>
                                    </x:Array>
                                </ComboBox.ItemsSource>
                        </ComboBox>

                        <!-- ================= COST ================= -->
                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="16"
                                    Grid.Column="0"
                                    Margin="0,6"
                                    VerticalAlignment="Center">
                            <Image Source="{StaticResource EstimatedCost}"
                                   Width="16"
                                   Height="16"
                                   Margin="0,0,6,0" />
                            <TextBlock Text="Estimated Cost:"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Row="16"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Margin="4">
                            <TextBox Text="{Binding EstimatedCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                     Width="120"
                                     Margin="0,0,6,0"
                                     Style="{StaticResource NeonTextBoxStyle}"
                                     TabIndex="14"
                                     KeyDown="SingleLineTextBox_KeyDown" />

                            <ComboBox Width="80"
                                      SelectedItem="{Binding EstimatedCostCurrency, Mode=TwoWay}"
                                      Style="{StaticResource NeonComboBoxStyle}"
                                      ItemsSource="{Binding Currencies}"/>

                            <TextBlock Text="{Binding EstimatedCostEquivalent}"
                                       Foreground="#FFD54A"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="17"
                                    Grid.Column="0"
                                    Margin="0,6"
                                    VerticalAlignment="Center">
                            <Image Source="{StaticResource FinalCost}"
                                   Width="16"
                                   Height="16"
                                   Margin="0,0,6,0" />
                            <TextBlock Text="Final Cost:"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Row="17"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Margin="4">
                            <TextBox Text="{Binding FinalCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                     Width="120"
                                     Margin="0,0,6,0"
                                     Style="{StaticResource NeonTextBoxStyle}"
                                     TabIndex="15"
                                     KeyDown="SingleLineTextBox_KeyDown" />

                            <ComboBox Width="80"
                                      SelectedItem="{Binding FinalCostCurrency, Mode=TwoWay}"
                                      Style="{StaticResource NeonComboBoxStyle}"
                                      ItemsSource="{Binding Currencies}"/>

                            <TextBlock Text="{Binding FinalCostEquivalent}"
                                       Foreground="#FFD54A"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- ================= WARRANTY ================= -->
                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="18"
                                    Grid.Column="0"
                                    Margin="0,6"
                                    VerticalAlignment="Center">
                            <Image Source="{StaticResource Warranty}"
                                   Width="22"
                                   Height="22"
                                   Margin="-3,0,3,0" />
                            <TextBlock Text="Warranty:"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="18"
                                    Grid.Column="1"
                                    Margin="4">
                            <CheckBox IsChecked="{Binding HasWarranty}"
                                      Style="{StaticResource NeonCheckBoxStyle}"
                                      Margin="0,0,8,0"
                                      TabIndex="18" />
                            <ComboBox Width="160"
                                      IsEnabled="{Binding HasWarranty}"
                                      SelectedItem="{Binding WarrantyPeriod, Mode=TwoWay}"
                                      Style="{StaticResource NeonComboBoxStyle}"
                                      TabIndex="19">
                                <ComboBox.ItemsSource>
                                    <x:Array Type="{x:Type sys:String}"
                                             xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                        <sys:String>1 Day</sys:String>
                                        <sys:String>7 Days</sys:String>
                                        <sys:String>14 Days</sys:String>
                                        <sys:String>30 Days</sys:String>
                                        <sys:String>90 Days</sys:String>
                                        <sys:String>6 Months</sys:String>
                                        <sys:String>1 Year</sys:String>
                                    </x:Array>
                                </ComboBox.ItemsSource>
                            </ComboBox>
                        </StackPanel>

                        <!-- ================= REPAIR ON WARRANTY ================= -->
                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="19"
                                    Grid.Column="0"
                                    Margin="0,6"
                                    VerticalAlignment="Center">
                            <Image Source="{StaticResource RepOnWar}"
                                   Width="16"
                                   Height="16"
                                   Margin="0,0,6,0" />
                            <TextBlock Text="Repair on Warranty:"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <CheckBox IsChecked="{Binding IsWarrantyRepair}"
                                  Grid.Row="19"
                                  Grid.Column="1"
                                  Margin="4"
                                  Style="{StaticResource NeonCheckBoxStyle}"
                                  TabIndex="20" />

                        <!-- ================= ROOT CAUSE ================= -->
                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="20"
                                    Grid.Column="0"
                                    Margin="0,6"
                                    VerticalAlignment="Center">
                            <Image Source="{StaticResource RootCause}"
                                   Width="16"
                                   Height="16"
                                   Margin="0,0,6,0" />
                            <TextBlock Text="Root Cause:"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ComboBox SelectedItem="{Binding RootCause, Mode=TwoWay}"
                                  Grid.Row="20"
                                  Grid.Column="1"
                                  Margin="4"
                                  Style="{StaticResource NeonComboBoxStyle}"
                                  TabIndex="16">
                            <ComboBox.ItemsSource>
                                <x:Array Type="{x:Type sys:String}"
                                         xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                    <sys:String>Electrical Cause</sys:String>
                                    <sys:String>Mechanical Cause</sys:String>
                                    <sys:String>Environmental Cause</sys:String>
                                    <sys:String>Human Cause</sys:String>
                                </x:Array>
                            </ComboBox.ItemsSource>
                        </ComboBox>

                        <!-- ================= PARTS USED ================= -->
                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="21"
                                    Grid.Column="0"
                                    Margin="0,6"
                                    VerticalAlignment="Top">
                            <Image Source="{StaticResource PartsUsed}"
                                   Width="16"
                                   Height="16"
                                   Margin="0,0,6,0" />
                            <TextBlock Text="Parts Used:"
                                       VerticalAlignment="Top" />
                        </StackPanel>

                        <StackPanel Grid.Row="21"
                                    Grid.Column="1"
                                    Margin="4">

                            <!-- ── Chips: each used part as a pill with qty controls ── -->
                            <ItemsControl ItemsSource="{Binding UsedPartLines}"
                                          Margin="0,0,0,6">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10"
                                                Margin="0,0,6,6"
                                                Padding="7,4"
                                                BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background"   Value="{StaticResource CardBackgroundBrush}" />
                                                    <Setter Property="BorderBrush"  Value="{StaticResource BorderDarkBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCustom}"    Value="True">
                                                            <Setter Property="BorderBrush" Value="Orange" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#FF5A5A" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center">

                                                <!-- ⚠ badge for custom (not-in-catalog) parts -->
                                                <TextBlock Foreground="Orange"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           ToolTip="Custom part — not found in catalog">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text"       Value="⚠ " />
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCustom}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Part name -->
                                                <TextBlock Text="{Binding Name}"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           Margin="0,0,8,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                                    <Setter Property="Foreground" Value="#FF9A9A" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Decrement button -->
                                                <Button Content="−"
                                                        Command="{Binding DataContext.DecrementPartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Remove one">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background"   Value="Transparent" />
                                                            <Setter Property="BorderThickness" Value="0" />
                                                            <Setter Property="Foreground"   Value="{StaticResource TextPrimaryBrush}" />
                                                            <Setter Property="FontSize"     Value="14" />
                                                            <Setter Property="Padding"      Value="3,0" />
                                                            <Setter Property="Cursor"       Value="Hand" />
                                                            <Setter Property="Width"        Value="20" />
                                                            <Setter Property="Height"       Value="20" />
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Quantity display -->
                                                <TextBlock Text="{Binding Quantity}"
                                                           MinWidth="18"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />

                                                <!-- Increment button -->
                                                <Button Content="+"
                                                        Command="{Binding DataContext.IncrementPartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Add one more">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background"   Value="Transparent" />
                                                            <Setter Property="BorderThickness" Value="0" />
                                                            <Setter Property="Foreground"   Value="{StaticResource TextPrimaryBrush}" />
                                                            <Setter Property="FontSize"     Value="14" />
                                                            <Setter Property="Padding"      Value="3,0" />
                                                            <Setter Property="Cursor"       Value="Hand" />
                                                            <Setter Property="Width"        Value="20" />
                                                            <Setter Property="Height"       Value="20" />
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Remove chip entirely -->
                                                <Button Content="✕"
                                                        Margin="6,0,0,0"
                                                        Style="{StaticResource PartsRemoveIconButtonStyle}"
                                                        Command="{Binding DataContext.RemovePartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Remove part" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ── Input + popup ── -->
                            <Grid>
                                <TextBox x:Name="PartsUsedInputBox"
                                         Text="{Binding PartsUsedInput, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource NeonTextBoxStyle}"
                                         ToolTip="Type to search • ↑↓ navigate • Enter/Tab to add • Esc to close"
                                         TabIndex="17">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter"  Command="{Binding AddPartFromInputCommand}" />
                                        <KeyBinding Key="Tab"    Command="{Binding AcceptSuggestionCommand}" />
                                        <KeyBinding Key="Down"   Command="{Binding SuggestionMoveDownCommand}" />
                                        <KeyBinding Key="Up"     Command="{Binding SuggestionMoveUpCommand}" />
                                        <KeyBinding Key="Escape" Command="{Binding CloseSuggestionsCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>

                                <Popup IsOpen="{Binding IsPartsSuggestionOpen}"
                                       PlacementTarget="{Binding ElementName=PartsUsedInputBox}"
                                       Placement="Bottom"
                                       StaysOpen="False"
                                       AllowsTransparency="True">
                                    <Border Background="{StaticResource CardBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderDarkBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="4"
                                            MinWidth="300">
                                        <ListBox ItemsSource="{Binding PartsSuggestions}"
                                                 SelectedIndex="{Binding SelectedSuggestionIndex, Mode=TwoWay}"
                                                 MaxHeight="200"
                                                 Background="Transparent"
                                                 BorderThickness="0">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding"    Value="0" />
                                                    <Setter Property="Margin"     Value="0,1" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="Bd"
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderBrush="Transparent"
                                                                        BorderThickness="1"
                                                                        CornerRadius="4"
                                                                        Padding="2">
                                                                    <ContentPresenter />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsSelected"   Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource NewPrimaryBlueBrush}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver"  Value="True">
                                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NewPrimaryBlueBrush}" />
                                                                        <Setter TargetName="Bd" Property="Effect">
                                                                            <Setter.Value>
                                                                                <DropShadowEffect BlurRadius="10"
                                                                                                  ShadowDepth="0"
                                                                                                  Opacity="0.75"
                                                                                                  Color="#5AA7FF" />
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.AddPartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="6,5"
                                                            Focusable="False"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="OverridesDefaultStyle" Value="True" />
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <ContentPresenter />
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Grid HorizontalAlignment="Stretch">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Part name -->
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Name}"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="12">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                                                <Setter Property="Foreground" Value="#FF9A9A" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <!-- Stock badge -->
                                                            <Border Grid.Column="1"
                                                                    CornerRadius="4"
                                                                    Padding="6,2"
                                                                    Margin="8,0,0,0">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#1A5AA7FF" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                                                <Setter Property="Background" Value="#1AFF5A5A" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                                                <Setter Property="Background" Value="#1AFFD54A" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding StockDisplay}"
                                                                           FontSize="10">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="#5AA7FF" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                                                    <Setter Property="Foreground" Value="#FF5A5A" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                                                    <Setter Property="Foreground" Value="#FFD54A" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>

                        <GroupBox Header="Status Timeline"
                                  Grid.Row="22"
                                  Grid.ColumnSpan="2"
                                  Margin="0,12,0,0"
                                  Style="{StaticResource GradientAccentGroupBox}">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Note for status change:"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11"/>
                                    <TextBox Text="{Binding StatusChangeNote, UpdateSourceTrigger=PropertyChanged}"
                                             Width="220"
                                             Style="{StaticResource NeonTextBoxStyle}"/>
                                </StackPanel>

                                <ItemsControl Grid.Row="1" ItemsSource="{Binding StatusHistory}" MaxHeight="160">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                <TextBlock Text="{Binding ChangedAtDisplay}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="11"
                                                           Width="115"/>
                                                <TextBlock Text="{Binding OldStatus}" Foreground="#FF9A9A" FontSize="11"/>
                                                <TextBlock Text=" → " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding NewStatus}" Foreground="#5AA7FF" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Note, StringFormat=' — {0}'}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="11"
                                                           FontStyle="Italic"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </GroupBox>

                        <!-- ================= DEVICE CHECK LIST ================= -->
                        <GroupBox Header="Device Check List"
                                  Grid.Row="23"
                                  Grid.ColumnSpan="2"
                                  Margin="0,12,0,0"
                                  FontWeight="Bold"
                                  Style="{StaticResource GradientRedGroupBox}">
                            <UniformGrid Columns="2"
                                         Margin="8">

                                <!-- ===== Power & System ===== -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Powers On:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckPowerOn}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Boots to OS:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckBoots}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Battery Charging:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckBatteryCharging}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Battery Health:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckBatteryHealth}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Overheating:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckOverheating}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <!-- ===== Display & Input ===== -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Screen / Display:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckScreen}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Touch Response:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckTouch}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Dead Pixels / Lines:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckDeadPixels}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Buttons:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckButtons}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <!-- ===== Audio & Camera ===== -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Speaker:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckSpeaker}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Microphone:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckMicrophone}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Front Camera:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckFrontCamera}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Rear Camera:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckRearCamera}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <!-- ===== Connectivity ===== -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="WiFi:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckWiFi}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Bluetooth:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckBluetooth}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Cellular / Signal:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckCellular}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="USB / Ports:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckPorts}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <!-- ===== Security & Software ===== -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Face ID / Fingerprint:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckBiometrics}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Activation / Account Lock:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckActivationLock}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Storage Detected:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckStorage}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <!-- ===== Physical Condition ===== -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Frame / Chassis:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckFrame}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Back Cover:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckCover}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Liquid Damage Indicators:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckLiquidDamage}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Signs of Previous Repair:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckPreviousRepair}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                            </UniformGrid>
                        </GroupBox>

                        <!-- ================= CUSTOMER PROFILE ================= -->
                        <GroupBox Header="{Binding CustomerProfileHeader}"
                                  Grid.Row="25"
                                  Grid.ColumnSpan="2"
                                  Margin="0,12,0,0"
                                  FontWeight="Bold"
                                  Style="{StaticResource GradientAccentGroupBox}">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Margin="0,0,0,6"
                                           Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="Repeat records: " />
                                    <Run Text="{Binding CustomerProfileRepeatCount}" FontWeight="SemiBold" />
                                </TextBlock>

                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding CustomerProfileHistory}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          MinHeight="140"
                                          MaxHeight="220"
                                          Style="{StaticResource DarkDataGridStyle}"
                                          RowStyle="{StaticResource CompactDataGridRowStyle}"
                                          CellStyle="{StaticResource CompactDataGridCellStyle}"
                                          ColumnHeaderStyle="{StaticResource CompactDataGridHeaderStyle}"
                                          AlternatingRowBackground="{StaticResource DataGridRowAltBackgroundBrush}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Device Serial"
                                                            Binding="{Binding SerialIMEI}"
                                                            Width="107" />
                                        <DataGridTextColumn Header="Problem Description"
                                                            Binding="{Binding ProblemDescription}"
                                                            Width="150" />
                                        <DataGridTextColumn Header="Damage History"
                                                            Binding="{Binding DamageHistory}"
                                                            Width="150" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </GroupBox>

                        <!-- ================= ACCESSORIES ================= -->
                        <GroupBox Header="Accessories"
                                  Grid.Row="24"
                                  Grid.ColumnSpan="2"
                                  Margin="0,12,0,0"
                                  FontWeight="Bold"
                                  Style="{StaticResource GradientBlueCyanGroupBox}">
                            <UniformGrid Columns="2"
                                         Margin="8">

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Software:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessorySoftware}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="USB Stick:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessoryUSBStick}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Case:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessoryCase}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Charger:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessoryCharger}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Battery:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessoryBattery}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Monitor:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessoryMonitor}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Power Cord:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessoryPowerCord}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Original Package:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessoryOriginalPackage}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Memory Card:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessoryMemoryCard}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Cables:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessoryCables}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Mouse:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessoryMouse}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Keyboard:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessoryKeyboard}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <!-- ===== Added Professional Intake Items ===== -->

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="SIM Card:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessorySIMCard}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="SD Adapter:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessorySDAdapter}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Stylus / Pen:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessoryStylus}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Docking Station:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessoryDock}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="External Drive:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessoryExternalDrive}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,12,6">
                                    <TextBlock Text="Headphones / Earbuds:"
                                               VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding Accessories.AccessoryHeadphones}"
                                              Style="{StaticResource NeonCheckBoxStyle}"
                                              Margin="6,0,0,0" />
                                </StackPanel>

                            </UniformGrid>
                        </GroupBox>

                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
