<UserControl x:Class="ESCenter.Views.RepairTicketsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ESCenter.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:ESCenter.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:RepairTicketsViewModel, IsDesignTimeCreatable=True}"
             Background="Transparent"
             Height="Auto"
             Width="Auto">

    <UserControl.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>

        <Style x:Key="TicketTabItemStyle" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="2"/>
                            </Grid.RowDefinitions>

                            <Border x:Name="HoverBg"
                                    Grid.Row="0"
                                    Background="Transparent"
                                    CornerRadius="5"
                                    Margin="2,3,2,0"/>

                            <ContentPresenter Grid.Row="0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              ContentSource="Header"/>

                            <Border x:Name="ActiveLine"
                                    Grid.Row="1"
                                    CornerRadius="1"
                                    Margin="6,0"
                                    Opacity="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#00E5D4" Offset="0"/>
                                        <GradientStop Color="#00A8C8" Offset="0.5"/>
                                        <GradientStop Color="#2952D9" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#00E5D4" BlurRadius="8" ShadowDepth="0" Opacity="0.85"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverBg" Property="Background" Value="#12237EF2"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ActiveLine" Property="Opacity" Value="1"/>
                                <Setter TargetName="HoverBg" Property="Background" Value="#0D00E5D4"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#00E5D4" Offset="0"/>
                                            <GradientStop Color="#5AA7FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TicketTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top"
                                    Background="#0A000000"
                                    BorderBrush="{StaticResource BorderDarkBrush}"
                                    BorderThickness="0,0,0,1">
                                <TabPanel x:Name="HeaderPanel"
                                          IsItemsHost="True"
                                          KeyboardNavigation.TabIndex="1"/>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,8,0,0"
                                          Focusable="False">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="0"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </ScrollViewer>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <views:TicketListPanel />

        <Border Grid.Column="1"
                Style="{StaticResource CardBorderStyle}"
                Padding="12"
                KeyboardNavigation.TabNavigation="Cycle">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <Grid DockPanel.Dock="Left" Margin="0,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="0,0,10,0" CornerRadius="2">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00E5D4" Offset="0"/>
                                    <GradientStop Color="#237EF2" Offset="0.5"/>
                                    <GradientStop Color="#2952D9" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <TextBlock Grid.Column="1"
                                   Text="Ticket Details"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Gradient.Primary.Horizontal}" />

                        <Border Grid.Column="2"
                                Margin="12,0,0,0"
                                Padding="6,2"
                                CornerRadius="4"
                                Background="#2A1800"
                                BorderBrush="#FF8C42"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="● Unsaved changes"
                                       Foreground="#FF8C42"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Command="{Binding AddCommand}"
                                Style="{StaticResource GradientBorderButtonStyleGreen}"
                                Width="34"
                                Height="30"
                                Margin="4,0"
                                TabIndex="22"
                                IsDefault="False"
                                ToolTip="Add">
                            <Image Source="{StaticResource Add}" Width="16" Height="16" />
                        </Button>

                        <Button Command="{Binding SaveCommand}"
                                Width="34"
                                Height="30"
                                Margin="4,0"
                                TabIndex="23"
                                IsDefault="False"
                                ToolTip="Save">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GradientBorderButtonStyleBLueCyan}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                            <Setter Property="BorderBrush" Value="#FF8C42" />
                                            <Setter Property="BorderThickness" Value="1.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Image Source="{StaticResource Save}" Width="18" Height="18" />
                        </Button>

                        <Button Command="{Binding ClearCommand}"
                                Style="{StaticResource GradientBorderButtonStyleYellow}"
                                Width="34"
                                Height="30"
                                Margin="4,0"
                                TabIndex="24"
                                IsDefault="False"
                                ToolTip="Clear">
                            <Image Source="{StaticResource Clear}" Width="16" Height="16" />
                        </Button>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="8,6"
                            Background="#0D237EF2"
                            BorderBrush="{StaticResource BorderDarkBrush}"
                            BorderThickness="0,0,0,1">
                        <views:TicketInfoPanel/>
                    </Border>

                    <TabControl Grid.Row="1"
                                x:Name="DetailTabs"
                                TabStripPlacement="Top"
                                Style="{StaticResource TicketTabControlStyle}"
                                ItemContainerStyle="{StaticResource TicketTabItemStyle}">
                        <TabItem x:Name="TabInfo">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{StaticResource RepairStatus}" Width="14" Height="14" Margin="0,0,5,0"/>
                                    <TextBlock Text="Info"/>
                                    <Ellipse Width="6" Height="6" Fill="#FF8C42"
                                             VerticalAlignment="Top" Margin="3,-2,0,0"
                                             Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                            <Image Source="{StaticResource RepairStatus}" Width="13" Height="13" Margin="0,0,5,0"/>
                                            <TextBlock Text="Repair Status:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ComboBox Grid.Row="0" Grid.Column="1"
                                                  SelectedItem="{Binding RepairStatus, Mode=TwoWay}"
                                                  Margin="4,0,0,8" Style="{StaticResource GradiantComboboxStyle11}">
                                            <ComboBox.ItemsSource>
                                                <x:Array Type="{x:Type sys:String}">
                                                    <sys:String>Received</sys:String>
                                                    <sys:String>Diagnosing</sys:String>
                                                    <sys:String>Waiting for Parts</sys:String>
                                                    <sys:String>In Repair</sys:String>
                                                    <sys:String>Testing</sys:String>
                                                    <sys:String>Waiting For Client Approval</sys:String>
                                                    <sys:String>Completed</sys:String>
                                                    <sys:String>Cancelled</sys:String>
                                                </x:Array>
                                            </ComboBox.ItemsSource>
                                        </ComboBox>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                            <Image Source="{StaticResource Priority}" Width="13" Height="13" Margin="0,0,5,0"/>
                                            <TextBlock Text="Priority:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ComboBox Grid.Row="1" Grid.Column="1"
                                                  SelectedItem="{Binding PriorityLevel, Mode=TwoWay}"
                                                  Width="130" HorizontalAlignment="Left"
                                                  Margin="4,0,0,8" Style="{StaticResource GradiantComboboxStyle11}">
                                            <ComboBox.ItemsSource>
                                                <x:Array Type="{x:Type sys:String}">
                                                    <sys:String>Minor</sys:String>
                                                    <sys:String>Normal</sys:String>
                                                    <sys:String>Major</sys:String>
                                                    <sys:String>Critical</sys:String>
                                                </x:Array>
                                            </ComboBox.ItemsSource>
                                        </ComboBox>
                                    </Grid>

                                    <GroupBox Header="Status Timeline"
                                              Margin="0,12,0,0"
                                              Style="{StaticResource GradientGroupBoxAccent}">
                                        <Grid Margin="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="Note for status change:"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="11"/>
                                                <TextBox Text="{Binding StatusChangeNote, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="220"
                                                         Style="{StaticResource GradiantTextboxStyle1}"/>
                                            </StackPanel>

                                            <ItemsControl Grid.Row="1" ItemsSource="{Binding StatusHistory}" MaxHeight="160">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                                            <TextBlock Text="{Binding ChangedAtDisplay}"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="11"
                                                                       Width="115"/>
                                                            <TextBlock Text="{Binding OldStatus}" Foreground="#FF9A9A" FontSize="11"/>
                                                            <TextBlock Text=" → " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                            <TextBlock Text="{Binding NewStatus}" Foreground="#5AA7FF" FontSize="11" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Note, StringFormat=' — {0}'}"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="11"
                                                                       FontStyle="Italic"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="TabCustomer">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{StaticResource AddressBook}" Width="14" Height="14" Margin="0,0,5,0"/>
                                    <TextBlock Text="Customer"/>
                                    <Ellipse Width="6" Height="6" Fill="#FF8C42"
                                             VerticalAlignment="Top" Margin="3,-2,0,0"
                                             Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <views:TicketCustomerPanel x:Name="CustomerPanelRef"/>

                                    <GroupBox Header="Recent Client History"
                                              Margin="0,12,0,0"
                                              Style="{StaticResource GradientGroupBoxAccent}"
                                              Visibility="{Binding HasClientHistory, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Expander IsExpanded="False"
                                                  Background="Transparent"
                                                  BorderThickness="0">
                                            <DataGrid ItemsSource="{Binding ClientHistory}"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      MinHeight="110"
                                                      MaxHeight="220"
                                                      Style="{StaticResource DarkDataGridStyle}"
                                                      RowStyle="{StaticResource CompactDataGridRowStyle}"
                                                      CellStyle="{StaticResource CompactDataGridCellStyle}"
                                                      ColumnHeaderStyle="{StaticResource CompactDataGridHeaderStyle}"
                                                      AlternatingRowBackground="{StaticResource DataGridRowAltBackgroundBrush}">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="Ticket ID" Width="85">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Command="{Binding DataContext.SelectClientHistoryTicketCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource GradientBorderButtonStyleBLueCyan}"
                                                                        Padding="8,2"
                                                                        MinWidth="65"
                                                                        MinHeight="20"
                                                                        Height="20"
                                                                        HorizontalAlignment="Left">
                                                                    <TextBlock Text="{Binding TicketId}" />
                                                                </Button>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Date"
                                                                        Binding="{Binding ReceiveDate, StringFormat={}{0:yyyy-MM-dd}}"
                                                                        Width="110" />
                                                    <DataGridTextColumn Header="Device"
                                                                        Binding="{Binding DeviceModel}"
                                                                        Width="95" />
                                                    <DataGridTextColumn Header="Status"
                                                                        Binding="{Binding RepairStatus}"
                                                                        Width="130" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Expander>
                                    </GroupBox>

                                    <GroupBox Header="{Binding CustomerProfileHeader}"
                                              Margin="0,12,0,0"
                                              FontWeight="Bold"
                                              Style="{StaticResource GradientGroupBoxAccent}">
                                        <Grid Margin="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0"
                                                       Margin="0,0,0,6"
                                                       Foreground="{StaticResource TextSecondaryBrush}">
                                                <Run Text="Repeat records: " />
                                                <Run Text="{Binding CustomerProfileRepeatCount}" FontWeight="SemiBold" />
                                            </TextBlock>

                                            <DataGrid Grid.Row="1"
                                                      ItemsSource="{Binding CustomerProfileHistory}"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      MinHeight="140"
                                                      MaxHeight="220"
                                                      Style="{StaticResource DarkDataGridStyle}"
                                                      RowStyle="{StaticResource CompactDataGridRowStyle}"
                                                      CellStyle="{StaticResource CompactDataGridCellStyle}"
                                                      ColumnHeaderStyle="{StaticResource CompactDataGridHeaderStyle}"
                                                      AlternatingRowBackground="{StaticResource DataGridRowAltBackgroundBrush}"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                      ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Device Serial"
                                                        Binding="{Binding SerialIMEI}"
                                                        Width="107" />
                                                    <DataGridTextColumn Header="Problem Description"
                                                        Binding="{Binding ProblemDescription}"
                                                        Width="150" />
                                                    <DataGridTextColumn Header="Damage History"
                                                        Binding="{Binding DamageHistory}"
                                                        Width="150" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="TabDevice">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{StaticResource Model}" Width="14" Height="14" Margin="0,0,5,0"/>
                                    <TextBlock Text="Device"/>
                                    <Ellipse Width="6" Height="6" Fill="#FF8C42"
                                             VerticalAlignment="Top" Margin="3,-2,0,0"
                                             Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <views:TicketDevicePanel/>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="TabRepair">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{StaticResource RootCause}" Width="14" Height="14" Margin="0,0,5,0"/>
                                    <TextBlock Text="Repair"/>
                                    <Ellipse Width="6" Height="6" Fill="#FF8C42"
                                             VerticalAlignment="Top" Margin="3,-2,0,0"
                                             Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <views:TicketRepairPanel/>
                                    <Border Height="1" Background="{StaticResource BorderDarkBrush}" Margin="0,8"/>
                                    <TextBlock Text="Parts Used:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                    <views:TicketPartsPanel/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="TabChecklist">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{StaticResource DmgHistory2}" Width="14" Height="14" Margin="0,0,5,0"/>
                                    <TextBlock Text="Checklist"/>
                                    <Ellipse Width="6" Height="6" Fill="#FF8C42"
                                             VerticalAlignment="Top" Margin="3,-2,0,0"
                                             Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <GroupBox Header="Device Check List"
                                              Margin="0,12,0,0"
                                              FontWeight="Bold"
                                              Style="{StaticResource GradientGroupBoxRed}">
                                        <UniformGrid Columns="2"
                                                     Margin="8">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Powers On:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckPowerOn}" Style="{StaticResource GradientCheckBoxDangerStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Boots to OS:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckBoots}" Style="{StaticResource GradientCheckBoxDangerStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Battery Charging:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckBatteryCharging}" Style="{StaticResource GradientCheckBoxDangerStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Battery Health:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckBatteryHealth}" Style="{StaticResource GradientCheckBoxDangerStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Overheating:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckOverheating}" Style="{StaticResource GradientCheckBoxDangerStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Screen / Display:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckScreen}" Style="{StaticResource GradientCheckBoxDangerStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Touch Response:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckTouch}" Style="{StaticResource GradientCheckBoxDangerStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Dead Pixels / Lines:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckDeadPixels}" Style="{StaticResource GradientCheckBoxDangerStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Buttons:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckButtons}" Style="{StaticResource GradientCheckBoxDangerStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Speaker:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckSpeaker}" Style="{StaticResource GradientCheckBoxDangerStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Microphone:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckMicrophone}" Style="{StaticResource GradientCheckBoxDangerStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Front Camera:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckFrontCamera}" Style="{StaticResource GradientCheckBoxDangerStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Rear Camera:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckRearCamera}" Style="{StaticResource GradientCheckBoxDangerStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="WiFi:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckWiFi}" Style="{StaticResource GradientCheckBoxDangerStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Bluetooth:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckBluetooth}" Style="{StaticResource GradientCheckBoxDangerStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Cellular / Signal:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckCellular}" Style="{StaticResource GradientCheckBoxDangerStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="USB / Ports:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckPorts}" Style="{StaticResource GradientCheckBoxDangerStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Face ID / Fingerprint:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckBiometrics}" Style="{StaticResource GradientCheckBoxDangerStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Activation / Account Lock:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckActivationLock}" Style="{StaticResource GradientCheckBoxDangerStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Storage Detected:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckStorage}" Style="{StaticResource GradientCheckBoxDangerStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Frame / Chassis:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckFrame}" Style="{StaticResource GradientCheckBoxDangerStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Back Cover:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckCover}" Style="{StaticResource GradientCheckBoxDangerStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Liquid Damage Indicators:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckLiquidDamage}" Style="{StaticResource GradientCheckBoxDangerStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Signs of Previous Repair:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckPreviousRepair}" Style="{StaticResource GradientCheckBoxDangerStyle}" Margin="6,0,0,0" /></StackPanel>
                                        </UniformGrid>
                                    </GroupBox>

                                    <GroupBox Header="Accessories"
                                              Margin="0,12,0,0"
                                              FontWeight="Bold"
                                              Style="{StaticResource GradientGroupBoxYellow}">
                                        <UniformGrid Columns="2" Margin="8">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Software:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding Accessories.AccessorySoftware}" Style="{StaticResource GradientCheckBoxWarningStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="USB Stick:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding Accessories.AccessoryUSBStick}" Style="{StaticResource GradientCheckBoxWarningStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Case:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding Accessories.AccessoryCase}" Style="{StaticResource GradientCheckBoxWarningStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Charger:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding Accessories.AccessoryCharger}" Style="{StaticResource GradientCheckBoxWarningStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Battery:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding Accessories.AccessoryBattery}" Style="{StaticResource GradientCheckBoxWarningStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Monitor:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding Accessories.AccessoryMonitor}" Style="{StaticResource GradientCheckBoxWarningStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Power Cord:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding Accessories.AccessoryPowerCord}" Style="{StaticResource GradientCheckBoxWarningStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Original Package:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding Accessories.AccessoryOriginalPackage}" Style="{StaticResource GradientCheckBoxWarningStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Memory Card:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding Accessories.AccessoryMemoryCard}" Style="{StaticResource GradientCheckBoxWarningStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Cables:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding Accessories.AccessoryCables}" Style="{StaticResource GradientCheckBoxWarningStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Mouse:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding Accessories.AccessoryMouse}" Style="{StaticResource GradientCheckBoxWarningStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Keyboard:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding Accessories.AccessoryKeyboard}" Style="{StaticResource GradientCheckBoxWarningStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="SIM Card:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding Accessories.AccessorySIMCard}" Style="{StaticResource GradientCheckBoxWarningStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="SD Adapter:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding Accessories.AccessorySDAdapter}" Style="{StaticResource GradientCheckBoxWarningStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Stylus / Pen:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding Accessories.AccessoryStylus}" Style="{StaticResource GradientCheckBoxWarningStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Docking Station:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding Accessories.AccessoryDock}" Style="{StaticResource GradientCheckBoxWarningStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="External Drive:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding Accessories.AccessoryExternalDrive}" Style="{StaticResource GradientCheckBoxWarningStyle}" Margin="6,0,0,0" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="Headphones / Earbuds:" VerticalAlignment="Center" /><CheckBox IsChecked="{Binding Accessories.AccessoryHeadphones}" Style="{StaticResource GradientCheckBoxWarningStyle}" Margin="6,0,0,0" /></StackPanel>
                                        </UniformGrid>
                                    </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="TabNotes">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{StaticResource Notes}" Width="14" Height="14" Margin="0,0,5,0"/>
                                    <TextBlock Text="Notes"/>
                                    <Ellipse Width="6" Height="6" Fill="#FF8C42"
                                             VerticalAlignment="Top" Margin="3,-2,0,0"
                                             Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <views:TicketDeviceNotesPanel/>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
