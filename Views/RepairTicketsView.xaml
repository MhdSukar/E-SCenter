<UserControl x:Class="ESCenter.Views.RepairTicketsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ESCenter.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:RepairTicketsViewModel, IsDesignTimeCreatable=True}"
             Background="Transparent"
             Height="Auto" Width="Auto">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT: TICKETS GRID ================= -->
        <Border Style="{StaticResource CardBorderStyle}" Padding="8" Margin="0,0,10,0">
            <DockPanel>

                <!-- ================= HEADER ================= -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Repair Tickets"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource NewPrimaryBlueBrush}"
                               DockPanel.Dock="Left"/>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">

                        <Button Command="{Binding CloseCommand}"
                                Style="{StaticResource NeonGreenButtonStyle}"
                                Width="80"
                                Margin="4,0"
                                IsEnabled="{Binding SelectedTicket}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource Completed}" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Close"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ReopenCommand}"
                                Style="{StaticResource NeonOrangeButtonStyle}"
                                Width="80"
                                Margin="4,0"
                                IsEnabled="{Binding SelectedTicket}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource Reopen}" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Reopen"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding DeleteCommand}"
                                Style="{StaticResource NeonRedButtonStyle}"
                                Width="80"
                                Margin="4,0"
                                IsEnabled="{Binding SelectedTicket}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource Delete}" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Delete"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </DockPanel>

                <!-- ================= SEARCH + FILTER BAR ================= -->
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8"
                        Margin="0,0,0,8">

                    <DockPanel LastChildFill="False">

                        <!-- Left side -->
                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Left"
                                    VerticalAlignment="Center">

                            <!-- Icon slot -->
                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="6"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderDarkBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <Image Source="{StaticResource search_insights}"
                                       Width="16"
                                       Height="16"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                            </Border>

                            <!-- Search box -->
                            <TextBox Width="240"
                                     Margin="0,0,12,0"
                                     Padding="6,4"
                                     Style="{StaticResource NeonTextBoxStyle}"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />

                            <!-- Status filter -->
                            <ComboBox Width="140"
                                      Margin="0,0,10,0"
                                      Style="{StaticResource NeonComboBoxStyle}"
                                      ItemsSource="{Binding StatusFilters}"
                                      SelectedItem="{Binding SelectedStatusFilter}" />

                            <!-- Priority filter -->
                            <ComboBox Width="140"
                                      Style="{StaticResource NeonComboBoxStyle}"
                                      ItemsSource="{Binding PriorityFilters}"
                                      SelectedItem="{Binding SelectedPriorityFilter}" />

                        </StackPanel>

                    </DockPanel>
                </Border>

                <!-- ================= TICKETS GRID ================= -->
                <DataGrid ItemsSource="{Binding TicketsView}"
                          SelectedItem="{Binding SelectedTicket, Mode=TwoWay}"
                          IsSynchronizedWithCurrentItem="True"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Style="{StaticResource DarkDataGridStyle}"
                          RowStyle="{StaticResource TicketRowStyle}"
                          CellStyle="{StaticResource TicketCellStyle}"
                          ColumnHeaderStyle="{StaticResource CompactDataGridHeaderStyle}"
                          AlternatingRowBackground="{StaticResource DataGridRowAltBackgroundBrush}"
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ESC-ID" Binding="{Binding EscTicketId}" Width="70"/>
                        <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName}" Width="120"/>
                        <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="100"/>
                        <DataGridTextColumn Header="Device" Binding="{Binding DeviceCategory}" Width="80"/>
                        <DataGridTextColumn Header="Model" Binding="{Binding DeviceModel}" Width="100"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding RepairStatus}" Width="90"/>
                        <DataGridTextColumn Header="Priority" Binding="{Binding PriorityLevel}" Width="75" CellStyle="{StaticResource PriorityCellStyle}"/>
                        <DataGridTextColumn Header="Received" Binding="{Binding ReceiveDate, StringFormat='yyyy-MM-dd HH:mm'}" Width="95"/>
                        <DataGridTextColumn Header="Delivery" Binding="{Binding DeliveryDate, StringFormat='yyyy-MM-dd HH:mm'}" Width="95"/>
                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

            </DockPanel>
        </Border>

        <!-- ================= RIGHT: DETAIL INSPECTOR ================= -->
        <Border Grid.Column="1"
                Style="{StaticResource CardBorderStyle}"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Ticket Details"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </DockPanel>

                <!-- Footer -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,12">

                    <Button Command="{Binding AddCommand}"
                            Style="{StaticResource NeonGreenButtonStyle}"
                            Width="80"
                            Margin="4,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{StaticResource AddTask}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Add"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SaveCommand}"
                            Style="{StaticResource NeonCyanButtonStyle}"
                            Width="100"
                            Margin="4,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{StaticResource save}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Save"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ClearCommand}"
                            Style="{StaticResource NeonOrangeButtonStyle}"
                            Width="80"
                            Margin="4,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{StaticResource ClearAll}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Clear"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

                <!-- Form -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- 0 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 1 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 2 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 3 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 4 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 5 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 6 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 7 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 8 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 9 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 10 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 11 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 12 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 13 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 14 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 15 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 16 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 17 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 18 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 19 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 20 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 21 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 22 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 23 -->
                        </Grid.RowDefinitions>

                        <!-- ================= CUSTOMER INFO ================= -->
                        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0" Margin="0,6" VerticalAlignment="Center">
                            <Image Source="{StaticResource verified}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Ready for Pickup:" VerticalAlignment="Center"/>
                        </StackPanel>
                        <CheckBox IsChecked="{Binding IsReadyForPickup, Mode=TwoWay}" Grid.Row="0" Grid.Column="1" Margin="4" Style="{StaticResource NeonCheckBoxStyle}"/>

                        <!-- ================= UNIQUE ESC ID ================= -->
                        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0" Margin="0,6" VerticalAlignment="Center">
                            <Image Source="{StaticResource edit_audio}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Ticket Code:" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBox Text="{Binding EscTicketId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="1" Grid.Column="1" Margin="4" Style="{StaticResource NeonTextBoxStyle}"
                                 ToolTip="Format: ESC-000001"
                                 Focusable="False"/>

                        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="0" Margin="0,6" VerticalAlignment="Center">
                            <Image Source="{StaticResource IDCARD}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Customer ID:" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBox Text="{Binding CustomerIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="2" Grid.Column="1" Margin="4" Style="{StaticResource NeonTextBoxStyle}"/>

                        <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="0" Margin="0,6" VerticalAlignment="Center">
                            <Image Source="{StaticResource identity}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Customer Name:" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBox Text="{Binding CustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="3" Grid.Column="1" Margin="4" Style="{StaticResource NeonTextBoxStyle}"/>

                        <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="0" Margin="0,6" VerticalAlignment="Center">
                            <Image Source="{StaticResource ContactMethod}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Phone:" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBox Text="{Binding PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="4" Grid.Column="1" Margin="4" Style="{StaticResource NeonTextBoxStyle}"/>

                        <StackPanel Orientation="Horizontal" Grid.Row="5" Grid.Column="0" Margin="0,6" VerticalAlignment="Center">
                            <Image Source="{StaticResource ContactMethod}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Contact Method:" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ComboBox SelectedItem="{Binding ContactMethod, Mode=TwoWay}"
                                  Grid.Row="5" Grid.Column="1" Margin="4" Style="{StaticResource NeonComboBoxStyle}">
                            <ComboBox.ItemsSource>
                                <x:Array Type="{x:Type sys:String}" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                    <sys:String>Call</sys:String>
                                    <sys:String>WhatsApp</sys:String>
                                    <sys:String>SMS</sys:String>
                                    <sys:String>Email</sys:String>
                                    <sys:String>None</sys:String>
                                </x:Array>
                            </ComboBox.ItemsSource>
                        </ComboBox>

                        <!-- ================= DEVICE INFO ================= -->
                        <StackPanel Orientation="Horizontal" Grid.Row="6" Grid.Column="0" Margin="0,6" VerticalAlignment="Center">
                            <Image Source="{StaticResource segment}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Device Category:" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBox Text="{Binding DeviceCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="6" Grid.Column="1" Margin="4" Style="{StaticResource NeonTextBoxStyle}"/>

                        <StackPanel Orientation="Horizontal" Grid.Row="7" Grid.Column="0" Margin="0,6" VerticalAlignment="Center">
                            <Image Source="{StaticResource Brand}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Brand:" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBox Text="{Binding DeviceBrand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="7" Grid.Column="1" Margin="4" Style="{StaticResource NeonTextBoxStyle}"/>

                        <StackPanel Orientation="Horizontal" Grid.Row="8" Grid.Column="0" Margin="0,6" VerticalAlignment="Center">
                            <Image Source="{StaticResource DeviceModel}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Model:" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBox Text="{Binding DeviceModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="8" Grid.Column="1" Margin="4" Style="{StaticResource NeonTextBoxStyle}"/>

                        <!-- ================= DAMAGE HISTORY ================= -->
                        <StackPanel Orientation="Horizontal" Grid.Row="9" Grid.Column="0" Margin="0,6" VerticalAlignment="Top">
                            <Image Source="{StaticResource Warning}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Damage History:" VerticalAlignment="Top"/>
                        </StackPanel>
                        <TextBox Text="{Binding DamageHistory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="9" Grid.Column="1" Margin="4" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                 Style="{StaticResource NeonTextBoxStyle}"/>

                        <StackPanel Orientation="Horizontal" Grid.Row="10" Grid.Column="0" Margin="0,6" VerticalAlignment="Center">
                            <Image Source="{StaticResource Serial}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Serial / IMEI:" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBox Text="{Binding SerialIMEI, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="10" Grid.Column="1" Margin="4" Style="{StaticResource NeonTextBoxStyle}"/>

                        <!-- ================= DESCRIPTION & NOTES ================= -->
                        <StackPanel Orientation="Horizontal" Grid.Row="11" Grid.Column="0" Margin="0,6" VerticalAlignment="Top">
                            <Image Source="{StaticResource Warning}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Problem Description:" VerticalAlignment="Top"/>
                        </StackPanel>
                        <TextBox Text="{Binding ProblemDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="11" Grid.Column="1" Margin="4" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                 Style="{StaticResource NeonTextBoxStyle}"/>

                        <StackPanel Orientation="Horizontal" Grid.Row="12" Grid.Column="0" Margin="0,6" VerticalAlignment="Top">
                            <Image Source="{StaticResource Notes}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Notes: ( Device Passwords, Device Diagnoses, Email )"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Top"
                                       Width="110"
                                       Height="60"/>
                        </StackPanel>
                        <TextBox Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="12" Grid.Column="1" Margin="4" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                 Style="{StaticResource NeonTextBoxStyle}"/>

                        <!-- ================= BOARD MODIFICATIONS ================= -->
                        <StackPanel Orientation="Horizontal" Grid.Row="13" Grid.Column="0" Margin="0,6" VerticalAlignment="Top">
                            <Image Source="{StaticResource Unassigned}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Board Modifications:" VerticalAlignment="Top"/>
                        </StackPanel>
                        <TextBox Text="{Binding BoardModifications, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="13" Grid.Column="1" Margin="4" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                 Style="{StaticResource NeonTextBoxStyle}"/>

                        <!-- ================= STATUS & PRIORITY ================= -->
                        <StackPanel Orientation="Horizontal" Grid.Row="14" Grid.Column="0" Margin="0,6" VerticalAlignment="Center">
                            <Image Source="{StaticResource mobilewrench35}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Repair Status:" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ComboBox SelectedItem="{Binding RepairStatus, Mode=TwoWay}"
                                  Grid.Row="14" Grid.Column="1" Margin="4" Style="{StaticResource NeonComboBoxStyle}">
                            <ComboBox.ItemsSource>
                                <x:Array Type="{x:Type sys:String}" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                    <sys:String>Received</sys:String>
                                    <sys:String>Diagnosing</sys:String>
                                    <sys:String>Waiting for Parts</sys:String>
                                    <sys:String>In Repair</sys:String>
                                    <sys:String>Testing</sys:String>
                                    <sys:String>Waiting For Client Approval</sys:String>
                                    <sys:String>Ready for Pickup</sys:String>
                                    <sys:String>Completed</sys:String>
                                    <sys:String>Cancelled</sys:String>
                                </x:Array>
                            </ComboBox.ItemsSource>
                        </ComboBox>

                        <StackPanel Orientation="Horizontal" Grid.Row="15" Grid.Column="0" Margin="0,6" VerticalAlignment="Center">
                            <Image Source="{StaticResource Warning}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Priority:" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ComboBox SelectedItem="{Binding PriorityLevel, Mode=TwoWay}"
                                  Grid.Row="15" Grid.Column="1" Margin="4" Style="{StaticResource NeonComboBoxStyle}">
                            <ComboBox.ItemsSource>
                                <x:Array Type="{x:Type sys:String}" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                    <sys:String>Minor</sys:String>
                                    <sys:String>Normal</sys:String>
                                    <sys:String>Major</sys:String>
                                    <sys:String>Critical</sys:String>
                                </x:Array>
                            </ComboBox.ItemsSource>
                        </ComboBox>

                        <!-- ================= COST ================= -->
                        <!-- ================= COST ================= -->
                        <StackPanel Orientation="Horizontal" Grid.Row="16" Grid.Column="0" Margin="0,6" VerticalAlignment="Center">
                            <Image Source="{StaticResource EstimatedCost}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Estimated Cost:" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="16" Grid.Column="1" Orientation="Horizontal" Margin="4">
                            <TextBox Text="{Binding EstimatedCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                     Width="120"
                                     Margin="0,0,6,0"
                                     Style="{StaticResource NeonTextBoxStyle}"/>

                            <ComboBox Width="80"
                                      SelectedItem="{Binding EstimatedCostCurrency, Mode=TwoWay}"
                                      Style="{StaticResource NeonComboBoxStyle}">
                                <ComboBox.ItemsSource>
                                    <x:Array Type="{x:Type sys:String}" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                        <sys:String>S.P</sys:String>
                                        <sys:String>USD</sys:String>
                                        <sys:String>EUR</sys:String>
                                        <sys:String>RON</sys:String>
                                        <sys:String>GBP</sys:String>
                                    </x:Array>
                                </ComboBox.ItemsSource>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Grid.Row="17" Grid.Column="0" Margin="0,6" VerticalAlignment="Center">
                            <Image Source="{StaticResource FinalCost}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Final Cost:" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="17" Grid.Column="1" Orientation="Horizontal" Margin="4">
                            <TextBox Text="{Binding FinalCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                     Width="120"
                                     Margin="0,0,6,0"
                                     Style="{StaticResource NeonTextBoxStyle}"/>

                            <ComboBox Width="80"
                                      SelectedItem="{Binding FinalCostCurrency, Mode=TwoWay}"
                                      Style="{StaticResource NeonComboBoxStyle}">
                                <ComboBox.ItemsSource>
                                    <x:Array Type="{x:Type sys:String}" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                        <sys:String>S.P</sys:String>
                                        <sys:String>USD</sys:String>
                                        <sys:String>EUR</sys:String>
                                        <sys:String>RON</sys:String>
                                        <sys:String>GBP</sys:String>
                                    </x:Array>
                                </ComboBox.ItemsSource>
                            </ComboBox>
                        </StackPanel>

                        <!-- ================= WARRANTY ================= -->
                        <StackPanel Orientation="Horizontal" Grid.Row="18" Grid.Column="0" Margin="0,6" VerticalAlignment="Center">
                            <Image Source="{StaticResource ReadyToPick}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Warranty:" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Row="18" Grid.Column="1" Margin="4">
                            <CheckBox IsChecked="{Binding HasWarranty}" Style="{StaticResource NeonCheckBoxStyle}" Margin="0,0,8,0"/>
                            <ComboBox Width="160"
                                      IsEnabled="{Binding HasWarranty}"
                                      SelectedItem="{Binding WarrantyPeriod, Mode=TwoWay}"
                                      Style="{StaticResource NeonComboBoxStyle}">
                                <ComboBox.ItemsSource>
                                    <x:Array Type="{x:Type sys:String}" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                        <sys:String>7 Days</sys:String>
                                        <sys:String>14 Days</sys:String>
                                        <sys:String>30 Days</sys:String>
                                        <sys:String>90 Days</sys:String>
                                        <sys:String>6 Months</sys:String>
                                        <sys:String>1 Year</sys:String>
                                    </x:Array>
                                </ComboBox.ItemsSource>
                            </ComboBox>
                        </StackPanel>

                        <!-- ================= REPAIR ON WARRANTY ================= -->
                        <StackPanel Orientation="Horizontal" Grid.Row="19" Grid.Column="0" Margin="0,6" VerticalAlignment="Center">
                            <Image Source="{StaticResource safety_check}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Repair on Warranty:" VerticalAlignment="Center"/>
                        </StackPanel>
                        <CheckBox IsChecked="{Binding IsWarrantyRepair}" Grid.Row="19" Grid.Column="1" Margin="4"
                                  Style="{StaticResource NeonCheckBoxStyle}"/>

                        <!-- ================= ROOT CAUSE ================= -->
                        <StackPanel Orientation="Horizontal" Grid.Row="20" Grid.Column="0" Margin="0,6" VerticalAlignment="Center">
                            <Image Source="{StaticResource token}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Root Cause:" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ComboBox SelectedItem="{Binding RootCause, Mode=TwoWay}"
                                  Grid.Row="20" Grid.Column="1" Margin="4" Style="{StaticResource NeonComboBoxStyle}">
                            <ComboBox.ItemsSource>
                                <x:Array Type="{x:Type sys:String}" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                    <sys:String>Electrical Cause</sys:String>
                                    <sys:String>Mechanical Cause</sys:String>
                                    <sys:String>Environmental Cause</sys:String>
                                    <sys:String>Human Cause</sys:String>
                                </x:Array>
                            </ComboBox.ItemsSource>
                        </ComboBox>

                        <!-- ================= PARTS USED ================= -->
                        <StackPanel Orientation="Horizontal" Grid.Row="21" Grid.Column="0" Margin="0,6" VerticalAlignment="Top">
                            <Image Source="{StaticResource filter_vintage}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Parts Used (JSON):" VerticalAlignment="Top"/>
                        </StackPanel>
                        <TextBox Text="{Binding PartsUsed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="21" Grid.Column="1" Margin="4" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                 Style="{StaticResource NeonTextBoxStyle}"/>

                        <!-- ================= DEVICE CHECK LIST ================= -->
                        <GroupBox Header="Device Check List"
                                  Grid.Row="22"
                                  Grid.ColumnSpan="2"
                                  Margin="0,12,0,0"
                                  FontWeight="Bold"
                                  Style="{StaticResource DarkBlueGroupBoxStyle}">
                            <UniformGrid Columns="2" Margin="8">

                                <!-- ===== Power & System ===== -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                                    
                                    <TextBlock Text="Powers On:" VerticalAlignment="Center"/>
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckPowerOn}" Style="{StaticResource NeonCheckBoxStyle}" Margin="6,0,0,0"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                                    
                                    <TextBlock Text="Boots to OS:" VerticalAlignment="Center"/>
                                    <CheckBox IsChecked="{Binding DeviceChecklist.DeviceCheckBoots}" Style="{StaticResource NeonCheckBoxStyle}" Margin="6,0,0,0"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                                    
                                    <TextBlock Text="Battery Charging:" VerticalAlignment="Center"/>
