+        private void ReconcileStock(IEnumerable<string> oldParts, IEnumerable<string> newParts)
+        {
+            // Case-insensitive comparer so "Battery" and "battery" are the same part
+            var old = oldParts
+                .Where(p => !string.IsNullOrWhiteSpace(p))
+                .Select(p => p.Trim())
+                .GroupBy(p => p, StringComparer.OrdinalIgnoreCase)
+                .ToDictionary(g => g.Key, g => g.Count(), StringComparer.OrdinalIgnoreCase);
+
+            var @new = newParts
+                .Where(p => !string.IsNullOrWhiteSpace(p))
+                .Select(p => p.Trim())
+                .GroupBy(p => p, StringComparer.OrdinalIgnoreCase)
+                .ToDictionary(g => g.Key, g => g.Count(), StringComparer.OrdinalIgnoreCase);
+
+            // Parts added since last save → deduct from stock
+            foreach (var kvp in @new)
+            {
+                var oldQty = old.TryGetValue(kvp.Key, out var oq) ? oq : 0;
+                var delta  = kvp.Value - oldQty;
+                if (delta > 0)
