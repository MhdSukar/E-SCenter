<Window x:Class="ESCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ESCenter.ViewModels"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="E-SCenter"
        Height="880"
        Width="1595"
        WindowStartupLocation="Manual"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Severity Icons -->
        <Style x:Key="StatusIconStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

    </Window.Resources>
    
    <Window.InputBindings>
        <!-- F1 = Dashboard -->
        <KeyBinding Key="F1" Command="{Binding ShowDashboardCommand}" />

        <!-- F2 = Repair Tickets -->
        <KeyBinding Key="F2" Command="{Binding ShowRepairTicketsCommand}" />

        <!-- F3 = Parts Control -->
        <KeyBinding Key="F3" Command="{Binding ShowPartsControlCommand}" />

        <!-- F4 = Inventory -->
        <KeyBinding Key="F4" Command="{Binding ShowInventoryCommand}" />

        <!-- F5 = Boneyard -->
        <KeyBinding Key="F5" Command="{Binding ShowBoneyardCommand}" />

        <!-- F6 = Al-Baraka -->
        <KeyBinding Key="F6" Command="{Binding ShowAlBarakaCommand}" />

        <!-- F7 = Warranty Window -->
        <KeyBinding Key="F7" Command="{Binding ShowWarrantySystemCommand}" />

        <!-- Ctrl+N = New Ticket -->
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewTicketCommand}" />
    </Window.InputBindings>
    

    <!-- Rounded window shell -->
    <Border CornerRadius="12"
            Background="{StaticResource AppBackgroundBrush}"
            BorderBrush="{StaticResource DarkBorderBrush}"
            BorderThickness="0"
            SnapsToDevicePixels="True">

        <Grid>
            <!-- ================= Custom Title Bar ================= -->
            <Border Height="36"
                    Background="{StaticResource DarkCardBrush}"
                    CornerRadius="12,12,0,0"
                    BorderBrush="{StaticResource DarkBorderBrush}"
                    BorderThickness="0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    VerticalAlignment="Top">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Icon -->
                    <Image Grid.Column="0"
                           Source="Assets\Icons\Philips E-SCenter Logo.png"
                           Width="30"
                           Height="30"
                           Margin="10,0,6,0"
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="0"
                               Text="E-SCenter"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Gradient.Primary}"
                               Margin="45,0,0,0"/>

                    <!-- ===== Navigation Tabs ===== -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="6,0,12,0">

                        <!-- Dashboard tab — use this pattern for all 5 tabs -->
                        <RadioButton Style="{StaticResource TitleBarTabButtonStyle}"
                                     GroupName="MainTabs"
                                     Command="{Binding ShowDashboardCommand}"
                                     x:Name="BtnDashboard"
                                     Width="130"
                                     IsChecked="{Binding IsDashboardSelected, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource Dashboard}"
                                       Width="25" Height="25"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                                <TextBlock Text="Dashboard"
                                           VerticalAlignment="Center"/>
                                <!-- Keyboard hint badge -->
                                <Border Background="#18FFFFFF"
                                        CornerRadius="3"
                                        Padding="3,1"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="F1"
                                               FontSize="9"
                                               FontFamily="Consolas"
                                               Foreground="{StaticResource TextTertiaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource TitleBarTabButtonStyle}"
                                     GroupName="MainTabs"
                                     Command="{Binding ShowRepairTicketsCommand}"
                                     x:Name="BtnRepairTickets"
                                     Width="147"
                                     IsChecked="{Binding IsRepairTicketsSelected, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource Tickets}"
                                       Width="25" Height="25"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                                <TextBlock Text="Repair Tickets"
                                           VerticalAlignment="Center"/>
                                <!-- Keyboard hint badge -->
                                <Border Background="#18FFFFFF"
                                        CornerRadius="3"
                                        Padding="3,1"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="F2"
                                               FontSize="9"
                                               FontFamily="Consolas"
                                               Foreground="{StaticResource TextTertiaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource TitleBarTabButtonStyle}"
                                     GroupName="MainTabs"
                                     Command="{Binding ShowPartsControlCommand}"
                                     x:Name="BtnPartsControl"
                                     Width="142"
                                     IsChecked="{Binding IsPartsControlSelected, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource Parts}"
                                       Width="25" Height="25"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                                <TextBlock Text="Parts Control"
                                           VerticalAlignment="Center"/>
                                <!-- Keyboard hint badge -->
                                <Border Background="#18FFFFFF"
                                        CornerRadius="3"
                                        Padding="3,1"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="F3"
                                               FontSize="9"
                                               FontFamily="Consolas"
                                               Foreground="{StaticResource TextTertiaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource TitleBarTabButtonStyle}"
                                     GroupName="MainTabs"
                                     Command="{Binding ShowInventoryCommand}"
                                     x:Name="BtnInventory"
                                     Width="123"
                                     IsChecked="{Binding IsInventorySelected, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource Inventory}"
                                       Width="25" Height="25"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                                <TextBlock Text="Inventory"
                                           VerticalAlignment="Center"/>
                                <!-- Keyboard hint badge -->
                                <Border Background="#18FFFFFF"
                                        CornerRadius="3"
                                        Padding="3,1"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="F4"
                                               FontSize="9"
                                               FontFamily="Consolas"
                                               Foreground="{StaticResource TextTertiaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource TitleBarTabButtonStyle}"
                                     GroupName="MainTabs"
                                     Command="{Binding ShowBoneyardCommand}"
                                     x:Name="BtnBoneyard"
                                     Width="125"
                                     IsChecked="{Binding IsBoneyardSelected, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource Boneyard}"
                                       Width="25" Height="25"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                                <TextBlock Text="Boneyard"
                                           VerticalAlignment="Center"/>
                                <!-- Keyboard hint badge -->
                                <Border Background="#18FFFFFF"
                                        CornerRadius="3"
                                        Padding="3,1"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="F5"
                                               FontSize="9"
                                               FontFamily="Consolas"
                                               Foreground="{StaticResource TextTertiaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>



                    <!-- Drag Area -->
                    <Border Grid.Column="2"
                Background="Transparent"/>

                    <!-- Window Buttons -->
                    <StackPanel Grid.Column="3"
                    Orientation="Horizontal">
                        <Button x:Name="btnUserProfile"
                                Command="{Binding ShowUserProfileCommand}"
                                Style="{StaticResource UserProfileButtonStyle}"
                                Width="Auto"
                                Padding="10,0"
                                Margin="0,0,6,0"
                                ToolTip="{Binding CurrentUser}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource Admin}" Width="16" Height="16" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding CurrentUser}"
                                           FontSize="11"
                                           Foreground="{StaticResource Gradient.Primary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            
                        </Button>

                        <Button x:Name="btnMinimize"
                                Style="{StaticResource TitleBarButtonBase}"
                                Click="btnMinimize_Click">
                            <Image Source="{StaticResource Minimize}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>

                        <Button x:Name="btnMaximize"
                                Style="{StaticResource TitleBarButtonBase}"
                                Click="btnMaximize_Click"
                                FontSize="18">
                            <Image Source="{StaticResource Maximize}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>

                        <Button x:Name="btnClose"
                                Style="{StaticResource TitleBarCloseButtonStyle}"
                                Click="btnClose_Click">
                            <Image Source="{StaticResource Close}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>



            <!-- ================= ORIGINAL UI (UNCHANGED) ================= -->
            <Grid Margin="0,36,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <!-- ================= Control ================= -->
                <Border Grid.Row="0"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="8"
                        Margin="16,16,16,8">

                    <UniformGrid Columns="4" >

                        <!-- ========= Navigation Group ========= -->
                        <GroupBox Width="375"
                                  Height="182"
                                  Padding="1"
                                  Style="{StaticResource GradientGroupBoxBlueCyan}">

                            <!-- ─── Header: Icon · Title · LIVE badge ─── -->
                            <GroupBox.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="{StaticResource Charts}"
                                               Width="15" Height="15" Margin="0,0,6,0"/>
                                        <TextBlock Text="Tickets Act"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource Gradient.Primary.Horizontal}"/>
                                    </StackPanel>

                                    <!-- ✦ LIVE pulse badge -->
                                    <Border Grid.Column="2"
                                            Background="#1A00E5D4"
                                            BorderBrush="#4400C8C0"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="5,1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="5" Height="5"
                                                     Fill="{StaticResource NeonCyanBrush}"
                                                     Margin="0,0,4,0"
                                                     VerticalAlignment="Center">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect Color="#FF3BE7FF"
                                              BlurRadius="6"
                                              ShadowDepth="0"
                                              Opacity="0.95"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <TextBlock Text="LIVE"
                                                       FontSize="7"
                                                       FontWeight="Bold"
                                                       FontFamily="Consolas"
                                                       Foreground="{StaticResource NeonCyanBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </GroupBox.Header>

                            <!-- ─── Content ─── -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Chart with a subtle glass backing -->
                                <Border CornerRadius="8" Margin="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#0A237EF2" Offset="0"/>
                                            <GradientStop Color="#0600E5D4" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#00E5D4" BlurRadius="14" ShadowDepth="0" Opacity="0.10"/>
                                    </Border.Effect>
                                    
                                    <lvc:CartesianChart Margin="2"
                                                        Series="{Binding TicketsSeries}"
                                                        XAxes="{Binding TicketsXAxis}"
                                                        YAxes="{Binding TicketsYAxis}"
                                                        TooltipTextPaint="{Binding TicketsTooltipTextPaint}"
                                                        TooltipBackgroundPaint="{Binding TicketsTooltipBackgroundPaint}"
                                                        LegendPosition="Hidden"
                                                        AnimationsSpeed="00:00:00.7"/>
                                </Border>

                                <!-- Toggle buttons row — wrapped in a pill-shaped container -->
                                <Border Grid.Row="1"
                                        Background="#0C2952D9"
                                        BorderBrush="#1800E5D4"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="35,2"
                                        Margin="0,0,0,2">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding TicketStatusCurves}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ToggleButton Margin="2,0"
                                                                  Padding="2"
                                                                  Width="55"
                                                                  Height="22"
                                                                  ToolTip="{Binding Key}"
                                                                  Style="{StaticResource ChartStatusToggleButtonStyleTEST}"
                                                                  IsChecked="{Binding IsVisible, Mode=TwoWay}">
                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center">
                                                            <Image Width="12" Height="12"
                                                                   Stretch="Uniform"
                                                                   Margin="0,0,4,0"
                                                                   Source="{Binding Key, Converter={StaticResource SeriesKeyToIconConverter}}"/>
                                                            <TextBlock Text="{Binding Key}"
                                                                       FontSize="8"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource Gradient.Primary}"/>
                                                        </StackPanel>
                                                    </ToggleButton>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </GroupBox>

                        <!-- ========= Statistics Group ========= -->
                        <GroupBox Width="363"
                                  Height="182"
                                  Style="{StaticResource GradientGroupBoxAccent}">

                            <!-- ─── Header ─── -->
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource Statistics}"
                                           Width="15" Height="15" Margin="0,0,6,0"/>
                                    <TextBlock Text="Tickets stk"
                                               Foreground="{StaticResource Gradient.Accent}"/>
                                </StackPanel>
                            </GroupBox.Header>

                            <!-- ─── Content ─── -->
                            <Grid Margin="0,-4,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <!-- stat cards -->
                                    <RowDefinition Height="1"/>
                                    <!-- gradient divider -->
                                    <RowDefinition Height="38"/>
                                    <!-- alert pills -->
                                </Grid.RowDefinitions>

                                <!-- ── Row 0 : Five stat mini-cards ── -->
                                <UniformGrid Grid.Row="0"
                                             Columns="5"
                                             Rows="1"
                                             Margin="0,4,0,5">

                                    <!-- ① Total (Neon Purple) -->
                                    <Border Margin="2,0"
                                            Background="#0DFFFFFF"
                                            BorderThickness="0,0,0,2"
                                            Padding="4,5,4,4">
                                        <Border.BorderBrush>
                                            <SolidColorBrush Color="#FFB200FF" Opacity="0.55"/>
                                        </Border.BorderBrush>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="TOTAL"
                                                       FontSize="7"
                                                       FontWeight="Bold"
                                                       FontFamily="Consolas"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding Dashboard.TotalTickets}"
                                                       FontSize="26"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource NeonPurpleBrush}">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect Color="#FFB200FF"
                                              BlurRadius="10"
                                              ShadowDepth="0"
                                              Opacity="0.75"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                            <Border Height="2" CornerRadius="1" Margin="6,3,6,0" Opacity="0.5">
                                                <Border.Background>
                                                    <SolidColorBrush Color="#FFB200FF"/>
                                                </Border.Background>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- ② Open (Neon Green) -->
                                    <Border Margin="2,0"
                                            Background="#0DFFFFFF"
                                            BorderThickness="0,0,0,2"
                                            Padding="4,5,4,4">
                                        <Border.BorderBrush>
                                            <SolidColorBrush Color="#FF2EFF2E" Opacity="0.55"/>
                                        </Border.BorderBrush>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="OPEN"
                                                       FontSize="7"
                                                       FontWeight="Bold"
                                                       FontFamily="Consolas"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding Dashboard.OpenTickets}"
                                                       FontSize="26"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource NeonGreenBrush}">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect Color="#FF2EFF2E"
                                                                      BlurRadius="10"
                                                                      ShadowDepth="0"
                                                                      Opacity="0.75"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                            <Border Height="2" CornerRadius="1" Margin="6,3,6,0" Opacity="0.5"
                                                    Background="{StaticResource NeonGreenBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- ③ Closed (Neon Blue) -->
                                    <Border Margin="2,0"
                                            Background="#0DFFFFFF"
                                            BorderThickness="0,0,0,2"
                                            Padding="4,5,4,4">
                                        <Border.BorderBrush>
                                            <SolidColorBrush Color="#FF0066FF" Opacity="0.55"/>
                                        </Border.BorderBrush>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="CLOSED"
                                                       FontSize="7"
                                                       FontWeight="Bold"
                                                       FontFamily="Consolas"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding Dashboard.ClosedTickets}"
                                                       FontSize="26"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource NeonBlueBrush}">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect Color="#FF0066FF"
                                              BlurRadius="10"
                                              ShadowDepth="0"
                                              Opacity="0.75"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                            <Border Height="2" CornerRadius="1" Margin="6,3,6,0" Opacity="0.5"
                                                    Background="{StaticResource NeonBlueBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- ④ Critical (Neon Orange) -->
                                    <Border Margin="2,0"
                                            Background="#0DFFFFFF"
                                            BorderThickness="0,0,0,2"
                                            Padding="4,5,4,4">
                                        <Border.BorderBrush>
                                            <SolidColorBrush Color="#FFFFAA00" Opacity="0.55"/>
                                        </Border.BorderBrush>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="CRITICAL"
                                                       FontSize="7"
                                                       FontWeight="Bold"
                                                       FontFamily="Consolas"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding Dashboard.CriticalOpenTickets}"
                                                       FontSize="26"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource NeonOrangeBrush}">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect Color="#FFFFAA00"
                                                                      BlurRadius="10"
                                                                      ShadowDepth="0"
                                                                      Opacity="0.75"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                            <Border Height="2" CornerRadius="1" Margin="6,3,6,0" Opacity="0.5"
                                                    Background="{StaticResource NeonOrangeBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- ⑤ Ready to Pick (Neon Cyan — clickable) -->
                                    <Border Margin="2,0"
                                            Background="#0DFFFFFF"
                                            BorderThickness="0,0,0,2"
                                            Padding="4,5,4,4">
                                        <Border.BorderBrush>
                                            <SolidColorBrush Color="#FF3BE7FF" Opacity="0.55"/>
                                        </Border.BorderBrush>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="READY"
                                                       FontSize="7"
                                                       FontWeight="Bold"
                                                       FontFamily="Consolas"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       Margin="0,0,0,3"/>
                                            <!-- Clickable number -->
                                            <Button Command="{Binding ShowReadyPickupTicketsCommand}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Padding="0"
                                                    HorizontalAlignment="Center"
                                                    FocusVisualStyle="{x:Null}">
                                                <TextBlock Text="{Binding Dashboard.ReadyForPickupTickets}"
                                                           FontSize="26"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource NeonCyanBrush}">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect Color="#FF3BE7FF"
                                                                          BlurRadius="10"
                                                                          ShadowDepth="0"
                                                                          Opacity="0.75"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                            </Button>
                                            <Border Height="2" CornerRadius="1" Margin="6,3,6,0" Opacity="0.5"
                                                    Background="{StaticResource NeonCyanBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- ── Row 1 : Gradient divider ── -->
                                <Border Grid.Row="1"
                                        Margin="6,0,6,0"
                                        Opacity="0.45">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#009C6FFF" Offset="0"/>
                                            <GradientStop Color="#CC7C4DFF"  Offset="0.35"/>
                                            <GradientStop Color="#CC00E5FF"  Offset="0.65"/>
                                            <GradientStop Color="#0000E5FF"  Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- ── Row 2 : Alert pills ── -->
                                <Grid Grid.Row="2" Margin="2,5,2,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ⚠ Overdue pill -->
                                    <Border Grid.Column="1"
                                            Background="#14FF3B3B"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="7,0"
                                            Margin="0,0,4,0">
                                        <Border.BorderBrush>
                                            <SolidColorBrush Color="#FFFF3B3B" Opacity="0.28"/>
                                        </Border.BorderBrush>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Alert icon -->
                                            <Image Grid.Column="0"
                                                   Source="{StaticResource CharCritical}"
                                                   Width="25" Height="25"
                                                   Margin="0,0,5,0"
                                                   VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="Overdue"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource NeonRedBrush}"/>

                                            <!-- Clickable count -->
                                            <Button Grid.Column="2"
                                                    Command="{Binding ShowOverdueTicketsCommand}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Padding="0"
                                                    FocusVisualStyle="{x:Null}">
                                                <TextBlock Text="{Binding Dashboard.OverdueTickets}"
                                                           FontSize="17"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource NeonRedBrush}">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect Color="#FFFF3B3B"
                                                  BlurRadius="8"
                                                  ShadowDepth="0"
                                                  Opacity="0.85"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- ● Critical pill -->
                                    <Border Grid.Column="0"
                                            Background="#14FFAA00"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="7,0"
                                            Margin="4,0,0,0">
                                        <Border.BorderBrush>
                                            <SolidColorBrush Color="#FFFFAA00" Opacity="0.28"/>
                                        </Border.BorderBrush>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Glowing dot -->
                                            <Image Grid.Column="0"
                                                   Source="{StaticResource CharMajor}"
                                                   Width="25" Height="25"
                                                   Margin="0,0,5,0"
                                                   VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="Critical"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource NeonOrangeBrush}"/>

                                            <!-- Clickable count -->
                                            <Button Grid.Column="2"
                                                    Command="{Binding ShowCriticalTicketsCommand}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Padding="0"
                                                    FocusVisualStyle="{x:Null}">
                                                <TextBlock Text="{Binding Dashboard.CriticalOpenTickets}"
                                                           FontSize="17"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource NeonOrangeBrush}">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect Color="#FFFFAA00"
                                                  BlurRadius="8"
                                                  ShadowDepth="0"
                                                  Opacity="0.85"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </GroupBox>

                        <!-- ========= Control Group ========= -->
                        <GroupBox Width="363" Height="183" Style="{StaticResource GradientGroupBoxBlueCyan}">
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource GalaxyAi3}" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="мн∂ ѕυкαя" Foreground="{StaticResource Gradient.Primary.Horizontal}"/>
                                </StackPanel>
                            </GroupBox.Header>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="3"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Column="0" Grid.Row="0"
                                           Text="ѕєαяςн ѕи:"
                                           Foreground="{StaticResource Gradient.Accent}"/>

                                <Image Grid.Column="0" Grid.Row="1"
                                       Source="{StaticResource GalaxyAi3}"
                                       Width="35"
                                       Height="30"
                                       Margin="0,0,0,0"
                                       VerticalAlignment="Center"/>

                                <TextBox x:Name="GlobalSearchBox"
                                         Grid.Column="1" Grid.Row="0"
                                         Height="23"
                                         VerticalAlignment="Top"
                                         Style="{StaticResource GradiantTextboxStyle1}"
                                         Text="{Binding GlobalSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Search everywhere (Ctrl+F) — min 2 characters">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Down" Command="{Binding GlobalSearchMoveDownCommand}"/>
                                        <KeyBinding Key="Up" Command="{Binding GlobalSearchMoveUpCommand}"/>
                                        <KeyBinding Key="Enter" Command="{Binding GlobalSearchAcceptCommand}"/>
                                        <KeyBinding Key="Escape" Command="{Binding CloseGlobalSearchCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>

                                <Popup IsOpen="{Binding IsGlobalSearchOpen}"
                                       PlacementTarget="{Binding ElementName=GlobalSearchBox}"
                                       Placement="Bottom"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       MinWidth="320">
                                    <Border Background="{StaticResource CardBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderDarkBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="4">
                                        <ListBox ItemsSource="{Binding GlobalSearchResults}"
                                                 SelectedIndex="{Binding GlobalSearchSelectedIndex, Mode=TwoWay}"
                                                 MaxHeight="220"
                                                 Background="Transparent"
                                                 BorderThickness="0">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0,1"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="Bd"
                                                                        Background="{TemplateBinding Background}"
                                                                        CornerRadius="4"
                                                                        Padding="2">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="Bd"
                                                                                Property="Background"
                                                                                Value="{StaticResource NewPrimaryBlueBrush}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd"
                                                                                Property="Background"
                                                                                Value="#22FFFFFF"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.NavigateToResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="8,5"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch">
                                                        <Grid HorizontalAlignment="Stretch">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0"
                                                                    Background="#1A5AA7FF"
                                                                    CornerRadius="3"
                                                                    Padding="5,2"
                                                                    Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Identifier}"
                                                                           Foreground="#5AA7FF"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           FontFamily="Consolas"/>
                                                            </Border>

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Name}"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       FontSize="12"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"/>

                                                            <Border Grid.Column="2"
                                                                    Background="#1A334455"
                                                                    CornerRadius="3"
                                                                    Padding="5,2"
                                                                    Margin="8,0,0,0">
                                                                <TextBlock Text="{Binding Source}"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           FontSize="10"/>
                                                            </Border>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Popup>


                                <PasswordBox Grid.Column="1" Grid.Row="1"
                                          Padding="8,0,25,0"
                                          Height="23"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource DarkPasswordBoxStyle}"
                                          Margin="0,0,0,0">
                                </PasswordBox>

                                <Border Height="1" Grid.Row="2" Grid.Column="1"
                                        Background="{StaticResource Gradient.Primary.Horizontal}"/>

                                <UniformGrid Grid.Column="0" Grid.Row="3" Columns="1" Rows="2"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center">
                                    <Button Style="{StaticResource  IconButtonStyle}" MinWidth="1" Width="30" FontSize="14" Margin="0,5,0,3"
                                            Command="{Binding ShowWarrantySystemCommand}">
                                        <Grid>
                                            <Image Source="{StaticResource Warranty}" Width="30" Height="20" Margin="-2,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                            <Border Background="{StaticResource NeonOrangeBrush}"
                                                    BorderBrush="{StaticResource DarkCardBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="9"
                                                    Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="0,-6,-6,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ExpiringWarrantyCount}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ExpiringWarrantyCount}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource AppBackgroundBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </UniformGrid>

                                <UniformGrid Grid.Column="1" Grid.Row="3" Columns="2" Rows="2"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center">

                                    <Button Style="{StaticResource GradientBorderButtonStyleBLueCyan}" MinWidth="1" Width="125" FontSize="14" Margin="0,5,6,0"
                                            Command="{Binding ShowAlBarakaCommand}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{StaticResource Baraka}" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Al-Baraka"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <Button Style="{StaticResource GradientBorderButtonStyleYellow}" Width="125" FontSize="16" Margin="0,5,6,0"
                                            Command="{Binding ShowReportsCommand}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{StaticResource DBReport}" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Reports DB"/>
                                        </StackPanel>
                                    </Button>

                                    
                                    
                                    <CheckBox IsChecked="{Binding AutoGrantAdminAccess, Mode=TwoWay}" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Center" 
                                              Width="120" Margin="0,0,0,0" 
                                              Style="{StaticResource GradientCheckBoxStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{StaticResource GalaxyAi3}" Width="18" Height="18" Margin="0,0,5,0"/>
                                            <TextBlock Text="ω11 ∂яινє" Foreground="{StaticResource Gradient.Primary}"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox Grid.Row="1"
                                              IsChecked="{Binding LaunchAtWindowsStartup, Mode=TwoWay}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="0,0,0,0"
                                              Style="{StaticResource GradientCheckBoxDangerStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{StaticResource BackupNow}" Width="18" Height="18" Margin="0,0,5,0"/>
                                            <TextBlock Text="∂єν ∂яινє"
                                                       Foreground="{StaticResource Gradient.Primary}"/>
                                        </StackPanel>
                                    </CheckBox>
                                </UniformGrid>
                            </Grid>
                        </GroupBox>

                        <GroupBox Width="363" Height="182"
                                  Style="{StaticResource GradientGroupBoxAccent}"
                                  Margin="12,6,11,6">
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource Admin}" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="αρρ ѕтαтυѕ" Foreground="{StaticResource Gradient.Accent}"/>
                                </StackPanel>
                            </GroupBox.Header>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0"
                                            VerticalAlignment="Stretch"
                                            HorizontalAlignment="Stretch">


                                    <UniformGrid Columns="2"
                                                 Rows="2"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Top"
                                                 Margin="0,4,0,6">
                                        <Button 
                                                Width="138"
                                                Height="30"
                                                Margin="3,3,3,3"
                                                Command="{Binding ShowSettingsCommand}"
                                                Style="{StaticResource GradientBorderButtonStyleBLueCyan}"
                                                FontSize="13">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Image Source="{StaticResource Settings}" Width="18" Height="18" Margin="0,0,6,0"/>
                                                <TextBlock Text="Settings"/>
                                            </StackPanel>
                                        </Button>

                                        <Button
                                                Width="138"
                                                Height="30"
                                                Margin="3,3,3,3"
                                                Command="{Binding BackupNowCommand}"
                                                Style="{StaticResource GradientBorderButtonStyleGreen}"
                                                FontSize="13">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Image Source="{StaticResource BackupNow}" Width="18" Height="18" Margin="0,0,6,0"/>
                                                <TextBlock Text="Backup Now"/>
                                            </StackPanel>
                                        </Button>
                                        <Button
                                                Width="138"
                                                Height="30"
                                                Margin="3,3,3,3"
                                                Command="{Binding OpenLogFolderCommand}"
                                                Style="{StaticResource GradientBorderButtonStyleRed}"
                                                FontSize="13">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Image Source="{StaticResource OpenLogs}" Width="18" Height="18" Margin="0,0,6,0"/>
                                                <TextBlock Text="App Logger"/>
                                            </StackPanel>
                                        </Button>
                                        <Button 
                                                Width="138"
                                                Height="30"
                                                Margin="3,3,3,3"
                                                Command="{Binding RefreshAllCommand}"
                                                Style="{StaticResource GradientBorderButtonStyleAccent}"
                                                FontSize="13">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Image Source="{StaticResource RefreshAll}" Width="18" Height="18" Margin="0,0,6,0"/>
                                                <TextBlock Text="Refresh All"/>
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>

                                    <Border Height="1"
                                            Background="{StaticResource Gradient.Accent}"
                                            Margin="8,2,8,4"/>

                                    <Grid Margin="8,0,8,4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{Binding DatabaseConnectionBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="DB:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding DatabaseConnectionStatusText}" Foreground="{Binding DatabaseConnectionBrush}" FontSize="10" FontWeight="SemiBold"/>
                                            <TextBlock Text=" · " Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                            <TextBlock Text="{Binding DatabaseFileSizeText}" Foreground="{StaticResource Gradient.Accent}" FontSize="10"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="Last backup: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                            <TextBlock Text="{Binding LastBackupText}" Foreground="{StaticResource Gradient.Success}" FontSize="10" FontWeight="SemiBold"/>
                                        </StackPanel>

                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                    </UniformGrid>
                </Border>

                <!-- ================= Main Content ================= -->
                <Border Grid.Row="1"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="12"
                        Margin="16,0,16,8">

                    <ContentControl x:Name="MainContentHost"
                                    Content="{Binding CurrentView}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"/>
                </Border>

                <!-- ================= Status Bar ================= -->
                <StatusBar Grid.Row="2"
                           Height="28"
                           Background="{StaticResource DarkCardBrush}"
                           BorderBrush="{StaticResource DarkBorderBrush}"
                           BorderThickness="1,0,0,0"
                           Padding="6,0">

                    <StatusBarItem HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9"
                                     Height="9"
                                     Fill="{Binding DatabaseConnectionBrush}"
                                     Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding DatabaseConnectionStatusText}"
                                       Foreground="{Binding DatabaseConnectionBrush}"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </StatusBarItem>
                    <Separator/>

                    <StatusBarItem HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentStatusLevel, Converter={StaticResource StatusLevelToIconConverter}}"
                                       Foreground="{Binding CurrentStatusLevel, Converter={StaticResource StatusLevelToBrushConverter}}"
                                       Style="{StaticResource StatusIconStyle}"/>

                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="{Binding CurrentStatusLevel, Converter={StaticResource StatusLevelToBrushConverter}}"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </StatusBarItem>
                    <Separator/>
                    <StatusBarItem HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ClockText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,12,0"/>

                            <TextBlock Text="{Binding CurrentUser}" 
                                       Foreground="{StaticResource Gradient.Primary}" />
                        </StackPanel>
                    </StatusBarItem>
                </StatusBar>
            </Grid>
        </Grid>
    </Border>
</Window>
