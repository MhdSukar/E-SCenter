<Window x:Class="ESCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ESCenter.ViewModels"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="E-SCenter"
        Height="880"
        Width="1595"
        WindowStartupLocation="Manual"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Severity Icons -->
        <Style x:Key="StatusIconStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>

            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- Titlebar Button Base -->
        <Style x:Key="TitleBarButtonBase" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Button -->
        <Style x:Key="TitleBarCloseButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TitleBarButtonBase}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                               CornerRadius="0,8,0,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#E81123"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#C50F1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>
    
    <Window.InputBindings>
        <!-- F1 = Dashboard -->
        <KeyBinding Key="F1" Command="{Binding OpenDashboardCommand}" />

        <!-- F2 = Repair Tickets -->
        <KeyBinding Key="F2" Command="{Binding OpenRepairTicketsCommand}" />

        <!-- F3 = Parts Control -->
        <KeyBinding Key="F3" Command="{Binding OpenPartsControlCommand}" />

        <!-- F4 = Inventory -->
        <KeyBinding Key="F4" Command="{Binding OpenInventoryCommand}" />

        <!-- F5 = Boneyard -->
        <KeyBinding Key="F5" Command="{Binding OpenBoneyardCommand}" />

        <!-- F6 = Al-Baraka -->
        <KeyBinding Key="F6" Command="{Binding ShowAlBarakaCommand}" />

        <!-- F7 = Warranty Window -->
        <KeyBinding Key="F7" Command="{Binding OpenWarrantySystemCommand}" />
    </Window.InputBindings>
    

    <!-- Rounded window shell -->
    <Border CornerRadius="12"
            Background="{StaticResource AppBackgroundBrush}"
            BorderBrush="{StaticResource DarkBorderBrush}"
            BorderThickness="0"
            SnapsToDevicePixels="True">

        <Grid>
            <!-- ================= Custom Title Bar ================= -->
            <Border Height="36"
                    Background="{StaticResource DarkCardBrush}"
                    CornerRadius="12,12,0,0"
                    BorderBrush="{StaticResource DarkBorderBrush}"
                    BorderThickness="0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    VerticalAlignment="Top">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Icon -->
                    <Image Grid.Column="0"
                           Source="Z:\C#\Projects\E-SCenter\E-SCenter\Themes\Philips E-SCenter Logo.png"
                           Width="18"
                           Height="18"
                           Margin="10,0,6,0"
                           VerticalAlignment="Center"/>

                    <!-- ===== Navigation Tabs ===== -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="6,0,12,0">

                        <RadioButton Style="{StaticResource TitleBarTabButtonStyle}"
                                     GroupName="MainTabs"
                                     Command="{Binding ShowDashboardCommand}"
                                     x:Name="BtnDashboard"
                                     Width="120"
                                     IsChecked="{Binding IsDashboardSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource Dashboard}" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="(F1) Dashboard"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource TitleBarTabButtonStyle}"
                                     GroupName="MainTabs" Width="110"
                                     Command="{Binding ShowRepairTicketsCommand}"
                                     IsChecked="{Binding IsRepairTicketsSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource Tickets}" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="(F2) Tickets"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource TitleBarTabButtonStyle}"
                                     GroupName="MainTabs" Width="110"
                                     Command="{Binding ShowPartsControlCommand}"
                                     IsChecked="{Binding IsPartsControlSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource Parts}" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="(F3) Parts"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource TitleBarTabButtonStyle}"
                                     GroupName="MainTabs" Width="110"
                                     Command="{Binding ShowInventoryCommand}"
                                     IsChecked="{Binding IsInventorySelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource Inventory}" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="(F4) Inventory"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource TitleBarTabButtonStyle}"
                                     GroupName="MainTabs" Width="110"
                                     Command="{Binding ShowBoneyardCommand}"
                                     IsChecked="{Binding IsBoneyardSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource Boneyard}" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="(F5) Boneyard"/>
                            </StackPanel>
                        </RadioButton>

                    </StackPanel>



                    <!-- Drag Area -->
                    <Border Grid.Column="2"
                Background="Transparent"/>

                    <!-- Window Buttons -->
                    <StackPanel Grid.Column="3"
                    Orientation="Horizontal">

                        <Button x:Name="btnMinimize"
                                Style="{StaticResource TitleBarButtonBase}"
                                Content="—"
                                Click="btnMinimize_Click"/>

                        <Button x:Name="btnMaximize"
                                Style="{StaticResource TitleBarButtonBase}"
                                Content="□"
                                Click="btnMaximize_Click"
                                FontSize="18"/>

                        <Button x:Name="btnClose"
                                Style="{StaticResource TitleBarCloseButtonStyle}"
                                Content="✕"
                                Click="btnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>



            <!-- ================= ORIGINAL UI (UNCHANGED) ================= -->
            <Grid Margin="0,36,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <!-- ================= Header ================= -->
                <Border Grid.Row="0"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="12"
                        Margin="16,16,16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0"
                               Source="Z:\C#\Projects\E-SCenter\E-SCenter\Themes\Philips E-SCenter Logo.png" 
                               Height="40" 
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"/>

                        <TextBlock Text="E-SCenter"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextLogoBrush}"
                                   Grid.Column="0" Margin="50,0,0,0"/>

                        <TextBlock Text="Electronics Services Center"
                                   Style="{StaticResource CardTitleTextStyle}"
                                   FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextLogoBrush}"
                                   Grid.Column="1"
                                   Margin="0,0,150,0"/>
                    </Grid>
                </Border>

                <!-- ================= Control ================= -->
                <Border Grid.Row="1"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="8"
                        Margin="16,0,16,8">

                    <UniformGrid Columns="4" >

                        <!-- ========= Navigation Group ========= -->
                        <GroupBox Width="363"
                                  
                                  Padding="0"
                                  Style="{StaticResource DarkCyanGroupBoxStyle}">

                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource Charts}"
                                           Width="16"
                                           Height="16"
                                           Margin="0,0,6,0"/>
                                    <TextBlock Text="Tickets Act"
                                                VerticalAlignment="Center"
                                               Foreground="{StaticResource NeonDarkCyanDarkBrush}"/>
                                </StackPanel>
                            </GroupBox.Header>

                            <Grid Height="137" Margin="0,-8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Tickets"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,4,16">
                                        <TextBlock.LayoutTransform>
                                            <RotateTransform Angle="-90"/>
                                        </TextBlock.LayoutTransform>
                                    </TextBlock>

                                    <lvc:CartesianChart Grid.Column="1"
                                                        Margin="0"
                                                        Series="{Binding TicketsSeries}"
                                                        XAxes="{Binding TicketsXAxis}"
                                                        YAxes="{Binding TicketsYAxis}"
                                                        TooltipTextPaint="{Binding TicketsTooltipTextPaint}"
                                                        TooltipBackgroundPaint="{Binding TicketsTooltipBackgroundPaint}"
                                                        LegendPosition="Hidden"/>
                                </Grid>

                                <ScrollViewer Grid.Row="1"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding TicketStatusCurves}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ToggleButton Margin="2,0,2,0"
                                                              Padding="2"
                                                              Width="65"
                                                              ToolTip="{Binding Key}"
                                                              Style="{StaticResource ChartStatusToggleButtonStyle}"
                                                              IsChecked="{Binding IsVisible, Mode=TwoWay}">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Image Width="11.2"
                                                               Height="11.2"
                                                               Stretch="Uniform"
                                                               Margin="0,0,4,0"
                                                               Source="{Binding Key, Converter={StaticResource SeriesKeyToIconConverter}}"/>
                                                        <TextBlock Text="{Binding Key}"
                                                                   FontSize="9"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    </StackPanel>
                                                </ToggleButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </GroupBox>

                        <!-- ========= Statistics Group ========= -->
                        <GroupBox Width="363" Style="{StaticResource DarkCyanGroupBoxStyle}">
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource Statistics}" Width="16" Height="17" Margin="0,0,6,0"/>
                                    <TextBlock Text="Tickets stk" Foreground="{StaticResource NeonDarkCyanDarkBrush}"/>
                                </StackPanel>
                            </GroupBox.Header>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Grid.Row="0"
                                           Text="Total"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>

                                <TextBlock Grid.Column="1" Grid.Row="0"
                                           Text="Open"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>

                                <TextBlock Grid.Column="2" Grid.Row="0"
                                           Text="Close"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>

                                <TextBlock Grid.Column="3" Grid.Row="0"
                                           Text="Critical"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>

                                <TextBlock Grid.Column="4" Grid.Row="0"
                                           Text="Overdue (>2 days)"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>


                                <TextBlock Text="{Binding Dashboard.TotalTickets}" Grid.Row="1" Grid.Column="0"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource NeonPurpleBrush}"
                                           Margin="0,8,0,0"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="{Binding Dashboard.OpenTickets}" Grid.Row="1" Grid.Column="1"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource NeonGreenBrush}"
                                           Margin="0,8,0,0"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="{Binding Dashboard.ClosedTickets}" Grid.Row="1" Grid.Column="2"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource NeonBlueBrush}"
                                           Margin="0,8,0,0"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="{Binding Dashboard.CriticalOpenTickets}" Grid.Row="1" Grid.Column="3"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource NeonOrangeBrush}"
                                           Margin="0,8,0,0"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="{Binding Dashboard.OverdueTickets}" Grid.Row="1" Grid.Column="4"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource NeonRedBrush}"
                                           Margin="0,8,0,0"
                                           HorizontalAlignment="Center"/>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Center" Margin="0,20,0,0">
                                    <Image Source="{StaticResource Baraka}" Width="10" Height="10" Margin="0,0,3,0"/>
                                    <TextBlock Text="Expanses:" Foreground="{StaticResource NeonDarkCyanBrush}" FontSize="10"/>
                                </StackPanel>
                                
                                

                                <!-- Al-Baraka totals: S.P in 3rd column, USD in 5th column -->
                                <TextBlock Grid.Column="1" Grid.Row="2" Text="Total (S.P):" Foreground="{StaticResource NeonYellowBrush}" FontSize="10" Margin="0,21,0,0" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Grid.Row="2" Text="{Binding TotalAlBarakaSP, StringFormat=N2}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource NeonYellowBrush}" Margin="0,20,0,0" HorizontalAlignment="Center"/>

                                <TextBlock Grid.Column="3" Grid.Row="2" Text="Total (USD):" Foreground="{StaticResource NeonGreenBrush}" FontSize="10" Margin="0,21,0,0" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Grid.Row="2" Text="{Binding TotalAlBarakaUSD, StringFormat=N2}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource NeonGreenBrush}" Margin="0,20,0,0" HorizontalAlignment="Center"/>

                            </Grid>
                        </GroupBox>

                        <!-- ========= Control Group ========= -->
                        <GroupBox Width="363" Style="{StaticResource DarkCyanGroupBoxStyle}">
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource GalaxyAi6}" Width="17" Height="17" Margin="0,0,6,0"/>
                                    <TextBlock Text="мн∂ ѕυкαя" Foreground="{StaticResource NeonDarkCyanDarkBrush}"/>
                                </StackPanel>
                            </GroupBox.Header>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Column="0" Grid.Row="0"
                                           Text="Search SN:"
                                           Foreground="{StaticResource NeonDarkCyanDarkBrush}"/>

                                <Image Grid.Column="0" Grid.Row="1"
                                       Source="{StaticResource BatteryShield2}"
                                       Width="35"
                                       Height="30"
                                       Margin="0,0,40,0"
                                       VerticalAlignment="Top"/>

                                <TextBox Grid.Column="1" Grid.Row="0"
                                         Height="22"
                                         VerticalAlignment="Top"
                                         Style="{StaticResource NeonDarkCyanTextBoxStyle}"/>

                                <ComboBox Grid.Column="1" Grid.Row="1"
                                          Padding="8,0,25,0"
                                          Height="22"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource NeonDarkCyanComboBoxStyle}"
                                          Margin="0,0,0,0">
                                    <ComboBoxItem Content="All Categories"/>
                                    <ComboBoxItem Content="Laptops"/>
                                    <ComboBoxItem Content="Desktops"/>
                                    <ComboBoxItem Content="Tablets"/>
                                    <ComboBoxItem Content="Phones"/>
                                    <ComboBoxItem Content="Accessories"/>
                                </ComboBox>
                                <UniformGrid Grid.Column="1" Grid.Row="2" Columns="2" Rows="2"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center">
                                    <Button Style="{StaticResource NeonDarkCyanButtonStyle}" Width="125" FontSize="14" Margin="0,5,6,0"
                                            Command="{Binding ShowAlBarakaCommand}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{StaticResource Baraka}" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Al-Baraka"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <Button Style="{StaticResource NeonOrangeButtonStyle}" Width="125" FontSize="16" Margin="0,5,6,0"
                                            Command="{Binding ShowReportsCommand}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{StaticResource AIBox}" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Reports DB"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource  NeonDarkGreenButtonStyle}" Width="125" FontSize="14" Margin="0,5,6,0"
                                        Command="{Binding ShowWarrantySystemCommand}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{StaticResource Warranty}" Width="20" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Warranty"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <CheckBox IsChecked="{Binding AutoGrantAdminAccess, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="120" Margin="0,5,-10,0" Style="{StaticResource NeonCheckBoxStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{StaticResource GalaxyAi4}" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="gαℓαאָу αι" Foreground="{StaticResource NeonDarkCyanDarkBrush}"/>
                                        </StackPanel>
                                    </CheckBox>
                                </UniformGrid>
                            </Grid>
                        </GroupBox>

                        <GroupBox Width="363"
                                  Style="{StaticResource DarkRedGroupBoxStyle}"
                                  Margin="12,6,11,6">
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource Admin}" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="Adminstration" Foreground="{StaticResource NeonRedDarkBrush}"/>
                                </StackPanel>
                            </GroupBox.Header>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Button Grid.Row="0"
                                        Width="300"
                                        Height="44"
                                        FontSize="16"
                                        Margin="0,0,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Command="{Binding RequestAdminAccessCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NeonRedButtonStyle}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAdminAccessGranted}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="{StaticResource token}" Width="16" Height="16" Margin="0,0,8,0"/>
                                        <TextBlock Text="Admin Access"/>
                                    </StackPanel>
                                </Button>

                                <UniformGrid Grid.Row="0"
                                             Columns="2"
                                             Rows="3"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center">
                                    <UniformGrid.Style>
                                        <Style TargetType="UniformGrid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAdminAccessGranted}" Value="true">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </UniformGrid.Style>

                                    <Button Style="{StaticResource NeonGreenButtonStyle}" Width="145" FontSize="15" Margin="0,5,6,0"
                                            Command="{Binding InitializeDatabaseCommand}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{StaticResource DBCreate}" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Create DB"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource NeonBlueButtonStyle}" Width="145" FontSize="13" Margin="0,5,6,0"
                                            Command="{Binding ChangeAdminPasswordCommand}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{StaticResource Settings}" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Change Admin"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource NeonCyanButtonStyle}" Width="145" FontSize="15" Margin="0,5,6,0"
                                            Command="{Binding LoadDatabaseCommand}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{StaticResource DBEdit}" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Connect DB"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource NeonBorderButtonStyle}" Width="145" FontSize="14" Margin="0,5,6,0"
                                            Command="{Binding ResetSettingsCommand}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{StaticResource ResetSTG}" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Reset STG"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource NeonBorderButtonStyle}" Width="145" FontSize="12" Margin="0,5,6,0"
                                            Command="{Binding ResetDatabaseCommand}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{StaticResource DBReset}" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Reset DB"/>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>

                                <CheckBox Grid.Row="1"
                                          IsChecked="{Binding LaunchAtWindowsStartup, Mode=TwoWay}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Bottom"
                                          Margin="0,8,0,0"
                                          Style="{StaticResource NeonCheckBoxStyle}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="{StaticResource GalaxyAi4}" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="Launch at Windows startup"
                                                   Foreground="{StaticResource NeonRedDarkBrush}"/>
                                    </StackPanel>
                                </CheckBox>
                            </Grid>
                        </GroupBox>
                    </UniformGrid>
                </Border>

                <!-- ================= Main Content ================= -->
                <Border Grid.Row="2"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="12"
                        Margin="16,0,16,8">

                    <ContentControl x:Name="MainContentHost"
                                    Content="{Binding CurrentView}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"/>
                </Border>

                <!-- ================= Status Bar ================= -->
                <StatusBar Grid.Row="3"
                           Height="28"
                           Background="{StaticResource DarkCardBrush}"
                           BorderBrush="{StaticResource DarkBorderBrush}"
                           BorderThickness="1,0,0,0"
                           Padding="6,0">

                    <StatusBarItem HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusIcon}"
                                       Foreground="{Binding StatusBrush}"
                                       Style="{StaticResource StatusIconStyle}"/>

                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="{Binding StatusBrush}"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </StatusBarItem>
                    <Separator/>
                    <StatusBarItem HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ClockText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,12,0"/>

                            <TextBlock Text="{Binding CurrentUser}" 
                                       Foreground="{Binding UsernameBrush}" />
                        </StackPanel>
                    </StatusBarItem>
                </StatusBar>
            </Grid>
        </Grid>
    </Border>
</Window>
