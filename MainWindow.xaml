<Window x:Class="ESCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ESCenter.ViewModels"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="E-SCenter"
        Height="880"
        Width="1595"
        WindowStartupLocation="Manual"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Severity Icons -->
        <Style x:Key="StatusIconStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

    </Window.Resources>
    
    <Window.InputBindings>
        <!-- F1 = Dashboard -->
        <KeyBinding Key="F1" Command="{Binding ShowDashboardCommand}" />

        <!-- F2 = Repair Tickets -->
        <KeyBinding Key="F2" Command="{Binding ShowRepairTicketsCommand}" />

        <!-- F3 = Parts Control -->
        <KeyBinding Key="F3" Command="{Binding ShowPartsControlCommand}" />

        <!-- F4 = Inventory -->
        <KeyBinding Key="F4" Command="{Binding ShowInventoryCommand}" />

        <!-- F5 = Boneyard -->
        <KeyBinding Key="F5" Command="{Binding ShowBoneyardCommand}" />

        <!-- F6 = Al-Baraka -->
        <KeyBinding Key="F6" Command="{Binding ShowAlBarakaCommand}" />

        <!-- F7 = Warranty Window -->
        <KeyBinding Key="F7" Command="{Binding ShowWarrantySystemCommand}" />

        <!-- Ctrl+N = New Ticket -->
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewTicketCommand}" />
    </Window.InputBindings>
    

    <!-- Rounded window shell -->
    <Border CornerRadius="12"
            Background="{StaticResource AppBackgroundBrush}"
            BorderBrush="{StaticResource DarkBorderBrush}"
            BorderThickness="0"
            SnapsToDevicePixels="True">

        <Grid>
            <!-- ================= Custom Title Bar ================= -->
            <Border Height="36"
                    Background="{StaticResource DarkCardBrush}"
                    CornerRadius="12,12,0,0"
                    BorderBrush="{StaticResource DarkBorderBrush}"
                    BorderThickness="0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    VerticalAlignment="Top">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Icon -->
                    <Image Grid.Column="0"
                           Source="Assets\Icons\Philips E-SCenter Logo.png"
                           Width="30"
                           Height="30"
                           Margin="10,0,6,0"
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="0"
                               Text="E-SCenter"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Gradient.Primary}"
                               Margin="45,0,0,0"/>

                    <!-- ===== Navigation Tabs ===== -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="6,0,12,0">

                        <!-- Dashboard tab — use this pattern for all 5 tabs -->
                        <RadioButton Style="{StaticResource TitleBarTabButtonStyle}"
                                     GroupName="MainTabs"
                                     Command="{Binding ShowDashboardCommand}"
                                     x:Name="BtnDashboard"
                                     Width="130"
                                     IsChecked="{Binding IsDashboardSelected, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource Dashboard}"
                                       Width="15" Height="15"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                                <TextBlock Text="Dashboard"
                                           VerticalAlignment="Center"/>
                                <!-- Keyboard hint badge -->
                                <Border Background="#18FFFFFF"
                                        CornerRadius="3"
                                        Padding="3,1"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="F1"
                                               FontSize="9"
                                               FontFamily="Consolas"
                                               Foreground="{StaticResource TextTertiaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource TitleBarTabButtonStyle}"
                                     GroupName="MainTabs"
                                     Command="{Binding ShowRepairTicketsCommand}"
                                     x:Name="BtnRepairTickets"
                                     Width="147"
                                     IsChecked="{Binding IsRepairTicketsSelected, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource Tickets}"
                                       Width="15" Height="15"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                                <TextBlock Text="Repair Tickets"
                                           VerticalAlignment="Center"/>
                                <!-- Keyboard hint badge -->
                                <Border Background="#18FFFFFF"
                                        CornerRadius="3"
                                        Padding="3,1"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="F2"
                                               FontSize="9"
                                               FontFamily="Consolas"
                                               Foreground="{StaticResource TextTertiaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource TitleBarTabButtonStyle}"
                                     GroupName="MainTabs"
                                     Command="{Binding ShowPartsControlCommand}"
                                     x:Name="BtnPartsControl"
                                     Width="142"
                                     IsChecked="{Binding IsPartsControlSelected, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource Parts}"
                                       Width="15" Height="15"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                                <TextBlock Text="Parts Control"
                                           VerticalAlignment="Center"/>
                                <!-- Keyboard hint badge -->
                                <Border Background="#18FFFFFF"
                                        CornerRadius="3"
                                        Padding="3,1"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="F3"
                                               FontSize="9"
                                               FontFamily="Consolas"
                                               Foreground="{StaticResource TextTertiaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource TitleBarTabButtonStyle}"
                                     GroupName="MainTabs"
                                     Command="{Binding ShowInventoryCommand}"
                                     x:Name="BtnInventory"
                                     Width="123"
                                     IsChecked="{Binding IsInventorySelected, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource Inventory}"
                                       Width="15" Height="15"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                                <TextBlock Text="Inventory"
                                           VerticalAlignment="Center"/>
                                <!-- Keyboard hint badge -->
                                <Border Background="#18FFFFFF"
                                        CornerRadius="3"
                                        Padding="3,1"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="F4"
                                               FontSize="9"
                                               FontFamily="Consolas"
                                               Foreground="{StaticResource TextTertiaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource TitleBarTabButtonStyle}"
                                     GroupName="MainTabs"
                                     Command="{Binding ShowBoneyardCommand}"
                                     x:Name="BtnBoneyard"
                                     Width="125"
                                     IsChecked="{Binding IsBoneyardSelected, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource Boneyard}"
                                       Width="15" Height="15"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                                <TextBlock Text="Boneyard"
                                           VerticalAlignment="Center"/>
                                <!-- Keyboard hint badge -->
                                <Border Background="#18FFFFFF"
                                        CornerRadius="3"
                                        Padding="3,1"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="F5"
                                               FontSize="9"
                                               FontFamily="Consolas"
                                               Foreground="{StaticResource TextTertiaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>



                    <!-- Drag Area -->
                    <Border Grid.Column="2"
                Background="Transparent"/>

                    <!-- Window Buttons -->
                    <StackPanel Grid.Column="3"
                    Orientation="Horizontal">
                        <Button x:Name="btnUserProfile"
                                Command="{Binding ShowUserProfileCommand}"
                                Style="{StaticResource UserProfileButtonStyle}"
                                Width="Auto"
                                Padding="10,0"
                                Margin="0,0,6,0"
                                ToolTip="{Binding CurrentUser}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource Admin}" Width="16" Height="16" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding CurrentUser}"
                                           FontSize="11"
                                           Foreground="{StaticResource Gradient.Primary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            
                        </Button>

                        <Button x:Name="btnMinimize"
                                Style="{StaticResource TitleBarButtonBase}"
                                Click="btnMinimize_Click">
                            <Image Source="{StaticResource Minimize}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>

                        <Button x:Name="btnMaximize"
                                Style="{StaticResource TitleBarButtonBase}"
                                Click="btnMaximize_Click"
                                FontSize="18">
                            <Image Source="{StaticResource Maximize}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>

                        <Button x:Name="btnClose"
                                Style="{StaticResource TitleBarCloseButtonStyle}"
                                Click="btnClose_Click">
                            <Image Source="{StaticResource Close}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>



            <!-- ================= ORIGINAL UI (UNCHANGED) ================= -->
            <Grid Margin="0,36,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <!-- ================= Control ================= -->
                <Border Grid.Row="0"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="8"
                        Margin="16,16,16,8">

                    <UniformGrid Columns="4" >

                        <!-- ========= Navigation Group ========= -->
                        <GroupBox Width="375"
                                  Height="185"
                                  Padding="1"
                                  Style="{StaticResource GradientGroupBoxBlueCyan}">

                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource Charts}"
                                           Width="16"
                                           Height="16"
                                           Margin="0,0,6,0"/>
                                    <TextBlock Text="Tickets Act"
                                                VerticalAlignment="Center"
                                               Foreground="{StaticResource Gradient.Primary.Horizontal}"/>
                                </StackPanel>
                            </GroupBox.Header>

                            <Grid Height="137" Margin="0,-8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <lvc:CartesianChart Margin="0"
                                                        Series="{Binding TicketsSeries}"
                                                        XAxes="{Binding TicketsXAxis}"
                                                        YAxes="{Binding TicketsYAxis}"
                                                        TooltipTextPaint="{Binding TicketsTooltipTextPaint}"
                                                        TooltipBackgroundPaint="{Binding TicketsTooltipBackgroundPaint}"
                                                        LegendPosition="Hidden"/>
                                </Grid>

                                <ScrollViewer Grid.Row="1"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding TicketStatusCurves}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ToggleButton Margin="2,0,2,0"
                                                              Padding="2"
                                                              Width="65"
                                                              Height="25"
                                                              ToolTip="{Binding Key}"
                                                              Style="{StaticResource ChartStatusToggleButtonStyle}"
                                                              IsChecked="{Binding IsVisible, Mode=TwoWay}">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Image Width="13"
                                                               Height="13"
                                                               Stretch="Uniform"
                                                               Margin="0,0,4,0"
                                                               Source="{Binding Key, Converter={StaticResource SeriesKeyToIconConverter}}"/>
                                                        <TextBlock Text="{Binding Key}"
                                                                   FontSize="9"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource Gradient.Primary}"/>
                                                    </StackPanel>
                                                </ToggleButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </GroupBox>

                        <!-- ========= Statistics Group ========= -->
                        <GroupBox Width="363" Height="185" Style="{StaticResource GradientGroupBoxAccent}">
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource Statistics}" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="Tickets stk" Foreground="{StaticResource Gradient.Accent}"/>
                                </StackPanel>
                            </GroupBox.Header>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Grid.Row="0"
                                           Text="Total"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>

                                <TextBlock Grid.Column="1" Grid.Row="0"
                                           Text="Open"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>

                                <TextBlock Grid.Column="2" Grid.Row="0"
                                           Text="Close"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>

                                <TextBlock Grid.Column="3" Grid.Row="0"
                                           Text="Critical"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>

                                <TextBlock Grid.Column="4" Grid.Row="0"
                                           Text="Ready To Pcik"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>


                                <TextBlock Text="{Binding Dashboard.TotalTickets}" Grid.Row="1" Grid.Column="0"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource NeonPurpleBrush}"
                                           Margin="0,8,0,0"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="{Binding Dashboard.OpenTickets}" Grid.Row="1" Grid.Column="1"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource NeonGreenBrush}"
                                           Margin="0,8,0,0"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="{Binding Dashboard.ClosedTickets}" Grid.Row="1" Grid.Column="2"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource NeonBlueBrush}"
                                           Margin="0,8,0,0"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="{Binding Dashboard.CriticalOpenTickets}" Grid.Row="1" Grid.Column="3"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource NeonOrangeBrush}"
                                           Margin="0,8,0,0"
                                           HorizontalAlignment="Center"/>

                                <Button Grid.Row="1" Grid.Column="4"
                                        Command="{Binding ShowReadyPickupTicketsCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Padding="0"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Dashboard.ReadyForPickupTickets}"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource NeonCyanBrush}"/>
                                </Button>

                                <StackPanel Grid.Column="0" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                                    <Image Source="{StaticResource CharCritical}" Width="19" Height="19" Margin="0,0,4,0"/>
                                    <TextBlock Grid.Column="0" Grid.Row="2"
                                               Text="Alerts:"
                                               Foreground="{StaticResource NeonRedDarkBrush}"
                                               FontSize="14"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </StackPanel>
                                
                                <TextBlock Grid.Column="1" Grid.Row="2"
                                           Text="Critical:"
                                           Foreground="{StaticResource NeonOrangeBrush}"
                                           FontSize="14"
                                           Margin="0,19,0,0"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Grid.Row="2"
                                        Command="{Binding ShowCriticalTicketsCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Padding="0"
                                        Margin="0,18,0,0"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Dashboard.CriticalOpenTickets}"
                                               FontSize="19"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource NeonOrangeBrush}"/>
                                </Button>

                                <TextBlock Grid.Column="3" Grid.Row="2"
                                           Text="Overdue:"
                                           Foreground="{StaticResource NeonRedDarkBrush}"
                                           FontSize="14"
                                           Margin="0,19,0,0"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="4" Grid.Row="2"
                                        Command="{Binding ShowOverdueTicketsCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Padding="0"
                                        Margin="0,18,0,0"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Dashboard.OverdueTickets}"
                                               FontSize="19"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource NeonRedBrush}"/>
                                </Button>
                            </Grid>
                        </GroupBox>

                        <!-- ========= Control Group ========= -->
                        <GroupBox Width="363" Height="185" Style="{StaticResource GradientGroupBoxBlueCyan}">
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource GalaxyAi3}" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="мн∂ ѕυкαя" Foreground="{StaticResource Gradient.Primary.Horizontal}"/>
                                </StackPanel>
                            </GroupBox.Header>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Column="0" Grid.Row="0"
                                           Text="ѕєαяςн ѕи:"
                                           Foreground="{StaticResource Gradient.Accent}"/>

                                <Image Grid.Column="0" Grid.Row="1"
                                       Source="{StaticResource GalaxyAi3}"
                                       Width="35"
                                       Height="30"
                                       Margin="0,0,40,0"
                                       VerticalAlignment="Top"/>

                                <TextBox x:Name="GlobalSearchBox"
                                         Grid.Column="1" Grid.Row="0"
                                         Height="23"
                                         VerticalAlignment="Top"
                                         Style="{StaticResource GradiantTextboxStyle1}"
                                         Text="{Binding GlobalSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Search everywhere (Ctrl+F) — min 2 characters">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Down" Command="{Binding GlobalSearchMoveDownCommand}"/>
                                        <KeyBinding Key="Up" Command="{Binding GlobalSearchMoveUpCommand}"/>
                                        <KeyBinding Key="Enter" Command="{Binding GlobalSearchAcceptCommand}"/>
                                        <KeyBinding Key="Escape" Command="{Binding CloseGlobalSearchCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>

                                <Popup IsOpen="{Binding IsGlobalSearchOpen}"
                                       PlacementTarget="{Binding ElementName=GlobalSearchBox}"
                                       Placement="Bottom"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       MinWidth="320">
                                    <Border Background="{StaticResource CardBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderDarkBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="4">
                                        <ListBox ItemsSource="{Binding GlobalSearchResults}"
                                                 SelectedIndex="{Binding GlobalSearchSelectedIndex, Mode=TwoWay}"
                                                 MaxHeight="220"
                                                 Background="Transparent"
                                                 BorderThickness="0">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0,1"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="Bd"
                                                                        Background="{TemplateBinding Background}"
                                                                        CornerRadius="4"
                                                                        Padding="2">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="Bd"
                                                                                Property="Background"
                                                                                Value="{StaticResource NewPrimaryBlueBrush}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd"
                                                                                Property="Background"
                                                                                Value="#22FFFFFF"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.NavigateToResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="8,5"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch">
                                                        <Grid HorizontalAlignment="Stretch">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0"
                                                                    Background="#1A5AA7FF"
                                                                    CornerRadius="3"
                                                                    Padding="5,2"
                                                                    Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Identifier}"
                                                                           Foreground="#5AA7FF"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           FontFamily="Consolas"/>
                                                            </Border>

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Name}"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       FontSize="12"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"/>

                                                            <Border Grid.Column="2"
                                                                    Background="#1A334455"
                                                                    CornerRadius="3"
                                                                    Padding="5,2"
                                                                    Margin="8,0,0,0">
                                                                <TextBlock Text="{Binding Source}"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           FontSize="10"/>
                                                            </Border>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Popup>

                                <ComboBox Grid.Column="1" Grid.Row="1"
                                          Padding="8,0,25,0"
                                          Height="23"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource GradiantComboboxStyle11}"
                                          Margin="0,0,0,0">
                                    <ComboBoxItem Content="All Categories"/>
                                    <ComboBoxItem Content="Laptops"/>
                                    <ComboBoxItem Content="Desktops"/>
                                    <ComboBoxItem Content="Tablets"/>
                                    <ComboBoxItem Content="Phones"/>
                                    <ComboBoxItem Content="Accessories"/>
                                </ComboBox>

                                <UniformGrid Grid.Column="0" Grid.Row="2" Columns="1" Rows="2"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center">
                                    <Button Style="{StaticResource  IconButtonStyle}" MinWidth="1" Width="30" FontSize="14" Margin="0,5,0,3"
                                            Command="{Binding ShowWarrantySystemCommand}">
                                        <Grid>
                                            <Image Source="{StaticResource Warranty}" Width="30" Height="20" Margin="-2,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                            <Border Background="{StaticResource NeonOrangeBrush}"
                                                    BorderBrush="{StaticResource DarkCardBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="9"
                                                    Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="0,-6,-6,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ExpiringWarrantyCount}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ExpiringWarrantyCount}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource AppBackgroundBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Button>

                                </UniformGrid>

                                <UniformGrid Grid.Column="1" Grid.Row="2" Columns="2" Rows="2"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center">

                                    <Button Style="{StaticResource GradientBorderButtonStyleBLueCyan}" MinWidth="1" Width="125" FontSize="14" Margin="0,5,6,0"
                                            Command="{Binding ShowAlBarakaCommand}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{StaticResource Baraka}" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Al-Baraka"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <Button Style="{StaticResource GradientBorderButtonStyleYellow}" Width="125" FontSize="16" Margin="0,5,6,0"
                                            Command="{Binding ShowReportsCommand}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{StaticResource DBReport}" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Reports DB"/>
                                        </StackPanel>
                                    </Button>

                                    
                                    
                                    <CheckBox IsChecked="{Binding AutoGrantAdminAccess, Mode=TwoWay}" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Center" 
                                              Width="120" Margin="0,5,-10,0" 
                                              Style="{StaticResource GradientCheckBoxStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{StaticResource GalaxyAi3}" Width="18" Height="18" Margin="0,0,6,0"/>
                                            <TextBlock Text="ω11 ∂яινє" Foreground="{StaticResource Gradient.Primary}"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox Grid.Row="1"
                                              IsChecked="{Binding LaunchAtWindowsStartup, Mode=TwoWay}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Bottom"
                                              Margin="0,8,0,0"
                                              Style="{StaticResource GradientCheckBoxDangerStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{StaticResource BackupNow}" Width="18" Height="18" Margin="0,0,6,0"/>
                                            <TextBlock Text="∂єν ∂яινє"
                                                       Foreground="{StaticResource Gradient.Primary}"/>
                                        </StackPanel>
                                    </CheckBox>
                                </UniformGrid>
                            </Grid>
                        </GroupBox>

                        <GroupBox Width="363" Height="185"
                                  Style="{StaticResource GradientGroupBoxAccent}"
                                  Margin="12,6,11,6">
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource Admin}" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="αρρ ѕтαтυѕ" Foreground="{StaticResource Gradient.Accent}"/>
                                </StackPanel>
                            </GroupBox.Header>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0"
                                            VerticalAlignment="Stretch"
                                            HorizontalAlignment="Stretch">


                                    <UniformGrid Columns="2"
                                                 Rows="2"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Top"
                                                 Margin="0,4,0,6">
                                        <Button 
                                                Width="138"
                                                Height="30"
                                                Margin="3,3,3,3"
                                                Command="{Binding ShowSettingsCommand}"
                                                Style="{StaticResource GradientBorderButtonStyleBLueCyanOLD}"
                                                FontSize="13">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Image Source="{StaticResource Settings}" Width="18" Height="18" Margin="0,0,6,0"/>
                                                <TextBlock Text="Settings"/>
                                            </StackPanel>
                                        </Button>

                                        <Button
                                                Width="138"
                                                Height="30"
                                                Margin="3,3,3,3"
                                                Command="{Binding BackupNowCommand}"
                                                Style="{StaticResource GradientBorderButtonStyleGreen}"
                                                FontSize="13">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Image Source="{StaticResource BackupNow}" Width="18" Height="18" Margin="0,0,6,0"/>
                                                <TextBlock Text="Backup Now"/>
                                            </StackPanel>
                                        </Button>
                                        <Button
                                                Width="138"
                                                Height="30"
                                                Margin="3,3,3,3"
                                                Command="{Binding OpenLogFolderCommand}"
                                                Style="{StaticResource GradientBorderButtonStyleRed}"
                                                FontSize="13">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Image Source="{StaticResource OpenLogs}" Width="18" Height="18" Margin="0,0,6,0"/>
                                                <TextBlock Text="app logger"/>
                                            </StackPanel>
                                        </Button>
                                        <Button 
                                                Width="138"
                                                Height="30"
                                                Margin="3,3,3,3"
                                                Command="{Binding RefreshAllCommand}"
                                                Style="{StaticResource GradientBorderButtonStyleAccent}"
                                                FontSize="13">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Image Source="{StaticResource RefreshAll}" Width="18" Height="18" Margin="0,0,6,0"/>
                                                <TextBlock Text="Refresh All"/>
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>

                                    <Border Height="1"
                                            Background="{StaticResource Gradient.Accent}"
                                            Margin="8,2,8,4"/>

                                    <Grid Margin="8,0,8,4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{Binding DatabaseConnectionBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="DB:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding DatabaseConnectionStatusText}" Foreground="{Binding DatabaseConnectionBrush}" FontSize="10" FontWeight="SemiBold"/>
                                            <TextBlock Text=" · " Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                            <TextBlock Text="{Binding DatabaseFileSizeText}" Foreground="{StaticResource Gradient.Accent}" FontSize="10"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="Last backup: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                            <TextBlock Text="{Binding LastBackupText}" Foreground="{StaticResource Gradient.Success}" FontSize="10" FontWeight="SemiBold"/>
                                        </StackPanel>

                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                    </UniformGrid>
                </Border>

                <!-- ================= Main Content ================= -->
                <Border Grid.Row="1"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="12"
                        Margin="16,0,16,8">

                    <ContentControl x:Name="MainContentHost"
                                    Content="{Binding CurrentView}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"/>
                </Border>

                <!-- ================= Status Bar ================= -->
                <StatusBar Grid.Row="2"
                           Height="28"
                           Background="{StaticResource DarkCardBrush}"
                           BorderBrush="{StaticResource DarkBorderBrush}"
                           BorderThickness="1,0,0,0"
                           Padding="6,0">

                    <StatusBarItem HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9"
                                     Height="9"
                                     Fill="{Binding DatabaseConnectionBrush}"
                                     Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding DatabaseConnectionStatusText}"
                                       Foreground="{Binding DatabaseConnectionBrush}"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </StatusBarItem>
                    <Separator/>

                    <StatusBarItem HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentStatusLevel, Converter={StaticResource StatusLevelToIconConverter}}"
                                       Foreground="{Binding CurrentStatusLevel, Converter={StaticResource StatusLevelToBrushConverter}}"
                                       Style="{StaticResource StatusIconStyle}"/>

                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="{Binding CurrentStatusLevel, Converter={StaticResource StatusLevelToBrushConverter}}"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </StatusBarItem>
                    <Separator/>
                    <StatusBarItem HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ClockText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,12,0"/>

                            <TextBlock Text="{Binding CurrentUser}" 
                                       Foreground="{StaticResource Gradient.Primary}" />
                        </StackPanel>
                    </StatusBarItem>
                </StatusBar>
            </Grid>
        </Grid>
    </Border>
</Window>
