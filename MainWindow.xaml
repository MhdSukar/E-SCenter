<Window x:Class="ESCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ESCenter.ViewModels"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="E-SCenter"
        Height="880"
        Width="1595"
        WindowStartupLocation="Manual"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>

        <!-- Severity Icons -->
        <Style x:Key="StatusIconStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>

            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- Titlebar Button Base -->
        <Style x:Key="TitleBarButtonBase" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Button -->
        <Style x:Key="TitleBarCloseButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TitleBarButtonBase}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                               CornerRadius="0,8,0,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#E81123"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#C50F1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Rounded window shell -->
    <Border CornerRadius="12"
            Background="{StaticResource AppBackgroundBrush}"
            BorderBrush="{StaticResource DarkBorderBrush}"
            BorderThickness="0"
            SnapsToDevicePixels="True">

        <Grid>

            <!-- ================= Custom Title Bar ================= -->
            <!-- ================= Custom Title Bar ================= -->
            <!-- ================= Custom Title Bar ================= -->
            <Border Height="36"
                    Background="{StaticResource DarkCardBrush}"
                    CornerRadius="12,12,0,0"
                    BorderBrush="{StaticResource DarkBorderBrush}"
                    BorderThickness="0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    VerticalAlignment="Top">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Icon -->
                    <Image Grid.Column="0"
                           Source="Z:\C#\Projects\E-SCenter\E-SCenter\Themes\Philips E-SCenter Logo.png"
                           Width="18"
                           Height="18"
                           Margin="10,0,6,0"
                           VerticalAlignment="Center"/>

                    <!-- ===== Navigation Tabs ===== -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="6,0,12,0">

                        <RadioButton Style="{StaticResource TitleBarTabButtonStyle}"
                                     GroupName="MainTabs"
                                     IsChecked="True"
                                     Command="{Binding ShowDashboardCommand}"
                                     x:Name="BtnDashboard">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource ArmingCountdown}" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Dashboard"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource TitleBarTabButtonStyle}"
                                     GroupName="MainTabs"
                                     Command="{Binding ShowRepairTicketsCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource local_activity}" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Tickets"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource TitleBarTabButtonStyle}"
                                     GroupName="MainTabs"
                                     Command="{Binding ShowPartsControlCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource component}" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Parts"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource TitleBarTabButtonStyle}"
                                     GroupName="MainTabs"
                                     Command="{Binding ShowInventoryCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource inventory}" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Inventory"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource TitleBarTabButtonStyle}"
                                     GroupName="MainTabs"
                                     Command="{Binding ShowBoneyardCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource settings1}" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Boneyard"/>
                            </StackPanel>
                        </RadioButton>

                    </StackPanel>



                    <!-- Drag Area -->
                    <Border Grid.Column="2"
                Background="Transparent"/>

                    <!-- Window Buttons -->
                    <StackPanel Grid.Column="3"
                    Orientation="Horizontal">

                        <Button x:Name="btnMinimize"
                                Style="{StaticResource TitleBarButtonBase}"
                                Content="—"
                                Click="btnMinimize_Click"/>

                        <Button x:Name="btnMaximize"
                                Style="{StaticResource TitleBarButtonBase}"
                                Content="□"
                                Click="btnMaximize_Click"
                                FontSize="18"/>

                        <Button x:Name="btnClose"
                                Style="{StaticResource TitleBarCloseButtonStyle}"
                                Content="✕"
                                Click="btnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>



            <!-- ================= ORIGINAL UI (UNCHANGED) ================= -->
            <Grid Margin="0,36,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <!-- ================= Header ================= -->
                <Border Grid.Row="0"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="12"
                        Margin="16,16,16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0"
                               Source="Z:\C#\Projects\E-SCenter\E-SCenter\Themes\Philips E-SCenter Logo.png" 
                               Height="40" 
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"/>

                        <TextBlock Text="E-SCenter"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextLogoBrush}"
                                   Grid.Column="0" Margin="50,0,0,0"/>

                        <TextBlock Text="Electronics Services Center"
                                   Style="{StaticResource CardTitleTextStyle}"
                                   FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextLogoBrush}"
                                   Grid.Column="1"
                                   Margin="0,0,150,0"/>
                    </Grid>
                </Border>

                <!-- ================= Navigation ================= -->
                <Border Grid.Row="1"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="8"
                        Margin="16,0,16,8">

                    <UniformGrid Columns="4" >

                        <!-- ========= Control Group ========= -->
                        <GroupBox Width="363" Style="{StaticResource DarkBlueGroupBoxStyle}">
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource DeviceWear25}" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="Control" Foreground="{StaticResource PrimaryBlueBrush}"/>
                                </StackPanel>
                            </GroupBox.Header>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Search SN:"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>

                                <Image Grid.Column="0"
                                       Source="{StaticResource DeviceWear25}"
                                       Width="25"
                                       Height="25"
                                       Margin="0,25,45,0"
                                       VerticalAlignment="Top"/>

                                <TextBox Grid.Column="1"
                                         Height="20"
                                         VerticalAlignment="Top"
                                         Style="{StaticResource NeonTextBoxStyle}"/>

                                <ComboBox Grid.Column="1"
                                          Padding="8,0,25,0"
                                          Height="22"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource NeonComboBoxStyle}"
                                          Margin="0,0,0,40">
                                    <ComboBoxItem Content="All Categories"/>
                                    <ComboBoxItem Content="Laptops"/>
                                    <ComboBoxItem Content="Desktops"/>
                                    <ComboBoxItem Content="Tablets"/>
                                    <ComboBoxItem Content="Phones"/>
                                    <ComboBoxItem Content="Accessories"/>
                                </ComboBox>
                            </Grid>
                        </GroupBox>

                        <!-- ========= Navigation Group ========= -->
                        <GroupBox Width="363"
                                  Height="157.95"
                                  Padding="0"
                                  Style="{StaticResource DarkPurpleGroupBoxStyle}">

                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource cadence}"
                                           Width="16"
                                           Height="16"
                                           Margin="0,0,6,0"/>
                                    <TextBlock Text="Tickets Act"
                                                VerticalAlignment="Center"
                                               Foreground="{StaticResource NeonPurpleBrush}"/>
                                </StackPanel>
                            </GroupBox.Header>

                            <oxy:PlotView Model="{Binding TicketsPlotModel}"
                                          Height="140"
                                          Background="Transparent"
                                          Margin="0,-20,0,0"/>
                        </GroupBox>

                        <!-- ========= Statistics Group ========= -->
                        <GroupBox Width="363" Style="{StaticResource DarkBlueGroupBoxStyle}">
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource edit_audio}" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="Statistics" Foreground="{StaticResource NeonBlueBrush}"/>
                                </StackPanel>
                            </GroupBox.Header>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Grid.Row="0"
                                           Text="Total"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>

                                <TextBlock Grid.Column="1" Grid.Row="0"
                                           Text="Open"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>

                                <TextBlock Grid.Column="2" Grid.Row="0"
                                           Text="Close"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>

                                <TextBlock Grid.Column="3" Grid.Row="0"
                                           Text="Critical"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>

                                <TextBlock Grid.Column="4" Grid.Row="0"
                                           Text="Overdue (>2 days)"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>

                                <TextBlock Text="{Binding Dashboard.TotalTickets}" Grid.Row="1" Grid.Column="0"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource NeonPurpleBrush}"
                                           Margin="0,8,0,0"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="{Binding Dashboard.OpenTickets}" Grid.Row="1" Grid.Column="1"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource NeonGreenBrush}"
                                           Margin="0,8,0,0"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="{Binding Dashboard.ClosedTickets}" Grid.Row="1" Grid.Column="2"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource NeonBlueBrush}"
                                           Margin="0,8,0,0"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="{Binding Dashboard.CriticalOpenTickets}" Grid.Row="1" Grid.Column="3"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource NeonOrangeBrush}"
                                           Margin="0,8,0,0"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="{Binding Dashboard.OverdueTickets}" Grid.Row="1" Grid.Column="4"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource NeonRedBrush}"
                                           Margin="0,8,0,0"
                                           HorizontalAlignment="Center"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Width="363"
                                  Style="{StaticResource DarkCyanGroupBoxStyle}"
                                  Margin="12,6,11,6">
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource regular_expression}" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="мн∂ ѕυкαя" Foreground="{StaticResource NeonDarkCyanBrush}"/>
                                </StackPanel>
                            </GroupBox.Header>

                            <UniformGrid Columns="2" Rows="4"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">

                                <Button Style="{StaticResource NeonBorderButtonStyle}" Width="145" FontSize="15" Margin="0,5,6,0"
                                        Command="{Binding InitializeDatabaseCommand}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="{StaticResource Database}" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="Create DB"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource NeonCyanButtonStyle}" Width="145" FontSize="15" Margin="0,5,6,0"
                                        Command="{Binding LoadDatabaseCommand}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="{StaticResource DatabaseUpload}" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="Connect DB"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource NeonOrangeButtonStyle}" Width="145" FontSize="16" Margin="0,5,6,0"
                                        Command="{Binding ShowReportsCommand}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="{StaticResource DataArray}" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="Reports DB"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource NeonBlueButtonStyle}" Width="145" FontSize="13" Margin="0,5,6,0"
                                        Command="{Binding ChangeAdminPasswordCommand}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="{StaticResource settings1}" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="Change Password"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource NeonBorderButtonStyle}" Width="145" FontSize="14" Margin="0,5,6,0"
                                        Command="{Binding ResetSettingsCommand}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="{StaticResource amend}" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="Reset STG"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource NeonGreenButtonStyle}" Width="145" FontSize="14" Margin="0,5,6,0"
                                        Command="{Binding ShowWarrantySystemCommand}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="{StaticResource verified}" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="Warrenty.Sys"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource NeonDarkCyanButtonStyle}" Width="145" FontSize="12" Margin="0,5,6,0"
                                        Command="{Binding ResetDatabaseCommand}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="{StaticResource clear_all}" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="Reset DB"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </GroupBox>


                        <!-- ========= Admin Group ========= -->
                    </UniformGrid>
                </Border>

                <!-- ================= Main Content ================= -->
                <Border Grid.Row="2"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="12"
                        Margin="16,0,16,8">

                    <ContentControl x:Name="MainContentHost"
                                    Content="{Binding CurrentView}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"/>
                </Border>

                <!-- ================= Status Bar ================= -->
                <StatusBar Grid.Row="3"
                           Height="28"
                           Background="{StaticResource DarkCardBrush}"
                           BorderBrush="{StaticResource DarkBorderBrush}"
                           BorderThickness="1,0,0,0"
                           Padding="6,0">

                    <StatusBarItem HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusIcon}"
                                       Foreground="{Binding StatusBrush}"
                                       Style="{StaticResource StatusIconStyle}"/>

                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="{Binding StatusBrush}"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </StatusBarItem>
                    <Separator/>
                    <StatusBarItem HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ClockText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,12,0"/>

                            <TextBlock Text="{Binding CurrentUser}" 
                                       Foreground="{Binding UsernameBrush}" />
                        </StackPanel>
                    </StatusBarItem>
                </StatusBar>
            </Grid>
        </Grid>
    </Border>
</Window>
